// Dau Viet - Living Digital Atlas of Vietnam
// Backend system of record. PostgreSQL + PostGIS.
//
// Design notes (see docs/backend/BACKEND_HANDOFF.md for full rationale):
// - Translation tables carry all locale-specific display text (no nameVi/nameEn columns).
// - High-integrity historical relationships (Fact<->Entity, Event<->Entity, Story<->Entity,
//   CommunityStory<->Entity, JourneyStop) use real FK join tables, not polymorphic columns.
// - Lower-integrity, cross-cutting attachments (Comment, Bookmark, Report, gallery media,
//   generic aliases) use a validated polymorphic (entityType + entityId) pattern - this is
//   the explicit exception carved out by the spec for non-critical relations.
// - PostGIS geometry columns are declared Unsupported() because Prisma has no native GIS
//   type; all spatial writes/reads go through raw SQL in the map/territory services.
// - Historical dates are never forced into a single precise timestamp: every dated entity
//   carries explicit year/month/day + precision + qualifier columns (never a fabricated
//   Jan-1 for a year-only date) plus internal sort-only DateTime columns for range queries.
//   See docs/backend/HISTORICAL_DOMAIN.md for the full contract (spec Phase 03 section 3).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // unaccent (Phase 07, spec section 33/73) - diacritic-insensitive search
  // ("Tran Hung Dao" -> "Trần Hưng Đạo"). See the Phase 07 migration for the
  // IMMUTABLE wrapper function required to index it, and
  // docs/backend/DISCOVERY_ARCHITECTURE.md for the full rationale.
  extensions = [postgis, pg_trgm, unaccent]
}

