  TERTIARY
  UNKNOWN
}

enum CitationVerificationState {
  UNVERIFIED
  VERIFIED
  // The citation was reviewed and found not to support the claim (a bad
  // source/misreading) - distinct from DISPUTED, where the source is
  // legitimate but historians disagree about the claim (spec section 12).
  REJECTED
  DISPUTED
}

enum AccessPolicy {
  PUBLIC
  PREVIEW_ONLY
  METADATA_ONLY
  RESTRICTED
}

enum MediaType {
  PHOTO
  ARCHIVAL_PHOTO
  DOCUMENT_SCAN
  MAP
  ILLUSTRATION
  RECONSTRUCTION
  AUDIO
  VIDEO
  MODEL_3D
}

// Phase 05: upload/processing lifecycle (spec section 13). A MediaAsset row
// is created the moment an upload is requested - never only after the client
// claims success - so the backend always has something to verify against.
enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  QUARANTINED
  FAILED
  ARCHIVED
}

// Phase 05 (spec section 6) - an editorial aid describing the DECLARED/
// REVIEWED rights position, never an automatically-computed legal
// conclusion. UNKNOWN is never treated as permission to publish.
enum RightsStatus {
  PUBLIC_DOMAIN
  LICENSED
  PERMISSION_GRANTED
  COPYRIGHTED
  UNKNOWN
  RESTRICTED
  COMMUNITY_OWNED
}

// Phase 05 (spec section 17) - which derived rendition a MediaAsset row
// represents when `parentAssetId` is set. Reuses the existing self-relation
// rather than a separate MediaVariant table (see TRUST_MODEL.md-equivalent
// docs/backend/MEDIA_ARCHITECTURE.md for the reuse rationale).
enum MediaVariantType {
  THUMBNAIL
  MEDIUM
  LARGE
  OPTIMIZED_WEB
}

// Phase 05 (spec section 23) - OCR is extraction assistance only; its output
// never automatically becomes verified historical text (still requires the
// normal Fact/Citation trust path to be cited as evidence).
enum DocumentOcrStatus {
  NOT_REQUESTED
  REQUESTED
  PROCESSING
  COMPLETE
  FAILED
}

enum TranslationStatus {
  DRAFT
  AI_ASSISTED
  HUMAN_REVIEWED
  PUBLISHED
}

enum TranslationMethod {
  ORIGINAL
  HUMAN
  AI_ASSISTED
}

// Section 9: Person aliases in particular need finer distinctions than a
// generic "alternate name" (a regnal name is not a temple name is not a
// title). Place/Event aliases mostly use the first four values.
enum AliasType {
  ALTERNATE_NAME
  HISTORICAL_NAME
  ROMANIZATION
  TRANSLITERATION
  ALTERNATE_SPELLING
  ABBREVIATION
  BIRTH_NAME
  REGNAL_NAME
  TEMPLE_NAME
  TITLE
  EPITHET
  OTHER
}

// Event classification (spec section 11). A catalog table + M2M join, not a
// single rigid enum on HistoricalEvent - an event can carry more than one
// theme (e.g. Bach Dang 1288 is both MILITARY and TERRITORIAL), and new
// specific themes can be added as data without a schema migration. The
// enum below is only the coarse, bounded category used for top-level
// filters - it is intentionally not Vietnam-specific so it can grow.
enum ThemeCategory {
  POLITICAL
  MILITARY
  CULTURAL
  DIPLOMATIC
  RELIGIOUS
  ECONOMIC
  SOCIAL
  SCIENTIFIC
  TERRITORIAL
  HERITAGE
  OTHER
}

enum TerritoryType {
  KINGDOM
  PROTECTORATE
  HISTORICAL_PROVINCE
  DISPUTED_ZONE
  ADMINISTRATIVE_BOUNDARY
  OTHER
}

enum EntityKind {
  PLACE
  PERSON
  EVENT
  ERA
  DYNASTY
  TERRITORY
  FACT
  STORY
  JOURNEY
  COMMUNITY_STORY
  SOURCE
  // Added Phase 09 - lets AuditLog/Contribution catalogue-result rows point
  // precisely at a SourceDocument rather than overloading SOURCE for both.
  SOURCE_DOCUMENT
  CONTRIBUTION
  MEDIA_ASSET
  COMMENT
  // Added G01 (Global Backend V2 Extension, Global Geography Foundation) -
  // additive-only extension of this V1 enum so EntityAlias/AuditLog can
  // point at the new global geography entities without a parallel alias
  // table (see docs/backend/GLOBAL_GEOGRAPHY.md section "Aliases"). No
  // existing value was renamed/removed/reordered.
  COUNTRY
  REGION
  CITY
  DESTINATION
  // Added G02 (Global Backend V2 Extension, Provider + Licensing
  // Foundation) - additive-only, lets AuditLog/Revision point precisely at
  // a Provider/ProviderLicense/ProviderIntegration row. Reuses the existing
  // generic Revision model for license/integration policy history rather
  // than a parallel revision table (spec section 17) - no existing value
  // was renamed/removed/reordered.
  PROVIDER
  PROVIDER_LICENSE
  PROVIDER_INTEGRATION
  // Added G05 (Global Backend V2 Extension, Stay + Food + Activities) -
  // additive-only, lets AuditLog point precisely at the new canonical
  // identity kinds. No existing value renamed/removed/reordered.
  ACCOMMODATION
  RESTAURANT
  CUISINE
  DISH
  ATTRACTION
  ACTIVITY
  // Added G06 (Global Backend V2 Extension, Trip Planner + Cost Engine) -
  // additive-only, lets AuditLog point precisely at a private Trip or an
  // admin-managed CostAssumption row. No existing value renamed/removed/
  // reordered.
  TRIP
  TRIP_COST_ASSUMPTION
}

enum CommunityStoryType {
  MEMORY
  LOCAL_STORY
  TRAVEL_EXPERIENCE
  THEN_AND_NOW
  DOCUMENT_CONTRIBUTION
  FAMILY_HISTORY
  PHOTO_STORY
}

enum CommunityVerificationState {
  PERSONAL_MEMORY
  COMMUNITY_SUBMISSION
  SOURCE_ATTACHED
  UNDER_REVIEW
  VERIFIED_CONTRIBUTION
}

enum ModerationStatus {
  VISIBLE
  LIMITED
  UNDER_REVIEW
  REMOVED
  LOCKED
}

enum ReportCategory {
  MISINFORMATION
  HATEFUL_CONTENT
  HARASSMENT
  SPAM
  COPYRIGHT
  PERSONAL_INFORMATION
  GRAPHIC_CONTENT
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ContributionStatus {
  SUBMITTED
  TRIAGE
  PROVENANCE_REVIEW
  HISTORICAL_REVIEW
  ACCEPTED
  CATALOGUED
  REJECTED
}

// Phase 09 (spec section 5) - meaningful submission classes without an
// over-narrow taxonomy. CORRECTION is its own type rather than reusing e.g.
// PERSONAL_MEMORY, since a correction targets an existing canonical record
// (see `correctionTargetType`/`correctionTargetId` on Contribution) rather
// than contributing new material.
enum ContributionType {
  DOCUMENT
  PHOTO
  ARCHIVAL_PHOTO
  MAP
  ORAL_HISTORY
  PERSONAL_MEMORY
  FAMILY_ARCHIVE
  BOOK_REFERENCE
  LOCAL_HISTORY
  CORRECTION
  OTHER
}

// Phase 09 (spec section 9) - the kind of provenance evidence a submitter is
// pointing at, distinct from `SourceType` on the canonical `Source` model.
// A ContributionSource is a claim about where material came from; it never
// becomes a real Source row just by existing (spec section 9/30).
enum ContributionSourceType {
  BOOK
  ARCHIVE
  WEBSITE
  FAMILY_RECORD
  ORIGINAL_DOCUMENT
  ORAL_TESTIMONY
  INSTITUTIONAL
  OTHER
}

// Phase 09 (spec section 11) - a reviewer's internal assessment of how
// well-supported a contribution's claimed provenance is. Never historical
// certainty (that is `FactCertainty`, only reachable via the real
// HistoricalFact workflow) and never shown publicly as a trust label
// without context (spec section 11).
enum ProvenanceConfidence {
  UNASSESSED
  LOW
  MEDIUM
  HIGH
  CONFIRMED
  DISPUTED
}

// Phase 09 (spec section 12) - reviewer-controlled rights assessment for a
// contribution, entirely separate from `submitterDeclaration` below (a
// submitter's own unadjudicated claim). Reuses the Phase 05 rights-review
// philosophy (never self-approved) rather than inventing new semantics.
enum ContributionRightsReviewState {
  UNREVIEWED
  NEEDS_INFORMATION
  APPROVED_FOR_CATALOGUE
  RESTRICTED
  REJECTED
}

// Phase 09 (spec section 13) - the submitter's own claim about their right
// to share the material. A claim, never an adjudicated rights state -
// `ContributionRightsReviewState` above is the only field a reviewer acts on.
enum SubmitterRightsDeclaration {
  OWN_MATERIAL
  HAVE_PERMISSION
  PUBLICLY_AVAILABLE
  UNKNOWN
}

// Phase 09 (spec section 64) - how (or whether) a contributor wants public
// credit if their material is ever catalogued. Never inferred from upload
// alone (spec section 65).
enum ContributionAttribution {
  NAMED
  ANONYMOUS
  INSTITUTIONAL
}

// Phase 09 (spec section 27) - the decision recorded by a single
// ContributionReviewNote row. Distinct from ContributionStatus - a decision
// is what a reviewer concluded at one stage, the status is where the
// contribution currently sits (same distinction as HistoricalFact's
// ReviewDecision vs FactEditorialStatus).
enum ContributionReviewDecision {
  APPROVE
  REJECT
  REQUEST_INFO
  RETURN_TO_PREVIOUS_STAGE
}

// Phase 09 (spec section 29) - what kind of canonical record a
// ContributionCatalogueResult row points at. A single ACCEPTED contribution
// may produce more than one of these (e.g. a Source and its SourceDocument),
// so this is a set of result rows, never a single nullable pointer.
enum ContributionCatalogueResultType {
  SOURCE
  SOURCE_DOCUMENT
  MEDIA_ASSET
  FACT_DRAFT
}

// =========================================================================
// IDENTITY & AUTH  (Phase 02)
// =========================================================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  emailVerifiedAt     DateTime?
  displayName         String
  avatarMediaId       String?
  status              UserStatus @default(ACTIVE)
  roles               Role[]     @default([USER])
  locale              String     @default("vi")
  // Privacy toggle (spec Phase 08 section 27) - visited places are a
  // personal record and stay private on the public profile unless the user
  // explicitly opts in. Saved items (Bookmark) have no public-read path at
  // all, so they need no equivalent toggle - they are structurally private.
  visitedPlacesPublic Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  authIdentities      AuthIdentity[]
  sessions            Session[]
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  comments            Comment[]
  commentVotes        CommentVote[]
  bookmarks           Bookmark[]
  reports             Report[]                 @relation("ReportsFiled")
  resolvedReports     Report[]                 @relation("ReportsResolved")
  placeVisits         PlaceVisit[]
  communityStories    CommunityStory[]
  storyVotes          StoryVote[]
  badges              UserBadge[]
  badgesGranted       UserBadge[]              @relation("BadgesGranted")
  contributions       Contribution[]
  contributionReviews ContributionReviewNote[]
  auditLogs           AuditLog[]
  revisionsAuthored   Revision[]
  factReviews         FactReview[]
  thenNowComparisons  ThenNowComparison[]
  // Added G06 (Global Backend V2 Extension, Trip Planner + Cost Engine) -
  // a Trip is private, single-owner planning data (spec section 9/59) - no
  // TripMember/collaboration model yet (deferred to G07).
  trips               Trip[]

  avatarMedia MediaAsset? @relation("UserAvatar", fields: [avatarMediaId], references: [id])

  @@index([email])
}

model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String?
  passwordHash   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String         @id @default(cuid())
  userId           String
  refreshTokenHash String         @unique
  platform         ClientPlatform @default(OTHER)
  userAgent        String?
  ip               String?
  deviceLabel      String?
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime       @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================================================================
// SHARED: MEDIA  (Phase 05)
// =========================================================================

model MediaAsset {
  id                 String            @id @default(cuid())
  type               MediaType
  status             MediaAssetStatus  @default(PENDING_UPLOAD)
  storageKey         String
  mimeType           String
  sizeBytes          Int?
  width              Int?
  height             Int?
  // SHA-256 hex digest, computed server-side on confirm - never trusted from
  // the client (spec section 56). Used for integrity/dedup assistance only,
  // never to infer ownership or licensing.
  checksum           String?
  title              String?
  caption            String?
  altText            String?
  creatorName        String?
  sourceId           String?
  captureYear        Int?
  captureMonth       Int?
  captureDay         Int?
  capturePrecision   DatePrecision     @default(UNKNOWN)
  license            String?
  rightsHolder       String?
  rightsStatus       RightsStatus      @default(UNKNOWN)
  attributionText    String?
  // Set only by an EDITOR/HISTORIAN_REVIEWER/ADMIN action (never by the
  // uploader) - an ordinary contributor cannot self-declare PUBLIC_DOMAIN
  // (spec section 46). Plain audit-style pointer, no relation object, same
  // convention as HistoricalFact.reviewedById.
  rightsReviewedById String?
  rightsReviewedAt   DateTime?
  provenanceNote     String?
  isHistorical       Boolean           @default(false)
  isAiGenerated      Boolean           @default(false)
  aiDisclosure       String?
  parentAssetId      String?
  // Only meaningful when parentAssetId is set - which derived rendition this
  // row is (spec section 17).
  variantType        MediaVariantType?
  accessPolicy       AccessPolicy      @default(PUBLIC)
  uploadedById       String?
  uploadConfirmedAt  DateTime?
  quarantinedAt      DateTime?
  quarantinedById    String?
  quarantineReason   String?
  archivedAt         DateTime?
  archivedById       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  source      Source?      @relation(fields: [sourceId], references: [id])
  parentAsset MediaAsset?  @relation("MediaDerivatives", fields: [parentAssetId], references: [id])
  derivatives MediaAsset[] @relation("MediaDerivatives")

  userAvatars                  User[]                        @relation("UserAvatar")
  placesHero                   Place[]                       @relation("PlaceHeroMedia")
  peopleHero                   Person[]                      @relation("PersonHeroMedia")
  eventsHero                   HistoricalEvent[]             @relation("EventHeroMedia")
  storiesHero                  Story[]                       @relation("StoryHeroMedia")
  journeysHero                 Journey[]                     @relation("JourneyHeroMedia")
  communityStoriesHero         CommunityStory[]              @relation("CommunityStoryHeroMedia")
  destinationsHero             Destination[]                 @relation("DestinationHeroMedia")
  accommodationsHero           Accommodation[]               @relation("AccommodationHeroMedia")
  restaurantsHero              Restaurant[]                  @relation("RestaurantHeroMedia")
  attractionsHero              Attraction[]                  @relation("AttractionHeroMedia")
  sourceDocuments              SourceDocument[]
  entityMedia                  EntityMedia[]
  contributionMedia            ContributionMedia[]
  translations                 MediaAssetTranslation[]
  thenNowBefore                ThenNowComparison[]           @relation("ThenNowBefore")
  thenNowAfter                 ThenNowComparison[]           @relation("ThenNowAfter")
  contributionSourceEvidence   ContributionSource[]
  contributionCatalogueResults ContributionCatalogueResult[]

  // Phase 05.1 (spec section 10) - DB-level idempotency for derivative
  // generation: re-running the processor for the same parent upserts the
  // same (parentAssetId, variantType) row rather than creating a duplicate.
  // Safe for original (non-derivative) rows too - Postgres treats each
  // NULL/NULL pair as distinct, so it never collides them.
  @@unique([parentAssetId, variantType])
  @@index([type])
  @@index([sourceId])
  @@index([status])
}

// Optional locale-specific editorial caption/alt text (spec section 34) -
// most uploads (community photos especially) never get one and fall back to
// the flat `caption`/`altText`/`title` on MediaAsset itself, which is always
// in whatever locale the uploader used ("Community caption should preserve
// original locale separately" - spec section 34). Only curated editorial
// media (hero images, gallery features) is expected to gain rows here.
model MediaAssetTranslation {
  id           String   @id @default(cuid())
  mediaAssetId String
  locale       String
  caption      String?
  altText      String?
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, locale])
}

// generic gallery attachment (lower-integrity per spec section 15/41)
model EntityMedia {
  id           String     @id @default(cuid())
  entityType   EntityKind
  entityId     String
  mediaAssetId String
  role         String     @default("gallery")
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([mediaAssetId])
}

// =========================================================================
// SHARED: ALIASES  (cross-language / alternate names search - section 22)
// =========================================================================

model EntityAlias {
  id         String     @id @default(cuid())
  entityType EntityKind
  entityId   String
  // "" (not null) for a locale-agnostic alias, so the unique constraint
  // below actually catches duplicates - Postgres treats NULL as distinct
  // from NULL in unique indexes, which would silently let dupes through.
  locale     String     @default("")
  alias      String
  aliasType  AliasType  @default(ALTERNATE_NAME)
  createdAt  DateTime   @default(now())

  @@unique([entityType, entityId, locale, alias])
  @@index([entityType, entityId])
  @@index([alias])
}

// =========================================================================
// GLOBAL GEOGRAPHY  (G01 - Global Backend V2 Extension, Global Geography
// Foundation)
//
// Design notes (see docs/backend/GLOBAL_GEOGRAPHY.md for full rationale):
// - New, additive domain. Does not rename/replace/repurpose any Phase
//   00-12.1 model. Place/Person/HistoricalEvent/etc. remain the frozen V1
//   historical-knowledge entities; Country/Region/City/Destination below are
//   a separate, global, travel/discovery geography layer per the G00
//   Product Constitution ("Destination != Place").
// - Reuses PublicationStatus/TranslationStatus/TranslationMethod (no new
//   editorial-workflow enums) and the existing EntityAlias/AuditLog
//   architecture (EntityKind gained COUNTRY/REGION/CITY/DESTINATION above,
//   additive-only) rather than inventing parallel mechanisms.
// - Representative point only: plain latitude/longitude Float columns, not
//   PostGIS geometry. No bbox/ST_DWithin query is needed for these entities
//   in G01 (Place already owns that for historical sites) - G11 (Global
//   Search + Map) can add PostGIS geometry additively later if a real
//   proximity/bbox query requirement emerges.
// - Hierarchy is deliberately NOT a rigid Country->Region->City->Destination
//   chain: Region is optional on City and on Destination, City is optional
//   on Destination, so "Country -> City" and "Country -> Destination" and
//   "Region -> Destination" all remain valid shapes (spec section 4) - e.g.
//   an island or heritage area with no containing City.
// - Slug strategy deliberately differs from every other V1 translation
//   table: Country keeps the V1 `@@unique([locale, slug])` global
//   constraint (real-world country-name collisions are not a real risk),
//   but Region/City/Destination translations do NOT get that global
//   constraint - common city/region names legitimately collide worldwide
//   (Springfield, Victoria, San Jose - spec section 14), so it would be
//   unsafe to promise global per-locale slug uniqueness for those. The
//   stable, always-unique lookup key for all four is `canonicalSlug` on the
//   parent model itself (auto-suffixed on collision, same mechanism as
//   `Place.canonicalSlug`); the scoped routes (`/v1/countries/:c/cities`)
//   give callers country/region/city context to disambiguate a common name.
// - No delete endpoint is provided anywhere in this domain (archive via
//   `status` only) - the same convention Place/Person already use (spec
//   section 31).
// =========================================================================

// Broad enough for the known G00 administrative shapes (province, state,
// prefecture, a centrally-governed "direct administration" municipality
// such as Hanoi or Tokyo Metropolis) without assuming every country's
// administrative system resembles Vietnam's (spec section 7). Deliberately
// does not attempt to model administrative-vs-tourism-region distinctions
// in G01 - no concrete requirement for a separate TravelRegion model exists
// yet (spec section 7).
enum RegionType {
  PROVINCE
  STATE
  PREFECTURE
  AUTONOMOUS_REGION
  METROPOLITAN_CITY
  TERRITORY
  OTHER
}

// Broad enough for G00's known use cases (spec section 11) without being
// excessively speculative - audited against PlaceType/existing enums first;
// none of them model this "broader than a historical site" travel-discovery
// concept, so a new enum is genuinely needed here (Destination != Place).
enum DestinationType {
  CITY_AREA
  NEIGHBORHOOD
  HISTORIC_DISTRICT
  HERITAGE_AREA
  ISLAND
  ARCHIPELAGO
  NATURAL_AREA
  NATIONAL_PARK
  COAST
  BAY
  TOURISM_AREA
  OTHER
}

model Country {
  id              String            @id @default(cuid())
  canonicalSlug   String            @unique
  // ISO 3166-1 alpha-2/alpha-3, normalized uppercase and validated in the
  // DTO layer (spec section 5) - never invented/guessed.
  iso2            String            @unique
  iso3            String            @unique
  // Geographical defaults only (spec section 18) - never used to infer a
  // user's own UI language, and not restricted to this platform's currently
  // supported translation locales (vi/en): Japan's defaultLocale is "ja"
  // even though no ja translation exists yet.
  defaultLocale   String
  // ISO 4217, normalized uppercase.
  defaultCurrency String
  latitude        Float?
  longitude       Float?
  status          PublicationStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  translations           CountryTranslation[]
  regions                Region[]
  cities                 City[]
  destinations           Destination[]
  // G03: reverse side of Place.currentCountryId/EventCountry/EraCountry -
  // this global geography domain (G01) stays otherwise unaware of the
  // historical domain; these are the only new back-relations added here.
  currentPlaces          Place[]
  eventLinks             EventCountry[]
  eraLinks               EraCountry[]
  // G04: optional country-scoped editorial Destination collections.
  destinationCollections DestinationCollection[]
  // G05 (Stay + Food + Activities) - additive-only reverse relations.
  accommodations         Accommodation[]
  restaurants            Restaurant[]
  attractions            Attraction[]
  activities             Activity[]
  cuisines               Cuisine[]
  // G06 (Trip Planner + Cost Engine) - reverse side of Trip.originCountryId
  // (a Trip's optional origin, not a home address - spec section 13).
  originatingTrips       Trip[]                  @relation("TripOriginCountry")

  @@index([status])
}

model CountryTranslation {
  id               String            @id @default(cuid())
  countryId        String
  locale           String
  name             String
  slug             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?
  status           TranslationStatus @default(DRAFT)
  method           TranslationMethod @default(ORIGINAL)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, locale])
  @@unique([locale, slug])
}

model Region {
  id             String            @id @default(cuid())
  canonicalSlug  String            @unique
  countryId      String
  parentRegionId String?
  type           RegionType
  code           String?
  latitude       Float?
  longitude      Float?
  status         PublicationStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  country      Country  @relation(fields: [countryId], references: [id])
  parentRegion Region?  @relation("RegionHierarchy", fields: [parentRegionId], references: [id])
  childRegions Region[] @relation("RegionHierarchy")

  translations     RegionTranslation[]
  cities           City[]
  destinations     Destination[]
  // G03: reverse side of Place.currentRegionId.
  currentPlaces    Place[]
  // G05 (Stay + Food + Activities) - additive-only reverse relations.
  accommodations   Accommodation[]
  restaurants      Restaurant[]
  attractions      Attraction[]
  activities       Activity[]
  cuisines         Cuisine[]
  // G06 (Trip Planner + Cost Engine) - reverse side of Trip.originRegionId.
  originatingTrips Trip[]              @relation("TripOriginRegion")

  @@index([countryId])
  @@index([parentRegionId])
  @@index([type])
  @@index([status])
}

// No global `@@unique([locale, slug])` - see the domain-level design note
// above. `slug` is still generated and stored for future localized-route
// use, just not promised globally unique.
model RegionTranslation {
  id             String            @id @default(cuid())
  regionId       String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, locale])
}

model City {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  // Optional (spec section 9) - Country is authoritative; not every city
  // needs a Region parent.
  regionId      String?
  // IANA timezone identifier (e.g. "Asia/Tokyo"), validated against
  // Intl.supportedValuesOf('timeZone') in the service layer - never just a
  // fixed UTC offset (spec section 17 - DST exists).
  timezone      String
  latitude      Float?
  longitude     Float?
  importance    Int               @default(0)
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country Country @relation(fields: [countryId], references: [id])
  region  Region? @relation(fields: [regionId], references: [id])

  translations     CityTranslation[]
  destinations     Destination[]
  // G03: reverse side of Place.currentCityId.
  currentPlaces    Place[]
  // G05 (Stay + Food + Activities) - additive-only reverse relations.
  accommodations   Accommodation[]
  restaurants      Restaurant[]
  attractions      Attraction[]
  activities       Activity[]
  // G06 (Trip Planner + Cost Engine) - reverse side of Trip.originCityId and
  // of TripTransportLeg's from/to city legs (see TripTransportLeg below).
  originatingTrips Trip[]            @relation("TripOriginCity")

  @@index([countryId])
  @@index([regionId])
  @@index([status])
}

// No global `@@unique([locale, slug])` - see the domain-level design note
// above (Springfield/Victoria/San Jose collision risk across countries).
model CityTranslation {
  id             String            @id @default(cuid())
  cityId         String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, locale])
}

model Destination {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  // Both optional (spec section 11) - Country is required and authoritative;
  // Region/City are additional, validated-consistent context, not a
  // mandatory chain.
  regionId      String?
  cityId        String?
  type          DestinationType
  latitude      Float?
  longitude     Float?
  importance    Int               @default(0)
  status        PublicationStatus @default(DRAFT)
  // G04: optional cover image - reuses the existing MediaAsset lifecycle/
  // rights/access-policy machinery (spec "Media" section) exactly like
  // Place.heroMediaId/Person.heroMediaId already do. No raw URL is ever
  // stored here - the public composition layer resolves a URL through
  // MediaAsset the same way every other hero-media relation in this schema
  // already does, so accessPolicy/status gating is inherited for free.
  heroMediaId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country   Country     @relation(fields: [countryId], references: [id])
  region    Region?     @relation(fields: [regionId], references: [id])
  city      City?       @relation(fields: [cityId], references: [id])
  heroMedia MediaAsset? @relation("DestinationHeroMedia", fields: [heroMediaId], references: [id])

  translations          DestinationTranslation[]
  // G04 (Destination Discovery) - additive-only composition relations. Each
  // is deliberately its own small typed join table (never a generic
  // entityType+entityId polymorphic relation - spec "no unsafe generic
  // polymorphic relation") so referential integrity is DB-enforced and each
  // relation can carry its own curation-specific fields (role/sortOrder/
  // featured) without contaminating the others.
  placeLinks            DestinationPlace[]
  themeLinks            DestinationTheme[]
  storyLinks            DestinationStory[]
  journeyLinks          DestinationJourney[]
  // Curated historical turning points for the future "How X Became X"
  // composition (spec section 101/102) - explicit and minimal, never a
  // duplicate of HistoricalEvent content, never implying the relation
  // itself is additional historical evidence (see DestinationPlace doc
  // comment below for the identical trust-boundary reasoning).
  eventLinks            DestinationEvent[]
  collectionMemberships DestinationCollectionMember[]
  // G05 (Stay + Food + Activities) - additive-only, same small-typed-join-
  // table pattern as the G04 links above.
  accommodationLinks    DestinationAccommodation[]
  restaurantLinks       DestinationRestaurant[]
  attractionLinks       DestinationAttraction[]
  activityLinks         DestinationActivity[]
  dishLinks             DestinationDish[]
  // G06 (Trip Planner + Cost Engine) - a Trip's private, owner-scoped
  // selection of this Destination (never the reverse - Destination itself
  // stays completely unaware of any specific Trip's planning state, spec
  // section 5 "Trip != Journey").
  tripDestinations      TripDestination[]
  tripTransportLegsFrom TripTransportLeg[]            @relation("TripTransportLegFrom")
  tripTransportLegsTo   TripTransportLeg[]            @relation("TripTransportLegTo")

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([type])
  @@index([status])
  @@index([heroMediaId])
}

// No global `@@unique([locale, slug])` - see the domain-level design note
// above.
model DestinationTranslation {
  id             String            @id @default(cuid())
  destinationId  String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  // G04 discovery-editorial fields (spec section 16/17) - short, honest,
  // non-operational copy only (no live price/hours/availability - see
  // "Destination Discovery Profile"). Additive columns on the existing
  // translation row, following the exact same per-locale pattern every
  // other field here already uses - never a bare `taglineVi`/`taglineEn`.
  tagline        String?
  whyVisit       String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, locale])
}

// =========================================================================
// G04 - DESTINATION DISCOVERY (Global Backend V2 Extension)
//
// Design notes (docs/backend/G04_DESTINATION_DISCOVERY.md has the full
// rationale):
// - Destination is NOT replaced/duplicated - every model below is additive
//   and hangs off the existing G01 `Destination`/`Country`/`Region`/`City`.
// - Destination<->Place is a real many-to-many (a Place may be relevant to
//   several Destinations, e.g. a temple belonging to both a neighborhood
//   Destination and a broader city Destination) - never a
//   `Place.destinationId` single FK.
// - DestinationPlace/Theme/Story/Journey/Event are each their own small,
//   typed join table - never one generic `entityType + entityId` relation -
//   so referential integrity is enforced by real foreign keys, not
//   application-layer trust, and each can carry its own curation fields.
// - TRUST BOUNDARY (spec section 14/16, CRITICAL): none of these relations
//   are themselves historical claims. `DestinationPlace` means "this Place
//   is editorially associated with this Destination" - it does NOT mean
//   the Destination historically governed the Place, that the Destination
//   existed when the Place's history occurred, or that every HistoricalFact
//   about the Place is a fact about the Destination. No new HistoricalFact/
//   Citation/Source row is implied or required by any relation in this
//   section.
// =========================================================================

enum DestinationPlaceRole {
  CORE
  LANDMARK
  HISTORICAL
  CULTURAL
  NATURAL
  CONTEXTUAL
}

// Destination<->Place composition (spec section 13) - the core G04 relation.
model DestinationPlace {
  id            String               @id @default(cuid())
  destinationId String
  placeId       String
  role          DestinationPlaceRole @default(CONTEXTUAL)
  sortOrder     Int                  @default(0)
  isFeatured    Boolean              @default(false)
  editorialNote String?
  createdAt     DateTime             @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  place       Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([destinationId, placeId])
  @@index([placeId])
  @@index([destinationId, sortOrder])
}

// Destination<->Theme (spec section 19) - reuses the existing V1 `Theme`
// domain as-is (no duplicate taxonomy, no per-destination boolean columns).
model DestinationTheme {
  id            String   @id @default(cuid())
  destinationId String
  themeId       String
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  theme       Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([destinationId, themeId])
  @@index([themeId])
}

// Destination<->Story curation (spec section 22/100) - explicit and minimal
// so ordering is deterministic and editorially controllable; a Story that
// merely links through a shared Place is NOT silently inferred as
// "belonging" to a Destination (no arbitrary graph traversal).
model DestinationStory {
  id            String   @id @default(cuid())
  destinationId String
  storyId       String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  story       Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([destinationId, storyId])
  @@index([storyId])
}

// Destination<->Journey curation (spec section 23) - same reasoning as
// DestinationStory above.
model DestinationJourney {
  id            String   @id @default(cuid())
  destinationId String
  journeyId     String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  journey     Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([destinationId, journeyId])
  @@index([journeyId])
}

// Curated historical turning points for a Destination's future "How X
// Became X" composition (spec section 101/102) - only added because no
// existing relation can deterministically express "these specific N events,
// in this order, are the Destination's editorial turning points" (EventCountry
// links an Event to every country-wide occurrence, not to a specific
// Destination). Does not duplicate HistoricalEvent content.
model DestinationEvent {
  id            String   @id @default(cuid())
  destinationId String
  eventId       String
  sortOrder     Int      @default(0)
  role          String?
  createdAt     DateTime @default(now())

  destination Destination     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  event       HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([destinationId, eventId])
  @@index([eventId])
}

// Editorial Destination collections (spec section 24) - only introduced
// because the existing `EditorialSlot` has no slug/translations/publication
// status of its own (a positional homepage slot, not a browsable page) and
// so cannot represent a page like "Ancient Capitals" with its own title/
// summary. Deliberately NOT personalized (spec section 24: "no personalized
// collections in G04").
model DestinationCollection {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  // Optional scope - a collection may be country-specific ("Vietnam
  // Heritage Trail") or cross-country ("Ancient Capitals"). Nullable, not a
  // required chain.
  countryId     String?
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country Country? @relation(fields: [countryId], references: [id])

  translations DestinationCollectionTranslation[]
  members      DestinationCollectionMember[]

  @@index([countryId])
  @@index([status])
}

model DestinationCollectionTranslation {
  id           String            @id @default(cuid())
  collectionId String
  locale       String
  name         String
  slug         String
  summary      String?
  description  String?
  status       TranslationStatus @default(DRAFT)
  method       TranslationMethod @default(ORIGINAL)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  collection DestinationCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@unique([locale, slug])
}

model DestinationCollectionMember {
  id            String   @id @default(cuid())
  collectionId  String
  destinationId String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  collection  DestinationCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  destination Destination           @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([collectionId, destinationId])
  @@index([destinationId])
}

// =========================================================================
// PROVIDER + LICENSING FOUNDATION  (G02 - Global Backend V2 Extension)
//
// Design notes (see docs/backend/PROVIDER_LICENSING.md for full rationale):
// - "No external dataset can become active unless the platform knows what
//   it is legally and technically allowed to do with that data." This
//   domain is pure infrastructure/governance - it does not integrate any
//   real provider API (that is G05's job) and is entirely geography-
//   independent (no relation to Country/Region/City/Destination - spec
//   section 37) and entirely separate from the V1 historical Source/
//   Citation trust chain (spec section 38/39 - an ExternalProvider record
//   NEVER becomes historical evidence).
// - Named `ExternalProvider`, not `TravelProvider` (spec section 5) -
//   future providers may include maps/currency/weather, not just travel.
// - Rights are tri/four-state (`ProviderRightState`: UNKNOWN/ALLOWED/
//   PROHIBITED/CONDITIONAL), never a plain Boolean (spec section 11) - a
//   `false` must never be allowed to mean both "explicitly forbidden" and
//   "not yet reviewed" at once.
// - `ProviderLicense.status` alone drives the review lifecycle (DRAFT ->
//   TERMS_REVIEW -> LEGAL_REVIEW -> APPROVED -> {EXPIRED, REVOKED,
//   REJECTED}) - no separate, potentially-contradicting `reviewStatus`
//   field was added; `reviewedAt`/`reviewedById` remain as audit pointers,
//   same convention as `HistoricalFact.reviewedById`.
// - History/provenance reuses the EXISTING generic `Revision` model
//   (EntityKind gained PROVIDER/PROVIDER_LICENSE/PROVIDER_INTEGRATION,
//   additive) rather than a parallel `ProviderLicenseRevision` table (spec
//   section 17 explicitly calls for auditing existing mechanisms first).
// - `ProviderDataPolicy` (operational retention/cache numbers) is
//   deliberately kept separate from `ProviderLicense` (the legal rights
//   grant) even though both are scoped per capability: a License's rights
//   review has a different approval cadence/authority (legal review) than
//   tuning an operational cache-TTL number, and every DataPolicy still
//   traces back to the License that authorizes it (`licenseId`, required).
// - `ProviderPolicyEvidence` attaches to a License only (not a separate
//   polymorphic "policy" pointer) - every DataPolicy/AttributionRule
//   already links back to a License, so evidence-for-a-License covers them
//   transitively without a messier polymorphic evidence table.
// - Activation is never a cached decision: `ProviderIntegrationCapability`
//   existence is a write-time admin record, but the real serving gate
//   (`ProviderRegistryService.getExecutionContext`, application code, not
//   schema) re-evaluates provider/integration/capability/license state
//   fresh from the database on every call, so a license revocation or
//   expiry takes effect immediately with nothing to invalidate (spec
//   sections 20/42/43).
// =========================================================================

enum ProviderStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  DISABLED
  EXPIRED
}

enum ProviderEnvironment {
  SANDBOX
  PRODUCTION
}

// How our own integration authenticates with this provider - metadata
// only, never a secret value (spec section 9).
enum ProviderCredentialMode {
  NONE
  API_KEY
  OAUTH2
  PARTNER_CONTRACT
  OTHER
}

// A disciplined initial taxonomy (spec section 7), not an enum entry per
// hypothetical API action. Extend additively as a genuine G05+ need
// arises - do not pre-populate speculative values.
enum ProviderCapabilityType {
  PLACE_SEARCH
  PLACE_DETAIL
  NEARBY_SEARCH
  TEXT_SEARCH
  ACCOMMODATION_SEARCH
  ACCOMMODATION_DETAIL
  LIVE_PRICE
  AVAILABILITY
  RESTAURANT_SEARCH
  RESTAURANT_DETAIL
  ACTIVITY_SEARCH
  ACTIVITY_DETAIL
  FLIGHT_SEARCH
  CAR_RENTAL_SEARCH
  REVIEWS
  PHOTOS
  BOOKING_REDIRECT
  BOOKING_API
  AFFILIATE_LINK
  WEBHOOK
  CONVERSION_REPORTING
}

enum ProviderIntegrationStatus {
  NOT_CONFIGURED
  PENDING_APPROVAL
  CONFIGURED
  ACTIVE
  SUSPENDED
  FAILED
  REVOKED
}

// The tri/four-state rights representation (spec section 11). CONDITIONAL
// carries its constraint in the sibling `*Notes`/`conditionalNotes` field -
// never collapsed into a bare boolean.
enum ProviderRightState {
  UNKNOWN
  ALLOWED
  PROHIBITED
  CONDITIONAL
}

enum ProviderLicenseStatus {
  DRAFT
  TERMS_REVIEW
  LEGAL_REVIEW
  APPROVED
  EXPIRED
  REVOKED
  REJECTED
}

enum ProviderAttributionRequirement {
  UNKNOWN
  REQUIRED
  NOT_REQUIRED
  CONDITIONAL
}

enum ProviderPolicyEvidenceSourceType {
  OFFICIAL_TERMS
  OFFICIAL_DEVELOPER_DOC
  OFFICIAL_PARTNER_DOC
  OFFICIAL_PRICING_DOC
  CONTRACT
  LEGAL_REVIEW
  OTHER
}

model ExternalProvider {
  id                    String                 @id @default(cuid())
  // Stable, machine-readable, unique (spec section 6) - e.g. GOOGLE_PLACES.
  // No provider-specific business logic is ever hardcoded against this
  // string outside of test fixtures; real adapters register by code.
  code                  String                 @unique
  name                  String
  status                ProviderStatus         @default(DRAFT)
  websiteUrl            String?
  developerUrl          String?
  partnerPortalUrl      String?
  credentialMode        ProviderCredentialMode @default(NONE)
  // Which environments this provider generally offers (e.g. some providers
  // have no sandbox) - a plain scalar list, same convention as
  // `User.roles: Role[]`.
  supportedEnvironments ProviderEnvironment[]  @default([])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  capabilities            ProviderCapability[]
  integrations            ProviderIntegration[]
  licenses                ProviderLicense[]
  dataPolicies            ProviderDataPolicy[]
  attributionRules        ProviderAttributionRule[]
  // G05 (Stay + Food + Activities) - additive-only reverse relations.
  accommodationReferences ProviderAccommodationReference[]
  restaurantReferences    ProviderRestaurantReference[]
  activityReferences      ProviderActivityReference[]

  @@index([status])
}

// What the provider TECHNICALLY supports (spec section 7) - independent of
// whether OUR account is approved/enabled for it (see
// ProviderIntegrationCapability below).
model ProviderCapability {
  id         String                 @id @default(cuid())
  providerId String
  capability ProviderCapabilityType
  notes      String?
  createdAt  DateTime               @default(now())

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capability])
  @@index([providerId])
}

// Our own account/environment-specific integration state (spec section 8) -
// distinct from the provider's mere existence. `credentialReference` is an
// env-var/secret-manager KEY NAME only, never a secret value (spec
// section 9).
model ProviderIntegration {
  id                  String                    @id @default(cuid())
  providerId          String
  environment         ProviderEnvironment
  status              ProviderIntegrationStatus @default(NOT_CONFIGURED)
  credentialReference String?
  configuredAt        DateTime?
  lastVerifiedAt      DateTime?
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  enabledCapabilities ProviderIntegrationCapability[]

  @@unique([providerId, environment])
  @@index([providerId])
  @@index([status])
}

// Capability ENABLED_FOR_OUR_ACCOUNT (spec section 7's "a provider may
// technically support BOOKING_API, but our account may only be approved
// for BOOKING_REDIRECT"). Existence of this row (written only through the
// gated activation path, never a bare upsert) is the enablement signal;
// the real serving gate still re-checks the underlying license live on
// every use (see design note above) - this row is a write-time record, not
// a cached "safe to serve" flag.
model ProviderIntegrationCapability {
  id            String                 @id @default(cuid())
  integrationId String
  capability    ProviderCapabilityType
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime               @default(now())

  integration ProviderIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, capability])
  @@index([integrationId])
}

// The legal/contractual rights grant (spec sections 10-13). Scoped to a
// specific product/dataset and, where meaningful, a specific capability -
// spec section 13's "do NOT assume one provider = one license" (e.g.
// Google Places data vs Google Places photos can carry different rights).
model ProviderLicense {
  id               String                  @id @default(cuid())
  providerId       String
  // Human label for the licensed product/dataset (e.g. "Places API core
  // data", "Place Photos") - always required, independent of `capability`.
  datasetOrProduct String
  // Optional narrower scope when this license maps cleanly onto one
  // capability; null means it applies at the datasetOrProduct level only.
  capability       ProviderCapabilityType?
  licenseType      String?
  status           ProviderLicenseStatus   @default(DRAFT)

  rightsDisplay       ProviderRightState @default(UNKNOWN)
  rightsCache         ProviderRightState @default(UNKNOWN)
  rightsStore         ProviderRightState @default(UNKNOWN)
  rightsModify        ProviderRightState @default(UNKNOWN)
  rightsRedistribute  ProviderRightState @default(UNKNOWN)
  rightsCommercialUse ProviderRightState @default(UNKNOWN)
  // Required whenever any right above is CONDITIONAL (service-enforced,
  // not a DB constraint - see ProviderLicensesService).
  conditionalNotes    String?

  attributionRequirement ProviderAttributionRequirement @default(UNKNOWN)

  termsUrl          String
  privacyUrl        String?
  developerTermsUrl String?

  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  reviewedAt   DateTime?
  reviewedById String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider         ExternalProvider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dataPolicies     ProviderDataPolicy[]
  attributionRules ProviderAttributionRule[]
  evidence         ProviderPolicyEvidence[]

  @@index([providerId])
  @@index([status])
  @@index([providerId, capability])
}

// Operational retention/cache configuration (spec section 16) - always
// traces back to the License that authorizes it. Deliberately separate
// from ProviderLicense - see the domain design note above.
model ProviderDataPolicy {
  id         String                 @id @default(cuid())
  providerId String
  licenseId  String
  capability ProviderCapabilityType

  cacheAllowed                ProviderRightState @default(UNKNOWN)
  maxCacheSeconds             Int?
  storeIdentityAllowed        ProviderRightState @default(UNKNOWN)
  storeContentAllowed         ProviderRightState @default(UNKNOWN)
  refreshRequiredAfterSeconds Int?
  deleteAfterSeconds          Int?
  persistentIdentifierAllowed ProviderRightState @default(UNKNOWN)

  policySourceUrl String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  license  ProviderLicense  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, capability])
  @@index([providerId])
}

// First-class attribution requirement (spec section 14) - never left to
// frontend conditionals. `licenseId` optional (a provider-wide default
// attribution rule not tied to one license is representable).
model ProviderAttributionRule {
  id             String                         @id @default(cuid())
  providerId     String
  licenseId      String?
  capability     ProviderCapabilityType?
  requirement    ProviderAttributionRequirement @default(UNKNOWN)
  displayText    String?
  logoRequired   Boolean                        @default(false)
  linkUrl        String?
  placementNotes String?
  expiresAt      DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  license  ProviderLicense? @relation(fields: [licenseId], references: [id])

  @@index([providerId])
}

// Provenance for a License's rights determination (spec section 18) - only
// metadata/URL/short internal summary, never full copyrighted terms text.
model ProviderPolicyEvidence {
  id          String                           @id @default(cuid())
  licenseId   String
  title       String
  sourceUrl   String
  accessedAt  DateTime
  sourceType  ProviderPolicyEvidenceSourceType
  notes       String?
  createdById String?
  createdAt   DateTime                         @default(now())

  license ProviderLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
}

// =========================================================================
// HISTORICAL KNOWLEDGE GRAPH  (Phase 03)
// =========================================================================

model Place {
  id                   String                                   @id @default(cuid())
  canonicalSlug        String                                   @unique
  type                 PlaceType
  parentPlaceId        String?
  location             Unsupported("geometry(Point, 4326)")?
  geometry             Unsupported("geometry(Geometry, 4326)")?
  // Untouched by G03 - Phase 03's documented free-text gap, never bulk-
  // converted/reinterpreted (spec section 12). currentCountryId/RegionId/
  // CityId below are new, optional, additive - populated only where an
  // explicit, safe mapping exists.
  currentAdminRegion   String?
  // G03: current (modern-day) geography context - direct nullable FKs, not
  // a join table, because a physical Place has at most one current
  // country/region/city (unlike Event/Era below, which genuinely need
  // many-to-many). Mirrors the exact shape G01's Destination already uses
  // (countryId/regionId/cityId), for consistency. This is operational/
  // editorial metadata, not a HistoricalFact claim (spec section 56/57) -
  // no citation is required to say "this place is currently in Kyoto."
  currentCountryId     String?
  currentRegionId      String?
  currentCityId        String?
  historicalImportance Int                                      @default(0)
  heroMediaId          String?
  unescoStatus         String?
  unescoInscribedYear  Int?
  publicationStatus    PublicationStatus                        @default(DRAFT)
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt

  parentPlace    Place?      @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id])
  childPlaces    Place[]     @relation("PlaceHierarchy")
  heroMedia      MediaAsset? @relation("PlaceHeroMedia", fields: [heroMediaId], references: [id])
  currentCountry Country?    @relation(fields: [currentCountryId], references: [id])
  currentRegion  Region?     @relation(fields: [currentRegionId], references: [id])
  currentCity    City?       @relation(fields: [currentCityId], references: [id])

  translations       PlaceTranslation[]
  visits             PlaceVisit[]
  factLinks          FactPlace[]
  eventLinks         EventPlace[]
  storyLinks         StoryPlace[]
  journeyStops       JourneyStop[]
  communityLinks     CommunityStoryPlace[]
  contributions      Contribution[]
  thenNowComparisons ThenNowComparison[]
  // G03: back-relation for PersonPlace (see Person.placeLinks doc comment).
  personLinks        PersonPlace[]
  // G04: back-relation for DestinationPlace (see Destination.placeLinks doc comment).
  destinationLinks   DestinationPlace[]
  // G05: back-relation for Attraction.placeId (see Attraction doc comment) -
  // optional typed mapping when a historical Place is also a visitor
  // attraction, never a merge.
  attractions        Attraction[]
  // G06 (Trip Planner + Cost Engine) - back-relation for TripItem.placeId
  // (a PLACE-type itinerary item, e.g. a historical site with no G05
  // Attraction/Activity entry of its own yet - spec section 73).
  tripItems          TripItem[]

  @@index([type])
  @@index([parentPlaceId])
  @@index([currentCountryId])
  @@index([currentRegionId])
  @@index([currentCityId])
}

model PlaceTranslation {
  id             String            @id @default(cuid())
  placeId        String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, locale])
  @@unique([locale, slug])
}

model Person {
  id            String @id @default(cuid())
  canonicalSlug String @unique

  // Historical date model (docs/backend/HISTORICAL_DOMAIN.md) - year/month/day
  // hold only what is actually known; birth*SortStart/End are internal
  // ordering aids only, never returned as "the" date over the API.
  birthYear            Int?
  birthMonth           Int?
  birthDay             Int?
  birthPrecision       DatePrecision @default(UNKNOWN)
  birthQualifier       DateQualifier @default(UNCERTAIN)
  // G03: which epoch `birthYear` (and, for a BETWEEN range, birthEndYear)
  // falls in - defaults CE so every existing row's meaning is unchanged.
  birthEra             DateEra       @default(CE)
  birthEndYear         Int?
  birthEndMonth        Int?
  birthEndDay          Int?
  birthLabel           String?
  birthSortStart       DateTime?
  birthSortEnd         DateTime?
  birthChronologyStart Int?
  birthChronologyEnd   Int?

  deathYear            Int?
  deathMonth           Int?
  deathDay             Int?
  deathPrecision       DatePrecision @default(UNKNOWN)
  deathQualifier       DateQualifier @default(UNCERTAIN)
  deathEra             DateEra       @default(CE)
  deathEndYear         Int?
  deathEndMonth        Int?
  deathEndDay          Int?
  deathLabel           String?
  deathSortStart       DateTime?
  deathSortEnd         DateTime?
  deathChronologyStart Int?
  deathChronologyEnd   Int?

  heroMediaId          String?
  historicalImportance Int               @default(0)
  publicationStatus    PublicationStatus @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  heroMedia MediaAsset? @relation("PersonHeroMedia", fields: [heroMediaId], references: [id])

  translations   PersonTranslation[]
  dynastyLinks   PersonDynasty[]
  factLinks      FactPerson[]
  eventLinks     EventPerson[]
  storyLinks     StoryPerson[]
  communityLinks CommunityStoryPerson[]
  // G03: explicit, editor-asserted association with a Place in a given role
  // (birth/death/residence/etc) - see PersonPlaceRole doc comment. Not a
  // nationality field.
  placeLinks     PersonPlace[]
}

model PersonTranslation {
  id             String            @id @default(cuid())
  personId       String
  locale         String
  displayName    String
  slug           String
  alternateNames String?
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, locale])
  @@unique([locale, slug])
}

model HistoricalEvent {
  id                  String            @id @default(cuid())
  canonicalSlug       String            @unique
  eraId               String?
  territoryId         String?
  dateYear            Int?
  dateMonth           Int?
  dateDay             Int?
  datePrecision       DatePrecision     @default(UNKNOWN)
  dateQualifier       DateQualifier     @default(UNCERTAIN)
  dateEra             DateEra           @default(CE)
  dateEndYear         Int?
  dateEndMonth        Int?
  dateEndDay          Int?
  dateLabel           String?
  // Legacy internal ordering aid (pre-G03) - CE-safe only (Date.UTC's
  // legacy two-digit-year behavior corrupts astronomical years 0-99, i.e.
  // CE 1-99 and BCE 1). Preserved unchanged for any existing consumer that
  // reads it directly; no longer authoritative for ordering/range-filtering
  // as of G03 - see dateChronologyStart/End below.
  dateSortStart       DateTime?
  dateSortEnd         DateTime?
  // G03 authoritative chronology ordinals (docs/backend/HISTORICAL_DATE_V2.md)
  // - pure-integer, proleptic, BCE/CE-correct, no Date/DateTime involved.
  // This is what ordering and range-overlap queries must use going forward.
  dateChronologyStart Int?
  dateChronologyEnd   Int?
  importance          Int               @default(0)
  heroMediaId         String?
  publicationStatus   PublicationStatus @default(DRAFT)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  era       HistoricalEra? @relation(fields: [eraId], references: [id])
  territory Territory?     @relation(fields: [territoryId], references: [id])
  heroMedia MediaAsset?    @relation("EventHeroMedia", fields: [heroMediaId], references: [id])

  translations     HistoricalEventTranslation[]
  placeLinks       EventPlace[]
  personLinks      EventPerson[]
  factLinks        FactEvent[]
  storyLinks       StoryEvent[]
  communityLinks   CommunityStoryEvent[]
  themeLinks       EventTheme[]
  journeyStops     JourneyStop[]                @relation("JourneyStopEvent")
  // G03: an event may span multiple modern countries (spec section 15/16) -
  // a real many-to-many join, unlike Place's single current-country FKs
  // below, since plurality is a genuine requirement here.
  countryLinks     EventCountry[]
  // G04: back-relation for DestinationEvent (curated "how X became X" turning points).
  destinationLinks DestinationEvent[]

  @@index([eraId])
  @@index([territoryId])
  @@index([dateSortStart])
  @@index([dateChronologyStart])
}

model HistoricalEventTranslation {
  id             String            @id @default(cuid())
  eventId        String
  locale         String
  title          String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@unique([locale, slug])
}

model HistoricalEra {
  id            String  @id @default(cuid())
  canonicalSlug String  @unique
  parentEraId   String?

  // Period date model: start/end are each independently qualified (an era
  // can start "circa" and end on an exact year). No end recorded (both
  // endYear and endPrecision null) means "still ongoing", distinct from an
  // explicitly UNKNOWN end. sortStart/sortEnd are internal ordering aids.
  startYear       Int?
  startMonth      Int?
  startDay        Int?
  startPrecision  DatePrecision  @default(UNKNOWN)
  startQualifier  DateQualifier  @default(UNCERTAIN)
  startEra        DateEra        @default(CE)
  endYear         Int?
  endMonth        Int?
  endDay          Int?
  endPrecision    DatePrecision?
  endQualifier    DateQualifier?
  // G03: nullable, no default - mirrors endPrecision/endQualifier's own
  // "no end recorded" convention rather than forcing a CE default on a
  // column that may legitimately be absent.
  endEra          DateEra?
  dateLabel       String?
  // Legacy internal ordering aid (pre-G03) - see HistoricalEvent.dateSortStart
  // doc comment for why this is no longer authoritative.
  sortStart       DateTime?
  sortEnd         DateTime?
  // G03 authoritative chronology ordinals - see HistoricalEvent.dateChronologyStart.
  chronologyStart Int?
  chronologyEnd   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentEra HistoricalEra?  @relation("EraHierarchy", fields: [parentEraId], references: [id])
  childEras HistoricalEra[] @relation("EraHierarchy")

  translations   HistoricalEraTranslation[]
  events         HistoricalEvent[]
  factLinks      FactEra[]
  communityLinks CommunityStoryEra[]
  // G03: an era may span multiple modern countries (spec section 17/18) -
  // e.g. a broad cultural/period era is not owned by one country. This is a
  // geographic-applicability/scope relation only - it never implies
  // ownership, nationality, or exclusive territorial control.
  countryLinks   EraCountry[]

  @@index([sortStart])
  @@index([chronologyStart])
}

model HistoricalEraTranslation {
  id          String            @id @default(cuid())
  eraId       String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  era HistoricalEra @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([eraId, locale])
  @@unique([locale, slug])
}

model Dynasty {
  id             String  @id @default(cuid())
  canonicalSlug  String  @unique
  capitalPlaceId String?

  // Period date model - see HistoricalEra for the field-by-field contract
  // (G03 added startEra/endEra there and here identically, for consistency
  // across every period-dated model - Dynasty is not itself part of the
  // Japan fixture in G03, but leaving it BCE-incapable while Era/Territory
  // gain it would be an arbitrary, undocumented inconsistency).
  startYear       Int?
  startMonth      Int?
  startDay        Int?
  startPrecision  DatePrecision  @default(UNKNOWN)
  startQualifier  DateQualifier  @default(UNCERTAIN)
  startEra        DateEra        @default(CE)
  endYear         Int?
  endMonth        Int?
  endDay          Int?
  endPrecision    DatePrecision?
  endQualifier    DateQualifier?
  endEra          DateEra?
  dateLabel       String?
  sortStart       DateTime?
  sortEnd         DateTime?
  chronologyStart Int?
  chronologyEnd   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations DynastyTranslation[]
  personLinks  PersonDynasty[]

  @@index([sortStart])
  @@index([chronologyStart])
}

model DynastyTranslation {
  id          String            @id @default(cuid())
  dynastyId   String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  dynasty Dynasty @relation(fields: [dynastyId], references: [id], onDelete: Cascade)

  @@unique([dynastyId, locale])
  @@unique([locale, slug])
}

model Territory {
  id            String                                   @id @default(cuid())
  canonicalSlug String                                   @unique
  type          TerritoryType
  geometry      Unsupported("geometry(Geometry, 4326)")?

  // Period date model (historical validity window) - see HistoricalEra for
  // the field-by-field contract. chronologyStart/End (below) are what
  // MapService's year-scoped bbox query filters on (EPSG:4326, see
  // docs/backend/HISTORICAL_DOMAIN.md) - switched from the legacy
  // sortStart/sortEnd in G03's 3rd architecture review, because a KNOWN BCE
  // Territory's legacy fields are intentionally NULL (never a fabricated
  // CE-era timestamp) and NULL there would have read as "unknown - always
  // match" for an arbitrary CE year query, incorrectly surfacing it.
  // MapService's `year` query param remains CE-only by contract (unchanged,
  // no G03 gate requires BCE map support - that stays G11 scope); a known
  // BCE Territory simply never matches a CE year query, same as a
  // chronologically-distant CE one wouldn't.
  startYear       Int?
  startMonth      Int?
  startDay        Int?
  startPrecision  DatePrecision  @default(UNKNOWN)
  startQualifier  DateQualifier  @default(UNCERTAIN)
  startEra        DateEra        @default(CE)
  endYear         Int?
  endMonth        Int?
  endDay          Int?
  endPrecision    DatePrecision?
  endQualifier    DateQualifier?
  endEra          DateEra?
  dateLabel       String?
  sortStart       DateTime?
  sortEnd         DateTime?
  chronologyStart Int?
  chronologyEnd   Int?

  // Geometry provenance (section 17): interpretive historical polygons must
  // never be silently overwritten - provenanceNote + geometryVersion give a
  // minimal audit trail; TerritoryGeometryRevision (below) keeps prior
  // versions instead of discarding them.
  provenanceNote       String?
  geometryVersion      Int               @default(1)
  geometryReviewedById String?
  geometryReviewedAt   DateTime?
  geometryStatus       PublicationStatus @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  translations    TerritoryTranslation[]
  events          HistoricalEvent[]
  factLinks       FactTerritory[]
  geometryHistory TerritoryGeometryRevision[]

  @@index([sortStart])
  @@index([chronologyStart])
}

// Historical boundary polygons are interpretive and revisable - a new
// version is appended here (never overwritten in place) before the live
// `geometry` column is updated, so disputed/superseded shapes stay
// reconstructable (spec section 17).
model TerritoryGeometryRevision {
  id          String                                   @id @default(cuid())
  territoryId String
  version     Int
  geometry    Unsupported("geometry(Geometry, 4326)")?
  sourceNote  String?
  createdById String?
  createdAt   DateTime                                 @default(now())

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([territoryId, version])
}

model TerritoryTranslation {
  id          String            @id @default(cuid())
  territoryId String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([territoryId, locale])
  @@unique([locale, slug])
}

// --- high-integrity join tables: knowledge graph ---

model EventPlace {
  id      String  @id @default(cuid())
  eventId String
  placeId String
  role    String?

  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([eventId, placeId])
}

model EventPerson {
  id       String  @id @default(cuid())
  eventId  String
  personId String
  role     String?

  event  HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person          @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
}

model PersonDynasty {
  id        String  @id @default(cuid())
  personId  String
  dynastyId String
  role      String?

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  dynasty Dynasty @relation(fields: [dynastyId], references: [id], onDelete: Cascade)

  @@unique([personId, dynastyId])
}

// G03 (Global Backend V2 Extension, Global Historical Knowledge Extension) -
// modern-geography scope for a HistoricalEvent that spans one or more
// countries (spec section 15/16). Deliberately a real many-to-many join,
// unlike Place's single current-country FKs above - plurality is a genuine
// requirement here (a war, a trade route, a diplomatic event is not owned
// by one country). `role` is an explicit EventCountryRole (not the generic
// String? used by EventPlace/EventPerson.role) because leaving a country
// link's historical meaning undefined here is exactly the kind of ambiguity
// a "did this actually happen in this country" claim cannot tolerate;
// @@default(RELATED) keeps every row's semantics unambiguous even when an
// editor doesn't specify a more precise role.
model EventCountry {
  id        String           @id @default(cuid())
  eventId   String
  countryId String
  role      EventCountryRole @default(RELATED)

  event   HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  country Country         @relation(fields: [countryId], references: [id])

  @@unique([eventId, countryId])
  @@index([countryId])
}

// G03 - modern-geography scope for a HistoricalEra that spans one or more
// countries (spec section 17/18 - e.g. a broad cultural/period era like the
// Renaissance is not owned by one country). Real many-to-many, same
// plurality rationale as EventCountry above, but deliberately NOT given a
// role field: an era's country links are always geographic
// applicability/scope only, never ownership, nationality, or exclusive
// territorial control - there is no second meaning to disambiguate here.
model EraCountry {
  id        String @id @default(cuid())
  eraId     String
  countryId String

  era     HistoricalEra @relation(fields: [eraId], references: [id], onDelete: Cascade)
  country Country       @relation(fields: [countryId], references: [id])

  @@unique([eraId, countryId])
  @@index([countryId])
}

// G03 - minimal Person<->Place association (see PersonPlaceRole doc comment).
// No pre-existing Person<->Place relation existed before this (Person only
// reached Place indirectly, via EventPerson+EventPlace on a shared Event) -
// this is a new, direct, deliberately small join table, not an extension of
// an existing one. onDelete: Cascade on both sides mirrors the existing
// EventPlace/EventPerson/PersonDynasty convention for this kind of link.
model PersonPlace {
  id       String          @id @default(cuid())
  personId String
  placeId  String
  role     PersonPlaceRole @default(OTHER)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  place  Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([personId, placeId, role])
  @@index([placeId])
}

// Event classification catalog (spec section 11) - see the ThemeCategory
// comment above. `slug` is stable/locale-agnostic (used for filter query
// params); display name is localized via ThemeTranslation.
model Theme {
  id        String        @id @default(cuid())
  slug      String        @unique
  category  ThemeCategory
  createdAt DateTime      @default(now())

  translations     ThemeTranslation[]
  eventLinks       EventTheme[]
  // G04: back-relation for DestinationTheme (see Destination.themeLinks doc comment).
  destinationLinks DestinationTheme[]

  @@index([category])
}

model ThemeTranslation {
  id      String @id @default(cuid())
  themeId String
  locale  String
  name    String

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, locale])
}

model EventTheme {
  id      String @id @default(cuid())
  eventId String
  themeId String

  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  theme Theme           @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([eventId, themeId])
}

// =========================================================================
// TRUST LAYER  (Phase 04)
// =========================================================================

model HistoricalFact {
  id                  String              @id @default(cuid())
  factType            FactType
  dateYear            Int?
  dateMonth           Int?
  dateDay             Int?
  datePrecision       DatePrecision       @default(UNKNOWN)
  dateQualifier       DateQualifier       @default(UNCERTAIN)
  dateEra             DateEra             @default(CE)
  dateEndYear         Int?
  dateEndMonth        Int?
  dateEndDay          Int?
  dateLabel           String?
  dateSortStart       DateTime?
  dateSortEnd         DateTime?
  dateChronologyStart Int?
  dateChronologyEnd   Int?
  certainty           FactCertainty       @default(UNCERTAIN)
  sensitivity         FactSensitivity     @default(NORMAL)
  editorialStatus     FactEditorialStatus @default(DRAFT)
  createdById         String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  translations   HistoricalFactTranslation[]
  citations      Citation[]
  placeLinks     FactPlace[]
  personLinks    FactPerson[]
  eventLinks     FactEvent[]
  eraLinks       FactEra[]
  territoryLinks FactTerritory[]
  revisions      Revision[]
  reviews        FactReview[]
  storyLinks     StoryFact[]

  @@index([editorialStatus])
  @@index([sensitivity])
}

// Per-stage review history (spec section 21) - deliberately not just a
// `reviewedById`/`reviewedAt` pair on HistoricalFact, which would lose every
// review but the most recent one. One row per review decision, append-only
// from the API's point of view (no update/delete endpoint).
model FactReview {
  id         String              @id @default(cuid())
  factId     String
  reviewerId String
  // The editorial stage this decision applies to (e.g. a FACT_REVIEW row
  // records a historian's fact-check; a PUBLISHED row records the final
  // publish approval; a RETRACTED row records a retraction and its reason).
  stage      FactEditorialStatus
  decision   ReviewDecision
  notes      String?
  createdAt  DateTime            @default(now())

  fact     HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  reviewer User           @relation(fields: [reviewerId], references: [id])

  @@index([factId])
  @@index([reviewerId])
}

model HistoricalFactTranslation {
  id        String            @id @default(cuid())
  factId    String
  locale    String
  statement String
  status    TranslationStatus @default(DRAFT)
  method    TranslationMethod @default(ORIGINAL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  fact HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([factId, locale])
}

model FactPlace {
  id      String @id @default(cuid())
  factId  String
  placeId String

  fact  HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  place Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([factId, placeId])
}

model FactPerson {
  id       String @id @default(cuid())
  factId   String
  personId String

  fact   HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  person Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([factId, personId])
}

model FactEvent {
  id      String @id @default(cuid())
  factId  String
  eventId String

  fact  HistoricalFact  @relation(fields: [factId], references: [id], onDelete: Cascade)
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([factId, eventId])
}

model FactEra {
  id     String @id @default(cuid())
  factId String
  eraId  String

  fact HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  era  HistoricalEra  @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([factId, eraId])
}

model FactTerritory {
  id          String @id @default(cuid())
  factId      String
  territoryId String

  fact      HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  territory Territory      @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([factId, territoryId])
}

model Source {
  id               String            @id @default(cuid())
  sourceType       SourceType
  title            String
  author           String?
  organization     String?
  publisher        String?
  publicationYear  Int?
  isbn             String?
  issn             String?
  edition          String?
  volume           String?
  archiveName      String?
  archiveCode      String?
  originalLanguage String?
  url              String?
  accessedAt       DateTime?
  credibilityLevel SourceCredibility @default(UNKNOWN)
  notes            String?
  createdById      String?
  // Archive/deactivate, never hard-delete a Source once it can be cited
  // (spec section 35). A non-null archivedAt means the source is no longer
  // offered for new citations; existing Citations/history are untouched.
  archivedAt       DateTime?
  archivedById     String?
  archiveReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  translations                 SourceTranslation[]
  citations                    Citation[]
  sourceDocuments              SourceDocument[]
  mediaAssets                  MediaAsset[]
  contributionCatalogueResults ContributionCatalogueResult[]

  @@index([sourceType])
  @@index([archivedAt])
}

// optional localized display title only - original bibliographic identity is
// never overwritten (see spec section 21).
model SourceTranslation {
  id           String   @id @default(cuid())
  sourceId     String
  locale       String
  displayTitle String
  createdAt    DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, locale])
}

model Citation {
  id                String                    @id @default(cuid())
  factId            String
  sourceId          String
  pageFrom          String?
  pageTo            String?
  volume            String?
  chapter           String?
  excerpt           String?
  editorNote        String?
  verificationState CitationVerificationState @default(UNVERIFIED)
  verifiedById      String?
  verifiedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  fact   HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  source Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  storyLinks StoryCitation[]

  @@index([factId])
  @@index([sourceId])
}

model SourceDocument {
  id              String            @id @default(cuid())
  sourceId        String
  mediaAssetId    String
  pageCount       Int?
  // OCR output (spec section 23) - extraction assistance only. Never treated
  // as reviewed historical text; a Citation quoting this document still goes
  // through the normal fact/citation trust path regardless of ocrStatus.
  extractedText   String?
  ocrStatus       DocumentOcrStatus @default(NOT_REQUESTED)
  ocrConfidence   Float?
  ocrReviewedById String?
  ocrReviewedAt   DateTime?
  usageRights     String?
  rightsHolder    String?
  accessPolicy    AccessPolicy      @default(METADATA_ONLY)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  source                       Source                        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mediaAsset                   MediaAsset                    @relation(fields: [mediaAssetId], references: [id])
  contributionCatalogueResults ContributionCatalogueResult[]

  @@index([sourceId])
}

// generic revision snapshot store for high-value editorial entities (section 37)
model Revision {
  id          String     @id @default(cuid())
  entityType  EntityKind
  entityId    String
  snapshot    Json
  changeNote  String?
  changedById String?
  factId      String?
  storyId     String?
  journeyId   String?
  createdAt   DateTime   @default(now())

  changedBy User?           @relation(fields: [changedById], references: [id])
  fact      HistoricalFact? @relation(fields: [factId], references: [id])
  story     Story?          @relation(fields: [storyId], references: [id])
  journey   Journey?        @relation(fields: [journeyId], references: [id])

  @@index([entityType, entityId])
}

// append-only, never editable through normal editorial APIs (section 38)
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     String
  entityType EntityKind?
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([action])
}

// =========================================================================
// EDITORIAL CONTENT  (Phase 06)
// =========================================================================

model Story {
  id               String               @id @default(cuid())
  canonicalSlug    String               @unique
  type             StoryType            @default(EDITORIAL)
  heroMediaId      String?
  authorId         String?
  // Public-facing attribution, distinct from `authorId` (an internal User
  // pointer that is never publicly exposed - spec section 47/48). May be a
  // team byline ("Ban bien tap Dau Viet") rather than a named individual.
  byline           String?
  featured         Boolean              @default(false)
  priority         Int                  @default(0)
  editorialStatus  StoryEditorialStatus @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  lastReviewedById String?
  lastReviewedAt   DateTime?
  // Optimistic concurrency (spec section 60) - every update/transition must
  // supply the version it read; a stale write is rejected rather than
  // silently overwriting a concurrent editor's change.
  version          Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  heroMedia MediaAsset? @relation("StoryHeroMedia", fields: [heroMediaId], references: [id])

  translations     StoryTranslation[]
  placeLinks       StoryPlace[]
  personLinks      StoryPerson[]
  eventLinks       StoryEvent[]
  factLinks        StoryFact[]
  citationLinks    StoryCitation[]
  revisions        Revision[]
  journeyStops     JourneyStop[]      @relation("JourneyStopStory")
  // G04: back-relation for DestinationStory (see Destination.storyLinks doc comment).
  destinationLinks DestinationStory[]

  @@index([editorialStatus])
  @@index([featured, priority])
}

model StoryTranslation {
  id             String            @id @default(cuid())
  storyId        String
  locale         String
  title          String
  slug           String
  // Optional subtitle/deck line (spec section 4) - distinct from `summary`
  // (a longer plain-text teaser used in list views/SEO fallback).
  subtitle       String?
  summary        String?
  // Structured block-array body (spec section 6/7), stored as Json rather
  // than raw HTML - see StoryBody in story-body.util.ts for the validated
  // block schema. Never rendered as trusted HTML server-side.
  content        Json?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, locale])
  @@unique([locale, slug])
}

model StoryPlace {
  id      String        @id @default(cuid())
  storyId String
  placeId String
  role    StoryLinkRole @default(RELATED)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([storyId, placeId])
}

model StoryPerson {
  id       String        @id @default(cuid())
  storyId  String
  personId String
  role     StoryLinkRole @default(RELATED)

  story  Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([storyId, personId])
}

model StoryEvent {
  id      String        @id @default(cuid())
  storyId String
  eventId String
  role    StoryLinkRole @default(RELATED)

  story Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([storyId, eventId])
}

// Explicit editorial-provenance layer (spec section 10) - which verified
// HistoricalFact rows this Story's narrative is built on. Never duplicates
// the fact's statement text; just the relation. A Story is not required to
// back every sentence with a Fact, but any fact it does cite as support
// must be PUBLISHED to satisfy the publication validator (see
// StoriesService.validateForPublication) - a DRAFT/unverified Fact can
// never be laundered into "supported by verified history" via a Story.
model StoryFact {
  id      String @id @default(cuid())
  storyId String
  factId  String

  story Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fact  HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([storyId, factId])
}

model StoryCitation {
  id         String  @id @default(cuid())
  storyId    String
  citationId String
  // Locator/context for this editorial citation (spec section 11/12) -
  // distinct from HistoricalFact<->Citation, which remains the only path
  // for citing factual support. This is for broader interpretation/
  // quotation context a Story adds on top of verified facts.
  locator    String?
  quoteNote  String?

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([storyId, citationId])
}

model Journey {
  id                  String                                     @id @default(cuid())
  canonicalSlug       String                                     @unique
  heroMediaId         String?
  durationMinutes     Int?
  distanceMeters      Int?
  difficulty          String?
  region              String?
  routeGeometry       Unsupported("geometry(LineString, 4326)")?
  // Provenance of routeGeometry when present (spec section 30) - never
  // presented as a real road route unless it actually is one.
  routeGeometrySource String?
  editorialStatus     PublicationStatus                          @default(DRAFT)
  scheduledAt         DateTime?
  publishedAt         DateTime?
  archivedAt          DateTime?
  version             Int                                        @default(0)
  createdAt           DateTime                                   @default(now())
  updatedAt           DateTime                                   @updatedAt

  heroMedia MediaAsset? @relation("JourneyHeroMedia", fields: [heroMediaId], references: [id])

  translations     JourneyTranslation[]
  stops            JourneyStop[]
  revisions        Revision[]
  // G04: back-relation for DestinationJourney (see Destination.journeyLinks doc comment).
  destinationLinks DestinationJourney[]

  @@index([editorialStatus])
}

model JourneyTranslation {
  id             String            @id @default(cuid())
  journeyId      String
  locale         String
  title          String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, locale])
  @@unique([locale, slug])
}

model JourneyStop {
  id                         String  @id @default(cuid())
  journeyId                  String
  placeId                    String
  order                      Int
  // Optional override of the Place's own display name for this stop's
  // context (spec section 26) - e.g. referring to one wing/gate of a larger
  // site. Free-text, uploader/editor locale only (spec section 28 - no
  // JourneyStopTranslation was added; see docs/backend/EDITORIAL_CONTENT.md
  // for the reasoning).
  stopTitle                  String?
  recommendedDurationMinutes Int?
  notes                      String?
  // Optional links to why this stop matters historically (spec section 31) -
  // never a place to restate a factual claim; the claim itself still lives
  // on a HistoricalFact/Story, this is just a pointer.
  storyId                    String?
  eventId                    String?

  journey Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  place   Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  story   Story?           @relation("JourneyStopStory", fields: [storyId], references: [id])
  event   HistoricalEvent? @relation("JourneyStopEvent", fields: [eventId], references: [id])

  @@unique([journeyId, placeId])
  @@unique([journeyId, order])
}

// Lightweight home/editorial curation (spec section 35-37) - deliberately
// not a general CMS layout builder. One row = one piece of content in one
// named slot at one position; the public `GET /v1/editorial/home` endpoint
// groups by slotKey and resolves each entity through its own normal
// publication-status filtering, so a stale slot pointing at an since-
// unpublished entity never leaks a draft.
model EditorialSlot {
  id          String     @id @default(cuid())
  slotKey     String
  order       Int        @default(0)
  entityKind  EntityKind
  entityId    String
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([slotKey, order])
  @@index([slotKey])
}

// =========================================================================
// COMMUNITY  (Phase 08)
// =========================================================================

model CommunityStory {
  id                  String                     @id @default(cuid())
  canonicalSlug       String                     @unique
  type                CommunityStoryType
  authorId            String
  heroMediaId         String?
  // The locale the author actually wrote in (spec Phase 08 section 5) - never
  // silently overwritten by a later translation. Defaults to the locale of
  // the first translation supplied at creation.
  originalLocale      String                     @default("vi")
  verificationState   CommunityVerificationState @default(PERSONAL_MEMORY)
  moderationStatus    ModerationStatus           @default(VISIBLE)
  // Simplified point date (no qualifier/BETWEEN-range needed for a personal
  // memory) - still never fabricates a month/day for a year-only memory.
  eventDateYear       Int?
  eventDateMonth      Int?
  eventDateDay        Int?
  eventDatePrecision  DatePrecision              @default(UNKNOWN)
  eventDateLabel      String?
  // Denormalized "helpful" tally (spec section 63/64) - the `StoryVote`
  // unique constraint is the source of truth; this column exists only so the
  // HELPFUL feed sort and profile "helpful received" total don't require a
  // full-table aggregate on every read. Updated transactionally alongside
  // every StoryVote create/delete, never trusted from client input.
  helpfulCount        Int                        @default(0)
  // Set only when type = THEN_AND_NOW (spec section 18) - links to the
  // existing Phase 05 ThenNowComparison rather than duplicating the
  // before/after media model.
  thenNowComparisonId String?                    @unique
  editedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  author            User               @relation(fields: [authorId], references: [id])
  heroMedia         MediaAsset?        @relation("CommunityStoryHeroMedia", fields: [heroMediaId], references: [id])
  thenNowComparison ThenNowComparison? @relation(fields: [thenNowComparisonId], references: [id])

  translations CommunityStoryTranslation[]
  placeLinks   CommunityStoryPlace[]
  personLinks  CommunityStoryPerson[]
  eventLinks   CommunityStoryEvent[]
  eraLinks     CommunityStoryEra[]
  votes        StoryVote[]

  @@index([authorId])
  @@index([moderationStatus])
}

// Single positive "helpful" signal (spec section 22) - deliberately not a
// +1/-1 palette like CommentVote; existence of a row IS the helpful vote, so
// "un-helpful-ing" is a delete, not a value flip.
model StoryVote {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model CommunityStoryTranslation {
  id        String            @id @default(cuid())
  storyId   String
  locale    String
  title     String
  slug      String
  content   String?
  status    TranslationStatus @default(DRAFT)
  method    TranslationMethod @default(ORIGINAL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, locale])
  @@unique([locale, slug])
}

model CommunityStoryPlace {
  id      String @id @default(cuid())
  storyId String
  placeId String

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  place Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([storyId, placeId])
}

model CommunityStoryPerson {
  id       String @id @default(cuid())
  storyId  String
  personId String

  story  CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([storyId, personId])
}

model CommunityStoryEvent {
  id      String @id @default(cuid())
  storyId String
  eventId String

  story CommunityStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([storyId, eventId])
}

model CommunityStoryEra {
  id      String @id @default(cuid())
  storyId String
  eraId   String

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  era   HistoricalEra  @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([storyId, eraId])
}

// "Xua & Nay" (Then & Now) - a before/after image pair anchored to a Place
// (spec section 27). Can originate from an editor OR a community member;
// `publicationStatus` is the editorial-promotion gate (same DRAFT/PUBLISHED
// meaning as every other entity - see HISTORICAL_DOMAIN.md section 7) and
// `moderationStatus` is the same community-visibility gate CommunityStory
// uses, so a community-submitted pair can be hidden without deleting it.
// A community pair being VISIBLE/moderated is not the same as it being
// editorially PUBLISHED - identical distinction to CommunityStory vs Story.
model ThenNowComparison {
  id                String            @id @default(cuid())
  placeId           String
  beforeMediaId     String
  afterMediaId      String
  historicalPeriod  String?
  viewpointNote     String?
  publicationStatus PublicationStatus @default(DRAFT)
  moderationStatus  ModerationStatus  @default(VISIBLE)
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  place       Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  beforeMedia MediaAsset @relation("ThenNowBefore", fields: [beforeMediaId], references: [id])
  afterMedia  MediaAsset @relation("ThenNowAfter", fields: [afterMediaId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])

  translations   ThenNowComparisonTranslation[]
  communityStory CommunityStory?

  @@index([placeId])
}

model ThenNowComparisonTranslation {
  id           String            @id @default(cuid())
  comparisonId String
  locale       String
  description  String?
  status       TranslationStatus @default(DRAFT)
  method       TranslationMethod @default(ORIGINAL)
  createdAt    DateTime          @default(now())

  comparison ThenNowComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, locale])
}

model Comment {
  id         String           @id @default(cuid())
  targetType EntityKind
  targetId   String
  authorId   String
  parentId   String?
  body       String
  status     ModerationStatus @default(VISIBLE)
  score      Int              @default(0)
  // 0 for a top-level comment, parent.depth+1 for a reply (spec Phase 08
  // section 31) - a stored counter rather than walking `parentId` ancestry on
  // every write, so `CommentsService.create` can reject a reply past
  // MAX_DEPTH with one read instead of a recursive query.
  depth      Int              @default(0)
  editedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  author  User          @relation(fields: [authorId], references: [id])
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]     @relation("CommentReplies")
  votes   CommentVote[]

  @@index([targetType, targetId])
  @@index([parentId])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Bookmark {
  id         String     @id @default(cuid())
  userId     String
  targetType EntityKind
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

model Report {
  id             String         @id @default(cuid())
  reporterId     String
  targetType     EntityKind
  targetId       String
  category       ReportCategory
  status         ReportStatus   @default(OPEN)
  notes          String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime       @default(now())

  reporter User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  resolver User? @relation("ReportsResolved", fields: [resolvedById], references: [id])

  @@index([targetType, targetId])
  @@index([status])
}

model PlaceVisit {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  visitedAt DateTime @default(now())
  note      String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placeId])
}

// Tasteful, rule/editorial-based recognition (spec Phase 08 section 28) -
// deliberately not an XP/level/streak system. Grantable only via an
// ADMIN-gated endpoint (`UsersService.grantBadge`); no code path lets a user
// award their own badge.
enum BadgeType {
  MEMORY_KEEPER // "Nguoi gin giu ky uc"
  EXPLORER // "Nguoi kham pha"
  ARCHIVIST // "Nguoi luu giu"
  STORYTELLER // "Nguoi ke chuyen"
  RESEARCHER // "Nguoi nghien cuu"
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  type        BadgeType
  grantedById String?
  reason      String?
  createdAt   DateTime  @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("BadgesGranted", fields: [grantedById], references: [id])

  @@unique([userId, type])
}

// =========================================================================
// CONTRIBUTIONS  (Phase 09)
// =========================================================================

model Contribution {
  id                   String                        @id @default(cuid())
  contributorId        String
  type                 ContributionType              @default(OTHER)
  status               ContributionStatus            @default(SUBMITTED)
  title                String
  description          String?
  originSource         String?
  currentOwner         String?
  sharingRights        String?
  approxDateLabel      String?
  approxDateStart      DateTime?
  approxDateEnd        DateTime?
  peopleShown          String[]                      @default([])
  placeId              String?
  contextNote          String?
  // Original submission language, preserved verbatim (spec section 7) - AI-
  // assisted translation is a separate, disclosed concern layered on later,
  // never applied silently here.
  originalLocale       String                        @default("vi")
  // Contextual-only entity tag beyond `placeId` (spec section 8) - e.g. a
  // Person/HistoricalEvent/HistoricalEra/Territory this material relates
  // to. Plain polymorphic scalar pair, same convention as Comment/Bookmark/
  // Report (`targetType`/`targetId`) rather than four separate nullable
  // FKs - linking never implies verification of the material itself.
  linkedEntityType     EntityKind?
  linkedEntityId       String?
  // CORRECTION contributions point at the canonical record they propose to
  // fix (spec section 20) - validated against a closed allow-list and
  // existence-checked in ContributionsService (never a trusted arbitrary
  // targetType/targetId).
  correctionTargetType EntityKind?
  correctionTargetId   String?
  // Submitter's own rights claim (spec section 13) - a claim, never an
  // adjudicated rights state. Kept structurally separate from
  // `rightsReviewState` below, which only a reviewer can set.
  submitterDeclaration SubmitterRightsDeclaration?
  attribution          ContributionAttribution?
  // Reviewer-only assessments (spec sections 11/12) - never derived from,
  // or overwritten by, any submitter-supplied field above.
  provenanceConfidence ProvenanceConfidence          @default(UNASSESSED)
  rightsReviewState    ContributionRightsReviewState @default(UNREVIEWED)
  // Workflow-control sensitivity, the same enum/semantics as
  // HistoricalFact.sensitivity (spec section 40) - never a special-cased
  // place/topic check.
  sensitivity          FactSensitivity               @default(NORMAL)
  // Set true by a REQUEST_INFO review decision, cleared the moment the
  // submitter edits the contribution again (spec sections 23/58) - avoids
  // fragile "check the latest review note" log-diffing to answer "is this
  // waiting on the submitter right now".
  needsInfo            Boolean                       @default(false)
  rejectionReason      String?
  rejectedById         String?
  rejectedAt           DateTime?
  withdrawnAt          DateTime?
  // Denormalized "latest reviewer touched this" pointer (spec section 6) -
  // ContributionReviewNote (below) remains the append-only source of truth
  // for full review history, same convention as HistoricalFact.reviewedById.
  lastReviewedById     String?
  lastReviewedAt       DateTime?
  // Optimistic-concurrency guard (spec section 53/54) - every review/
  // transition/catalogue action must pass the version it last read; the
  // update increments it, so two reviewers finalizing at once cannot both
  // silently win. True concurrent-write races remain UNVERIFIED_LIVE_DB.
  version              Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  contributor User   @relation(fields: [contributorId], references: [id])
  place       Place? @relation(fields: [placeId], references: [id])

  media              ContributionMedia[]
  reviewNotes        ContributionReviewNote[]
  provenanceEvidence ContributionSource[]
  catalogueResults   ContributionCatalogueResult[]

  @@index([status])
  @@index([contributorId])
  @@index([type])
}

model ContributionMedia {
  id             String @id @default(cuid())
  contributionId String
  mediaAssetId   String

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id])

  @@unique([contributionId, mediaAssetId])
}

model ContributionReviewNote {
  id             String                      @id @default(cuid())
  contributionId String
  reviewerId     String
  stage          ContributionStatus
  // Nullable for migration-safety on the pre-existing table (spec section
  // 26/27) - every review action written by the current service always
  // sets it; only historical rows from before this field existed can lack
  // one.
  decision       ContributionReviewDecision?
  note           String
  createdAt      DateTime                    @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id])

  @@index([contributionId])
}

// Structured provenance evidence a submitter points to (spec sections 9/10)
// - a book/archive/family-record/oral-testimony/etc. claim. Never becomes a
// canonical Source automatically (spec section 9/30); it exists purely to
// give a PROVENANCE_REVIEW reviewer something concrete to assess. Unknown
// fields stay null - nothing here is ever fabricated to fill a gap.
model ContributionSource {
  id                   String                 @id @default(cuid())
  contributionId       String
  referenceType        ContributionSourceType
  claimedCreator       String?
  claimedOwner         String?
  acquisitionMethod    String?
  approxDateLabel      String?
  sourceOrganization   String?
  archiveCatalogRef    String?
  publicationInfo      String?
  url                  String?
  notes                String?
  // Optional attached evidence (e.g. a photo of a family record's cover) -
  // still just a plain MediaAsset, still subject to the same ownership
  // rules as every other contribution media reference.
  evidenceMediaAssetId String?
  createdAt            DateTime               @default(now())

  contribution  Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  evidenceMedia MediaAsset?  @relation(fields: [evidenceMediaAssetId], references: [id])

  @@index([contributionId])
}

// What a CATALOGUED contribution actually produced (spec sections 28/29/52)
// - one row per canonical output. Deliberately a set of rows, not a single
// nullable `createdSourceId` column, since one contribution can plausibly
// produce a Source, a SourceDocument, and one or more MediaAsset promotions.
// Also the idempotency anchor (spec section 52): ContributionsService checks
// for an existing row of the relevant resultType before creating a second
// canonical record for the same contribution.
model ContributionCatalogueResult {
  id               String                          @id @default(cuid())
  contributionId   String
  resultType       ContributionCatalogueResultType
  sourceId         String?
  sourceDocumentId String?
  mediaAssetId     String?
  createdById      String
  createdAt        DateTime                        @default(now())

  contribution   Contribution    @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  source         Source?         @relation(fields: [sourceId], references: [id])
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id])

  @@index([contributionId])
  @@index([resultType])
}

// =========================================================================
// STAY + FOOD + ACTIVITIES  (G05, Global Backend V2 Extension)
// =========================================================================
// See docs/backend/G05_STAY_FOOD_ACTIVITIES.md for the full contract. Every
// model below follows the exact layering G00 locked and G04 already proved
// out for Destination: a first-party CANONICAL IDENTITY (this platform's own
// opinion of what exists in the real world), completely separate from a
// PROVIDER REFERENCE (one external vendor's record of the same real-world
// thing - never the canonical PK, never auto-matched by fuzzy name/photo/
// coordinates), completely separate again from a time-boxed OFFER/SNAPSHOT
// (provider + context + currency + fetchedAt + freshness - never a
// permanent `entity.price` column). No G00-G04 table, column, or enum value
// is modified by this phase - every FK below points outward at an existing
// G01 geography row, an existing G02 ExternalProvider, or an existing
// MediaAsset/PublicationStatus, and every back-relation added to those
// existing models above is purely additive (a new Prisma-side array field,
// zero new column on the existing table itself).

enum AccommodationType {
  HOTEL
  HOSTEL
  GUESTHOUSE
  RESORT
  APARTMENT
  HOMESTAY
  RYOKAN
  VILLA
  CAMPING
  OTHER
}

// Shared by AccommodationOffer and ActivityOffer (spec section 24/60) -
// explicit, never inferred. Missing/absent provider data must resolve to
// UNKNOWN, never silently treated as AVAILABLE (spec section 24/32).
enum AvailabilityStatus {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
  LIMITED
}

// Lifecycle of one Provider*Reference row (spec section 73) - independent of
// the canonical entity's own PublicationStatus and of the ProviderIntegration
// status above it. UNMAPPED means the provider record exists but has not
// (yet, or no longer) been linked to a canonical entity - it is never
// resurrected into a public canonical response while UNMAPPED (spec section
// 82/101).
enum ProviderReferenceStatus {
  ACTIVE
  STALE
  DISABLED
  UNMAPPED
}

// -------------------------------------------------------------------------
// STAY
// -------------------------------------------------------------------------

// First-party canonical lodging-property identity (spec section 13) - never
// a provider listing, never keyed by a provider's external ID. Country is
// required/authoritative; Region/City optional, exactly like Destination's
// own G01 geography shape (spec section 16).
model Accommodation {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  regionId      String?
  cityId        String?
  type          AccommodationType
  latitude      Float?
  longitude     Float?
  importance    Int               @default(0)
  status        PublicationStatus @default(DRAFT)
  // Reuses the exact same rights/access-policy/status-gated MediaAsset
  // resolution every other heroMediaId relation in this schema already has
  // (spec section 20/69) - no raw URL ever stored here.
  heroMediaId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country   Country     @relation(fields: [countryId], references: [id])
  region    Region?     @relation(fields: [regionId], references: [id])
  city      City?       @relation(fields: [cityId], references: [id])
  heroMedia MediaAsset? @relation("AccommodationHeroMedia", fields: [heroMediaId], references: [id])

  translations       AccommodationTranslation[]
  destinationLinks   DestinationAccommodation[]
  providerReferences ProviderAccommodationReference[]
  // G06 (Trip Planner + Cost Engine) - back-relation for TripItem.accommodationId.
  tripItems          TripItem[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([type])
  @@index([status])
  @@index([heroMediaId])
}

model AccommodationTranslation {
  id              String            @id @default(cuid())
  accommodationId String
  locale          String
  name            String
  slug            String
  summary         String?
  description     String?
  seoTitle        String?
  seoDescription  String?
  status          TranslationStatus @default(DRAFT)
  method          TranslationMethod @default(ORIGINAL)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([accommodationId, locale])
}

// Destination <-> Accommodation (spec section 16/52) - a real many-to-many
// join, never a single-sided `Accommodation.destinationId`, mirroring
// DestinationPlace exactly: one property may legitimately be discoverable
// from more than one Destination page (e.g. a hotel between two adjacent
// neighborhood Destinations).
model DestinationAccommodation {
  id              String   @id @default(cuid())
  destinationId   String
  accommodationId String
  sortOrder       Int      @default(0)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())

  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, accommodationId])
  @@index([accommodationId])
  @@index([destinationId, sortOrder])
}

// One external provider's record of a real-world property (spec section
// 18) - NEVER the canonical identity. `accommodationId` is nullable: a
// provider reference can exist unmapped (spec section 43/102 - "unmapped
// provider entities must not be silently auto-created as canonical").
// Matching to a canonical Accommodation is always an explicit admin action
// (spec section 19 - no fuzzy name/photo/coordinate auto-matching).
model ProviderAccommodationReference {
  id               String                  @id @default(cuid())
  providerId       String
  accommodationId  String?
  // The provider's own identifier for this listing - unique only WITHIN
  // that provider's namespace (spec section 18 - "do not make
  // externalEntityId globally unique across providers").
  externalEntityId String
  externalUrl      String?
  status           ProviderReferenceStatus @default(UNMAPPED)
  firstSeenAt      DateTime                @default(now())
  lastSeenAt       DateTime                @default(now())
  lastVerifiedAt   DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  provider      ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  accommodation Accommodation?   @relation(fields: [accommodationId], references: [id])

  offers AccommodationOffer[]

  @@unique([providerId, externalEntityId])
  @@index([accommodationId])
  @@index([status])
}

// Provider + property + context + currency + timestamp + freshness (spec
// section 20/21) - never a permanent `accommodation.price` column. Every
// field a real price needs to mean anything is mandatory context, not an
// afterthought (spec section 21).
model AccommodationOffer {
  id                  String             @id @default(cuid())
  providerReferenceId String
  // Local calendar dates (spec section 98 - a hotel stay is never an
  // arbitrary UTC timestamp), stored date-only.
  checkInDate         DateTime           @db.Date
  checkOutDate        DateTime           @db.Date
  guests              Int
  rooms               Int                @default(1)
  // ISO 4217, normalized uppercase, validated at the DTO layer exactly like
  // Country.iso3 already is (spec section 22/100) - never assumed USD.
  currency            String
  amount              Decimal            @db.Decimal(12, 2)
  taxAmount           Decimal?           @db.Decimal(12, 2)
  feeAmount           Decimal?           @db.Decimal(12, 2)
  totalAmount         Decimal?           @db.Decimal(12, 2)
  taxesIncluded       Boolean?
  feesIncluded        Boolean?
  availability        AvailabilityStatus @default(UNKNOWN)
  bookingUrl          String?
  fetchedAt           DateTime           @default(now())
  expiresAt           DateTime?
  refreshAfter        DateTime?
  createdAt           DateTime           @default(now())

  providerReference ProviderAccommodationReference @relation(fields: [providerReferenceId], references: [id], onDelete: Cascade)

  @@index([providerReferenceId, checkInDate, checkOutDate])
  @@index([expiresAt])
}

// -------------------------------------------------------------------------
// FOOD
// -------------------------------------------------------------------------

// Culinary tradition/category (spec section 30) - deliberately NOT a rigid
// nationality-only hierarchy (a Cuisine may be country-scoped, like
// "Vietnamese", or narrower, like "Kyoto cuisine" / "Kaiseki") - so
// country/region/city scope is optional context, never a mandatory chain,
// and never a provider restaurant category promoted automatically (spec
// section 43).
model Cuisine {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String?
  regionId      String?
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country Country? @relation(fields: [countryId], references: [id])
  region  Region?  @relation(fields: [regionId], references: [id])

  translations    CuisineTranslation[]
  dishLinks       DishCuisine[]
  restaurantLinks RestaurantCuisine[]

  @@index([countryId])
  @@index([status])
}

model CuisineTranslation {
  id          String            @id @default(cuid())
  cuisineId   String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  cuisine Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@unique([cuisineId, locale])
}

// Canonical food identity (spec section 31) - never embeds a restaurant
// listing or a live price. A substantive historical/origin claim about a
// Dish ("invented in year Y", "originated in region Z") is never stored as
// unverified marketing prose (spec section 32) - editorial summary/
// description text must be original synthesis grounded in already-sourced
// V1/G03 content, the exact same discipline G04's Destination tagline/
// whyVisit copy already follows (see docs/backend/G04_DESTINATION_
// DISCOVERY.md section 12) - a service-layer/editorial discipline, not a
// new hard FK to HistoricalFact (no FactDish table is introduced; adding
// one with zero real sourced Dish-origin claims in this phase's Golden
// Dataset would be schema for its own sake).
model Dish {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  translations     DishTranslation[]
  cuisineLinks     DishCuisine[]
  destinationLinks DestinationDish[]
  restaurantLinks  RestaurantDish[]

  @@index([status])
}

model DishTranslation {
  id          String            @id @default(cuid())
  dishId      String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, locale])
}

model DishCuisine {
  id        String   @id @default(cuid())
  dishId    String
  cuisineId String
  createdAt DateTime @default(now())

  dish    Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  cuisine Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@unique([dishId, cuisineId])
  @@index([cuisineId])
}

// Destination <-> Dish (spec section 33) - many-to-many, since a Dish may be
// culturally associated with multiple Destinations; deliberately carries no
// "origin" semantics (that is a HistoricalFact-backed claim, not a curation
// link).
model DestinationDish {
  id            String   @id @default(cuid())
  destinationId String
  dishId        String
  sortOrder     Int      @default(0)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  dish        Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([destinationId, dishId])
  @@index([dishId])
  @@index([destinationId, sortOrder])
}

// First-party canonical restaurant/venue identity (spec section 34) - never
// a provider listing, never keyed by a Google Place ID or any other
// provider's external ID.
model Restaurant {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  regionId      String?
  cityId        String?
  latitude      Float?
  longitude     Float?
  status        PublicationStatus @default(DRAFT)
  heroMediaId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country   Country     @relation(fields: [countryId], references: [id])
  region    Region?     @relation(fields: [regionId], references: [id])
  city      City?       @relation(fields: [cityId], references: [id])
  heroMedia MediaAsset? @relation("RestaurantHeroMedia", fields: [heroMediaId], references: [id])

  translations       RestaurantTranslation[]
  destinationLinks   DestinationRestaurant[]
  cuisineLinks       RestaurantCuisine[]
  dishLinks          RestaurantDish[]
  providerReferences ProviderRestaurantReference[]
  // G06 (Trip Planner + Cost Engine) - back-relation for TripItem.restaurantId.
  tripItems          TripItem[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([status])
  @@index([heroMediaId])
}

model RestaurantTranslation {
  id             String            @id @default(cuid())
  restaurantId   String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, locale])
}

model DestinationRestaurant {
  id            String   @id @default(cuid())
  destinationId String
  restaurantId  String
  sortOrder     Int      @default(0)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([destinationId, restaurantId])
  @@index([restaurantId])
  @@index([destinationId, sortOrder])
}

// First-party curated relation (spec section 40) - editorial, never
// auto-derived from a provider's own category list (which stays provider
// operational metadata on RestaurantOperationalSnapshot instead).
model RestaurantCuisine {
  id           String   @id @default(cuid())
  restaurantId String
  cuisineId    String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, cuisineId])
  @@index([cuisineId])
}

model RestaurantDish {
  id           String   @id @default(cuid())
  restaurantId String
  dishId       String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dishId])
  @@index([dishId])
}

model ProviderRestaurantReference {
  id               String                  @id @default(cuid())
  providerId       String
  restaurantId     String?
  externalEntityId String
  externalUrl      String?
  status           ProviderReferenceStatus @default(UNMAPPED)
  firstSeenAt      DateTime                @default(now())
  lastSeenAt       DateTime                @default(now())
  lastVerifiedAt   DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  provider   ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  restaurant Restaurant?      @relation(fields: [restaurantId], references: [id])

  operationalSnapshots RestaurantOperationalSnapshot[]

  @@unique([providerId, externalEntityId])
  @@index([restaurantId])
  @@index([status])
}

// Operational provider data (spec section 36/37/38/39) - address/phone/
// hours/price-level/rating are all provider-scoped snapshots, never
// promoted into a canonical cross-provider truth. `openingHours` is a
// small, non-sensitive structured JSON array of the provider's own
// day/open/close entries (never raw provider payload - spec section 27 -
// just the minimal operational fields this domain actually needs, with
// their own `timezone` alongside so section 37's "do not assume UTC means
// local time" is representable). `providerRating`/`providerRatingCount`
// are explicitly PROVIDER-SCOPED (never merged across providers into one
// fake score - spec section 38/50).
model RestaurantOperationalSnapshot {
  id                  String    @id @default(cuid())
  providerReferenceId String
  address             String?
  phone               String?
  website             String?
  priceLevel          Int?
  reservationUrl      String?
  openingHours        Json?
  timezone            String?
  temporaryClosure    Boolean   @default(false)
  permanentlyClosed   Boolean   @default(false)
  providerRating      Float?
  providerRatingCount Int?
  // Reference/URL only, never the binary (spec section 39/52/103) - subject
  // to the same provider policy gate as every other field class here.
  providerPhotoRef    String?
  fetchedAt           DateTime  @default(now())
  expiresAt           DateTime?
  refreshAfter        DateTime?
  createdAt           DateTime  @default(now())

  providerReference ProviderRestaurantReference @relation(fields: [providerReferenceId], references: [id], onDelete: Cascade)

  @@index([providerReferenceId])
  @@index([expiresAt])
}

// -------------------------------------------------------------------------
// ACTIVITY
// -------------------------------------------------------------------------

// Visitor-facing attraction identity (spec section 41/42) - explicitly
// separate from the knowledge/trust-domain `Place`. `placeId` is an
// optional, additive, nullable typed mapping when a historical Place is
// ALSO a visitor attraction (e.g. a museum) - never a merge, never implying
// every Place is automatically an Attraction.
model Attraction {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  regionId      String?
  cityId        String?
  placeId       String?
  latitude      Float?
  longitude     Float?
  status        PublicationStatus @default(DRAFT)
  heroMediaId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country   Country     @relation(fields: [countryId], references: [id])
  region    Region?     @relation(fields: [regionId], references: [id])
  city      City?       @relation(fields: [cityId], references: [id])
  place     Place?      @relation(fields: [placeId], references: [id])
  heroMedia MediaAsset? @relation("AttractionHeroMedia", fields: [heroMediaId], references: [id])

  translations     AttractionTranslation[]
  destinationLinks DestinationAttraction[]
  activities       Activity[]
  // G06 (Trip Planner + Cost Engine) - back-relation for TripItem.attractionId.
  tripItems        TripItem[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([placeId])
  @@index([status])
  @@index([heroMediaId])
}

model AttractionTranslation {
  id             String            @id @default(cuid())
  attractionId   String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@unique([attractionId, locale])
}

model DestinationAttraction {
  id            String   @id @default(cuid())
  destinationId String
  attractionId  String
  sortOrder     Int      @default(0)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attraction  Attraction  @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@unique([destinationId, attractionId])
  @@index([attractionId])
  @@index([destinationId, sortOrder])
}

// Canonical visitor EXPERIENCE identity (spec section 43) - deliberately
// OPTIONAL to map: a `ProviderActivityReference` may exist with no
// canonical Activity at all (never "one canonical Activity per provider
// tour product" - that would create thousands of near-duplicate rows from
// provider catalog noise). `attractionId` is optional context (a cooking
// class has no Attraction; a guided museum tour might reference one).
model Activity {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  regionId      String?
  cityId        String?
  attractionId  String?
  status        PublicationStatus @default(DRAFT)
  heroMediaId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country    Country     @relation(fields: [countryId], references: [id])
  region     Region?     @relation(fields: [regionId], references: [id])
  city       City?       @relation(fields: [cityId], references: [id])
  attraction Attraction? @relation(fields: [attractionId], references: [id])

  translations       ActivityTranslation[]
  destinationLinks   DestinationActivity[]
  providerReferences ProviderActivityReference[]
  // G06 (Trip Planner + Cost Engine) - back-relation for TripItem.activityId.
  tripItems          TripItem[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([attractionId])
  @@index([status])
}

model ActivityTranslation {
  id          String            @id @default(cuid())
  activityId  String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, locale])
}

model DestinationActivity {
  id            String   @id @default(cuid())
  destinationId String
  activityId    String
  sortOrder     Int      @default(0)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  activity    Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([destinationId, activityId])
  @@index([activityId])
  @@index([destinationId, sortOrder])
}

// A commercial ticket/tour product from one external provider (spec section
// 44/46) - e.g. "Viator product XYZ" - NEVER the canonical Activity id.
// `activityId` optional (spec section 43); `destinationId` optional direct
// context for provider catalog browsing when no canonical Activity mapping
// exists yet (spec section 44's field list).
model ProviderActivityReference {
  id               String                  @id @default(cuid())
  providerId       String
  activityId       String?
  destinationId    String?
  externalEntityId String
  externalUrl      String?
  status           ProviderReferenceStatus @default(UNMAPPED)
  firstSeenAt      DateTime                @default(now())
  lastSeenAt       DateTime                @default(now())
  lastVerifiedAt   DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  activity Activity?        @relation(fields: [activityId], references: [id])

  offers ActivityOffer[]

  @@unique([providerId, externalEntityId])
  @@index([activityId])
  @@index([destinationId])
  @@index([status])
}

// Provider + product + date/participants + currency + timestamp +
// freshness (spec section 45/47) - never a permanent `activity.price`.
model ActivityOffer {
  id                  String             @id @default(cuid())
  providerReferenceId String
  // Local calendar date (spec section 99) - timezone is not assumed; a
  // provider-supplied local time string is stored separately from any
  // internal sort timestamp, exactly like HistoricalDate's own
  // "never fabricate a precision the source doesn't have" discipline.
  activityDate        DateTime           @db.Date
  activityTime        String?
  participants        Int
  currency            String
  amount              Decimal            @db.Decimal(12, 2)
  durationMinutes     Int?
  ticketType          String?
  cancellationSummary String?
  bookingUrl          String?
  availability        AvailabilityStatus @default(UNKNOWN)
  fetchedAt           DateTime           @default(now())
  expiresAt           DateTime?
  refreshAfter        DateTime?
  createdAt           DateTime           @default(now())

  providerReference ProviderActivityReference @relation(fields: [providerReferenceId], references: [id], onDelete: Cascade)

  @@index([providerReferenceId, activityDate])
  @@index([expiresAt])
}

// =========================================================================
// TRIP PLANNER + COST ENGINE  (G06, Global Backend V2 Extension)
// =========================================================================
// See docs/backend/G06_PRE_IMPLEMENTATION_REPORT.md for the full contract
// and rationale behind every divergence from prior-phase convention noted
// inline below. Trip is PRIVATE, single-owner planning data (spec section
// 9/59/60) - completely distinct from G04's Journey (editorial/curatorial,
// no owner, no cost - spec section 4) and from a future G09 Expense/G10
// Booking (spec section 3: PLANNED COST != ESTIMATED COST != LIVE PROVIDER
// PRICE != BOOKED COST != ACTUAL EXPENSE). No G00-G05 table, column, or enum
// value is modified by this phase beyond the purely additive `EntityKind`
// values and back-relation array fields added above (zero new column on any
// existing table).

enum TripStatus {
  DRAFT
  PLANNING
  READY
}

enum TripItemType {
  ACCOMMODATION
  RESTAURANT
  ACTIVITY
  ATTRACTION
  PLACE
  TRANSPORT
  CUSTOM
}

enum TripTransportMode {
  WALK
  LOCAL_TRANSIT
  TRAIN
  BUS
  FLIGHT
  FERRY
  CAR
  TAXI_RIDESHARE
  BIKE
  OTHER
}

// USER_INPUT / RULE_BASED_ESTIMATE / PROVIDER_EVIDENCE / UNKNOWN (spec
// section 23/42) - UNKNOWN is a first-class provenance, never silently
// coerced to a zero amount.
enum TripCostProvenance {
  USER_INPUT
  RULE_BASED_ESTIMATE
  PROVIDER_EVIDENCE
  UNKNOWN
}

enum CostCategory {
  STAY
  FOOD
  ACTIVITY
  TRANSPORT
  OTHER
}

enum CostUnit {
  PER_PERSON
  PER_PERSON_PER_DAY
  PER_ROOM_PER_NIGHT
  PER_TRIP
  PER_ITEM
  PER_LEG
}

enum CostAssumptionScope {
  GLOBAL
  COUNTRY
  REGION
  CITY
  DESTINATION
}

enum CostAssumptionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CostScenario {
  LOW
  TYPICAL
  HIGH
}

enum EstimateCompleteness {
  COMPLETE
  PARTIAL
}

enum EstimateConfidence {
  HIGH
  MEDIUM
  LOW
}

// Ownership-only aggregate root (spec section 9/19) - no TripMember/
// collaboration model yet (deferred to G07, spec section 5/62). Optimistic
// concurrency via `version` follows the existing Story/Journey/Contribution
// pattern, but a version conflict here returns 409 (spec section 62),
// deliberately diverging from those three's existing 400 - see the
// pre-implementation report section 1.7 for why this does not change their
// locked behavior.
model Trip {
  id                   String     @id @default(cuid())
  ownerId              String
  title                String
  status               TripStatus @default(DRAFT)
  // Local calendar dates (same discipline as every G05 offer date - spec
  // section 11) - never a UTC instant. endDate >= startDate is enforced at
  // the service layer, matching this schema's existing convention of never
  // encoding cross-column invariants as DB constraints (e.g. G05 offer date
  // ordering is likewise service-layer only).
  startDate            DateTime   @db.Date
  endDate              DateTime   @db.Date
  // ISO 4217, normalized uppercase - same bare-String + regex convention as
  // Country.defaultCurrency/AccommodationOffer.currency (spec section 12).
  // No live/derived FX conversion exists in this codebase (verified during
  // the pre-implementation audit); see TripCostEstimate below for how
  // cross-currency evidence is handled without one.
  primaryCurrency      String
  travelerCount        Int        @default(1)
  roomCount            Int?
  // Optional structured origin (spec section 13) - never a precise home
  // address; a plain label is also allowed when no canonical geography row
  // fits. Four scalar fields, not a separate TripOrigin table, because a
  // Trip has exactly one origin value, not a collection (see
  // pre-implementation report section 4).
  originCountryId      String?
  originRegionId       String?
  originCityId         String?
  originLabel          String?
  // Optional planning target (spec section 52/53) - a user aspiration, never
  // confused with TripCostEstimate (calculated) or a future Expense
  // (actual). Two scalar fields, not a separate TripBudgetTarget table, for
  // the same single-value reasoning as origin above.
  targetBudgetAmount   Decimal?   @db.Decimal(12, 2)
  targetBudgetCurrency String?
  notes                String?
  // Non-destructive archive (corrected pre-implementation decision - see
  // docs/backend/G06_PRE_IMPLEMENTATION_REPORT.md section 3.8/7): a `null`
  // timestamp means active/planning; a set timestamp means archived. This
  // is deliberately a plain nullable timestamp, not a fourth `TripStatus`
  // value - the planning lifecycle (DRAFT/PLANNING/READY) and the
  // archive/soft-delete lifecycle are two independent axes, exactly like
  // Journey/Story keep `editorialStatus` and `archivedAt` independent
  // elsewhere in this schema. Archiving never touches `destinations`/
  // `days`/`items`/`transportLegs`/`estimateGenerations` below, and never
  // cascades into any canonical entity a TripItem references - it is purely
  // a visibility flag future G07/G08/G09 phases can build on (referenced
  // Trip rows must survive an owner's "I'm done planning this" action).
  archivedAt           DateTime?
  version              Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originCountry Country? @relation("TripOriginCountry", fields: [originCountryId], references: [id])
  originRegion  Region?  @relation("TripOriginRegion", fields: [originRegionId], references: [id])
  originCity    City?    @relation("TripOriginCity", fields: [originCityId], references: [id])

  destinations        TripDestination[]
  days                TripDay[]
  items               TripItem[]
  transportLegs       TripTransportLeg[]
  estimateGenerations TripCostEstimateGeneration[]

  @@index([ownerId, archivedAt])
  @@index([ownerId, status])
  @@index([originCountryId])
  @@index([originRegionId])
  @@index([originCityId])
}

// A Trip's ordered selection of canonical Destinations (spec section 14) -
// never a bare `Trip.destinationId`, and never a generic entityType+entityId
// polymorphic relation (same DB-enforced-FK discipline G04's
// DestinationPlace/DestinationTheme/etc. already established - spec section
// 18). Overlapping arrival/departure ranges across rows are deliberately
// allowed (spec section 15) - users may plan nearby areas on the same day.
model TripDestination {
  id            String    @id @default(cuid())
  tripId        String
  destinationId String
  sortOrder     Int
  // Local calendar dates, optional - validated at the service layer to fall
  // within [Trip.startDate, Trip.endDate] and arrival <= departure when both
  // are present.
  arrivalDate   DateTime? @db.Date
  departureDate DateTime? @db.Date
  notes         String?
  createdAt     DateTime  @default(now())

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([tripId, sortOrder])
  @@index([tripId])
  @@index([destinationId])
}

// One row per planning day (spec section 16) - date is a local calendar
// date, unique per Trip, and validated at the service layer to fall within
// [Trip.startDate, Trip.endDate]. dayNumber is a denormalized display
// convenience (1-based, matches `date`'s position in the Trip's date range)
// so clients never have to compute it from `date` themselves.
model TripDay {
  id        String   @id @default(cuid())
  tripId    String
  date      DateTime @db.Date
  dayNumber Int
  title     String?
  notes     String?
  createdAt DateTime @default(now())

  trip          Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items         TripItem[]
  estimateItems TripCostEstimateItem[]

  @@unique([tripId, date])
  @@index([tripId])
}

// Deliberately typed nullable FKs, one per canonical entity kind, rather
// than a generic entityType+entityId polymorphic relation (spec section
// 17/18) - a cost estimate's correctness depends on this item resolving to
// a real, current canonical row, so a silently-dangling generic reference
// here would corrupt cost calculations invisibly. This is a deliberate
// divergence from Comment/Bookmark's existing generic targetType+targetId
// pattern elsewhere in this codebase (acceptable there because a broken
// reference is cosmetic, not financial) - see the pre-implementation report
// section 1.11/2.2. Exactly one canonical FK (or none, for CUSTOM/TRANSPORT)
// must be set consistent with `type`; enforced at the service layer, the
// same place every other cross-field invariant in this schema already is.
model TripItem {
  id              String       @id @default(cuid())
  tripId          String
  tripDayId       String
  type            TripItemType
  sortOrder       Int
  accommodationId String?
  restaurantId    String?
  activityId      String?
  attractionId    String?
  placeId         String?
  transportLegId  String?
  // Required for CUSTOM (spec section 21); otherwise an optional
  // display-snapshot label only - the canonical FK above stays authoritative
  // (spec section 64 - never duplicate the whole canonical entity here).
  title           String?
  notes           String?
  // "HH:mm", validated at the DTO layer with the same @Matches discipline as
  // every other non-full-DateTime field in this schema (spec section 19) -
  // never a bare UTC instant; a Trip may cross timezones, so the timezone
  // itself is resolved from the relevant Destination/City at read time, not
  // stored redundantly here.
  startLocalTime  String?
  endLocalTime    String?
  allDay          Boolean      @default(false)
  // User-entered planning override (spec section 78/79 precedence tier 1) -
  // distinct from, and takes precedence over, any TripCostEstimateItem
  // computed later from provider evidence or CostAssumption.
  plannedAmount   Decimal?     @db.Decimal(12, 2)
  plannedCurrency String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  trip          Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day           TripDay           @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  accommodation Accommodation?    @relation(fields: [accommodationId], references: [id])
  restaurant    Restaurant?       @relation(fields: [restaurantId], references: [id])
  activity      Activity?         @relation(fields: [activityId], references: [id])
  attraction    Attraction?       @relation(fields: [attractionId], references: [id])
  place         Place?            @relation(fields: [placeId], references: [id])
  transportLeg  TripTransportLeg? @relation(fields: [transportLegId], references: [id])

  estimateItems TripCostEstimateItem[]

  @@unique([tripDayId, sortOrder])
  @@index([tripId])
  @@index([accommodationId])
  @@index([restaurantId])
  @@index([activityId])
  @@index([attractionId])
  @@index([placeId])
  @@index([transportLegId])
}

// Minimal planning-only transport concept (spec section 22/23/24) - never a
// booking, never a live fare, never an invented road distance. `fromLabel`/
// `toLabel` are always populated (for display even when no canonical
// Destination/City is selected); `fromDestinationId`/`toDestinationId` are
// optional structured context on top of that free label.
model TripTransportLeg {
  id                String             @id @default(cuid())
  tripId            String
  sortOrder         Int
  mode              TripTransportMode
  fromLabel         String
  toLabel           String
  fromDestinationId String?
  toDestinationId   String?
  plannedDate       DateTime?          @db.Date
  plannedAmount     Decimal?           @db.Decimal(12, 2)
  plannedCurrency   String?
  provenance        TripCostProvenance @default(UNKNOWN)
  notes             String?
  createdAt         DateTime           @default(now())

  trip            Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromDestination Destination? @relation("TripTransportLegFrom", fields: [fromDestinationId], references: [id])
  toDestination   Destination? @relation("TripTransportLegTo", fields: [toDestinationId], references: [id])

  items         TripItem[]
  estimateItems TripCostEstimateItem[]

  @@unique([tripId, sortOrder])
  @@index([tripId])
  @@index([fromDestinationId])
  @@index([toDestinationId])
}

// Admin-managed planning-cost configuration (spec section 31-33/79-81/96-99)
// - ADMIN-only mutation (same RBAC tier as ProviderLicense, not the looser
// EDITOR/ADMIN used for public catalogue content - pre-implementation report
// section 1.10). Feeds the deterministic Cost Engine; never itself a live
// price. `scopeId` is null only when `scope = GLOBAL`; otherwise it is the
// id of the Country/Region/City/Destination row named by `scope` (no DB-
// level polymorphic FK is possible here since the target table varies by
// scope - the same tradeoff G05's ProviderAccommodationReference-style
// tables already accept for provider-side ids - validated at the service
// layer instead).
model CostAssumption {
  id            String               @id @default(cuid())
  scope         CostAssumptionScope
  scopeId       String?
  category      CostCategory
  unit          CostUnit
  currency      String
  // low <= typical <= high enforced at the service layer (spec section 80).
  lowAmount     Decimal              @db.Decimal(12, 2)
  typicalAmount Decimal              @db.Decimal(12, 2)
  highAmount    Decimal              @db.Decimal(12, 2)
  effectiveFrom DateTime             @db.Date
  effectiveTo   DateTime?            @db.Date
  status        CostAssumptionStatus @default(DRAFT)
  version       Int                  @default(1)
  // Provenance note (e.g. "editorial estimate" or a cited source) - never
  // fabricated by an LLM (spec section 51).
  source        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  estimateItems TripCostEstimateItem[]

  @@unique([scope, scopeId, category, unit, effectiveFrom])
  @@index([scope, scopeId, category, status])
}

// Atomic parent for one calculation generation (spec section 91-93) - LOW/
// TYPICAL/HIGH are always written together in one transaction (spec section
// 92); `inputHash` + `engineVersion` give idempotent re-calculation (spec
// section 48/93) via the unique constraint below.
model TripCostEstimateGeneration {
  id            String   @id @default(cuid())
  tripId        String
  // Trip.version at calculation time - part of the idempotency key so a
  // Trip edit between two calculations is never silently ignored.
  tripVersion   Int
  inputHash     String
  engineVersion String
  calculatedAt  DateTime @default(now())

  trip      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  estimates TripCostEstimate[]

  @@unique([tripId, inputHash, engineVersion])
  @@index([tripId, calculatedAt])
}

// One row per scenario within a generation (spec section 29/30/89/90) - the
// LOW <= TYPICAL <= HIGH invariant holds by construction (every contributing
// CostAssumption/offer amount already satisfies it - see the
// pre-implementation report section 3.5), never by runtime renormalization.
model TripCostEstimate {
  id           String               @id @default(cuid())
  generationId String
  scenario     CostScenario
  currency     String
  totalAmount  Decimal              @db.Decimal(12, 2)
  completeness EstimateCompleteness
  confidence   EstimateConfidence
  unknownCount Int                  @default(0)

  generation TripCostEstimateGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  items      TripCostEstimateItem[]

  @@unique([generationId, scenario])
}

// Explainable component breakdown (spec section 28/45/89) - sum(amount) over
// non-UNKNOWN items must equal the parent estimate's totalAmount (tested,
// not just documented). `amount`/`currency` are null exactly when
// `provenance = UNKNOWN` (spec section 42 - UNKNOWN is never coerced to 0).
// `offerId` is a plain id pointer (no Prisma relation) to an
// AccommodationOffer/ActivityOffer row - deliberately not a DB relation, so
// a future G05 offer-retention-policy deletion never cascades into or is
// blocked by this table (spec section 65/66 - only the minimal permitted
// evidence snapshot is kept, not a live dependency on the offer still
// existing).
model TripCostEstimateItem {
  id             String             @id @default(cuid())
  estimateId     String
  category       CostCategory
  tripDayId      String?
  tripItemId     String?
  transportLegId String?
  currency       String?
  amount         Decimal?           @db.Decimal(12, 2)
  provenance     TripCostProvenance
  assumptionId   String?
  offerId        String?
  description    String?

  estimate     TripCostEstimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  tripDay      TripDay?          @relation(fields: [tripDayId], references: [id])
  tripItem     TripItem?         @relation(fields: [tripItemId], references: [id])
  transportLeg TripTransportLeg? @relation(fields: [transportLegId], references: [id])
  assumption   CostAssumption?   @relation(fields: [assumptionId], references: [id])

  @@index([estimateId])
  @@index([tripDayId])
  @@index([tripItemId])
  @@index([transportLegId])
  @@index([assumptionId])
}
