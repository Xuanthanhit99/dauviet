  BIOGRAPHICAL
  EVENT_DETAIL
  TERRITORIAL
  ARCHITECTURAL
  CULTURAL
  ADMINISTRATIVE
  MILITARY
  ECONOMIC
  OTHER
}

enum FactCertainty {
  CONFIRMED
  HIGH_CONFIDENCE
  DISPUTED
  UNCERTAIN
  TRADITIONAL_ACCOUNT
  ORAL_HISTORY
