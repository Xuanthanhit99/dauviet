// Dau Viet - Living Digital Atlas of Vietnam
// Backend system of record. PostgreSQL + PostGIS.
//
// Design notes (see docs/backend/BACKEND_HANDOFF.md for full rationale):
// - Translation tables carry all locale-specific display text (no nameVi/nameEn columns).
// - High-integrity historical relationships (Fact<->Entity, Event<->Entity, Story<->Entity,
//   CommunityStory<->Entity, JourneyStop) use real FK join tables, not polymorphic columns.
// - Lower-integrity, cross-cutting attachments (Comment, Bookmark, Report, gallery media,
//   generic aliases) use a validated polymorphic (entityType + entityId) pattern - this is
//   the explicit exception carved out by the spec for non-critical relations.
// - PostGIS geometry columns are declared Unsupported() because Prisma has no native GIS
//   type; all spatial writes/reads go through raw SQL in the map/territory services.
// - Historical dates are never forced into a single precise timestamp: every dated entity
//   carries explicit year/month/day + precision + qualifier columns (never a fabricated
//   Jan-1 for a year-only date) plus internal sort-only DateTime columns for range queries.
//   See docs/backend/HISTORICAL_DOMAIN.md for the full contract (spec Phase 03 section 3).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // unaccent (Phase 07, spec section 33/73) - diacritic-insensitive search
  // ("Tran Hung Dao" -> "Trần Hưng Đạo"). See the Phase 07 migration for the
  // IMMUTABLE wrapper function required to index it, and
  // docs/backend/DISCOVERY_ARCHITECTURE.md for the full rationale.
  extensions = [postgis, pg_trgm, unaccent]
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  USER
  CONTRIBUTOR
  EDITOR
  HISTORIAN_REVIEWER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum ClientPlatform {
  WEB
  IOS
  ANDROID
  OTHER
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// Phase 06 (spec section 17) - Story needs a richer workflow than the flat
// PublicationStatus every other entity uses: a SOURCE_CHECK stage (does the
// narrative's factual support actually exist and hold up?) and SCHEDULED
// (spec section 23), neither of which PublicationStatus models. Mirrors the
// shape of FactEditorialStatus (same phase/stage vocabulary) rather than
// inventing a third, incompatible workflow vocabulary.
enum StoryEditorialStatus {
  DRAFT
  SOURCE_CHECK
  EDITORIAL_REVIEW
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Phase 06 (spec section 5) - deliberately small and not Vietnam-specific
// (spec section 56 - Hoang Sa/Truong Sa content is just an ordinary Place-
// linked STORY/PLACE_STORY, never a special-cased type or enum value).
enum StoryType {
  FEATURE
  HISTORICAL_EXPLAINER
  PLACE_STORY
  PERSON_STORY
  EVENT_STORY
  ARCHIVE_STORY
  THEN_AND_NOW
  CULTURAL_STORY
  EDITORIAL
  OTHER
}

// Phase 06 (spec section 8/9) - distinguishes a Story's central subject from
// merely-related/mentioned entities, so a client never has to guess primary
// subject from insertion order.
enum StoryLinkRole {
  PRIMARY_SUBJECT
  RELATED
  MENTIONED
  LOCATION
  CONTEXT
}

enum FactEditorialStatus {
  DRAFT
  SOURCE_CHECK
  FACT_REVIEW
  EDITORIAL_REVIEW
  READY
  PUBLISHED
  // A previously PUBLISHED fact that has been pulled from public output
  // without destroying its history (spec section 37). Distinct from DRAFT:
  // a retracted fact was once trusted and now explicitly is not, which is
  // editorially different from "never finished review".
  RETRACTED
}

// Outcome of a single FactReview record (spec section 22). Distinct from
// FactEditorialStatus - a decision is what a reviewer concluded at one
// stage; the editorial status is where the fact currently sits.
enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum PlaceType {
  HISTORICAL_SITE
  ARCHAEOLOGICAL_SITE
  MONUMENT
  TEMPLE
  PAGODA
  PALACE
  CITADEL
  BATTLEFIELD
  MUSEUM
  PRISON
  TOMB
  PORT
  VILLAGE
  ISLAND
  ARCHIPELAGO
  RIVER
  MOUNTAIN
  URBAN_AREA
  OTHER
}

// Historical date model (docs/backend/HISTORICAL_DOMAIN.md). `precision`
// says how granular the known value is; `DateQualifier` (below) says how
// certain/bounded it is. The two are independent: a YEAR-precision date can
// be EXACT, CIRCA, BEFORE, AFTER, part of a BETWEEN range, UNCERTAIN, or a
// TRADITIONAL/legendary account. Never conflate "coarse" with "uncertain".
enum DatePrecision {
  DAY
  MONTH
  YEAR
  DECADE
  CENTURY
  UNKNOWN
}

enum DateQualifier {
  EXACT
  CIRCA
  BEFORE
  AFTER
  BETWEEN
  UNCERTAIN
  TRADITIONAL
}

enum FactType {
  BIOGRAPHICAL
  EVENT_DETAIL
  TERRITORIAL
  ARCHITECTURAL
  CULTURAL
  ADMINISTRATIVE
  MILITARY
  ECONOMIC
  OTHER
}

enum FactCertainty {
  CONFIRMED
  HIGH_CONFIDENCE
  DISPUTED
  UNCERTAIN
  TRADITIONAL_ACCOUNT
  ORAL_HISTORY
}

enum FactSensitivity {
  NORMAL
  HIGH
  TERRITORIAL
  LEGAL
  CONTESTED
}

enum SourceType {
  BOOK
  PRIMARY_DOCUMENT
  ARCHIVAL_DOCUMENT
  MAP
  MANUSCRIPT
  ACADEMIC_PAPER
  MUSEUM_RECORD
  GOVERNMENT_DOCUMENT
  UNESCO_RECORD
  NEWSPAPER
  PHOTO_ARCHIVE
  ORAL_HISTORY
  WEBSITE
  OTHER
}

enum SourceCredibility {
  PRIMARY
  SECONDARY
  TERTIARY
  UNKNOWN
}

enum CitationVerificationState {
  UNVERIFIED
  VERIFIED
  // The citation was reviewed and found not to support the claim (a bad
  // source/misreading) - distinct from DISPUTED, where the source is
  // legitimate but historians disagree about the claim (spec section 12).
  REJECTED
  DISPUTED
}

enum AccessPolicy {
  PUBLIC
  PREVIEW_ONLY
  METADATA_ONLY
  RESTRICTED
}

enum MediaType {
  PHOTO
  ARCHIVAL_PHOTO
  DOCUMENT_SCAN
  MAP
  ILLUSTRATION
  RECONSTRUCTION
  AUDIO
  VIDEO
  MODEL_3D
}

// Phase 05: upload/processing lifecycle (spec section 13). A MediaAsset row
// is created the moment an upload is requested - never only after the client
// claims success - so the backend always has something to verify against.
enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  QUARANTINED
  FAILED
  ARCHIVED
}

// Phase 05 (spec section 6) - an editorial aid describing the DECLARED/
// REVIEWED rights position, never an automatically-computed legal
// conclusion. UNKNOWN is never treated as permission to publish.
enum RightsStatus {
  PUBLIC_DOMAIN
  LICENSED
  PERMISSION_GRANTED
  COPYRIGHTED
  UNKNOWN
  RESTRICTED
  COMMUNITY_OWNED
}

// Phase 05 (spec section 17) - which derived rendition a MediaAsset row
// represents when `parentAssetId` is set. Reuses the existing self-relation
// rather than a separate MediaVariant table (see TRUST_MODEL.md-equivalent
// docs/backend/MEDIA_ARCHITECTURE.md for the reuse rationale).
enum MediaVariantType {
  THUMBNAIL
  MEDIUM
  LARGE
  OPTIMIZED_WEB
}

// Phase 05 (spec section 23) - OCR is extraction assistance only; its output
// never automatically becomes verified historical text (still requires the
// normal Fact/Citation trust path to be cited as evidence).
enum DocumentOcrStatus {
  NOT_REQUESTED
  REQUESTED
  PROCESSING
  COMPLETE
  FAILED
}

enum TranslationStatus {
  DRAFT
  AI_ASSISTED
  HUMAN_REVIEWED
  PUBLISHED
}

enum TranslationMethod {
  ORIGINAL
  HUMAN
  AI_ASSISTED
}

// Section 9: Person aliases in particular need finer distinctions than a
// generic "alternate name" (a regnal name is not a temple name is not a
// title). Place/Event aliases mostly use the first four values.
enum AliasType {
  ALTERNATE_NAME
  HISTORICAL_NAME
  ROMANIZATION
  TRANSLITERATION
  ALTERNATE_SPELLING
  ABBREVIATION
  BIRTH_NAME
  REGNAL_NAME
  TEMPLE_NAME
  TITLE
  EPITHET
  OTHER
}

// Event classification (spec section 11). A catalog table + M2M join, not a
// single rigid enum on HistoricalEvent - an event can carry more than one
// theme (e.g. Bach Dang 1288 is both MILITARY and TERRITORIAL), and new
// specific themes can be added as data without a schema migration. The
// enum below is only the coarse, bounded category used for top-level
// filters - it is intentionally not Vietnam-specific so it can grow.
enum ThemeCategory {
  POLITICAL
  MILITARY
  CULTURAL
  DIPLOMATIC
  RELIGIOUS
  ECONOMIC
  SOCIAL
  SCIENTIFIC
  TERRITORIAL
  HERITAGE
  OTHER
}

enum TerritoryType {
  KINGDOM
  PROTECTORATE
  HISTORICAL_PROVINCE
  DISPUTED_ZONE
  ADMINISTRATIVE_BOUNDARY
  OTHER
}

enum EntityKind {
  PLACE
  PERSON
  EVENT
  ERA
  DYNASTY
  TERRITORY
  FACT
  STORY
  JOURNEY
  COMMUNITY_STORY
  SOURCE
  // Added Phase 09 - lets AuditLog/Contribution catalogue-result rows point
  // precisely at a SourceDocument rather than overloading SOURCE for both.
  SOURCE_DOCUMENT
  CONTRIBUTION
  MEDIA_ASSET
  COMMENT
  // Added G01 (Global Backend V2 Extension, Global Geography Foundation) -
  // additive-only extension of this V1 enum so EntityAlias/AuditLog can
  // point at the new global geography entities without a parallel alias
  // table (see docs/backend/GLOBAL_GEOGRAPHY.md section "Aliases"). No
  // existing value was renamed/removed/reordered.
  COUNTRY
  REGION
  CITY
  DESTINATION
  // Added G02 (Global Backend V2 Extension, Provider + Licensing
  // Foundation) - additive-only, lets AuditLog/Revision point precisely at
  // a Provider/ProviderLicense/ProviderIntegration row. Reuses the existing
  // generic Revision model for license/integration policy history rather
  // than a parallel revision table (spec section 17) - no existing value
  // was renamed/removed/reordered.
  PROVIDER
  PROVIDER_LICENSE
  PROVIDER_INTEGRATION
}

enum CommunityStoryType {
  MEMORY
  LOCAL_STORY
  TRAVEL_EXPERIENCE
  THEN_AND_NOW
  DOCUMENT_CONTRIBUTION
  FAMILY_HISTORY
  PHOTO_STORY
}

enum CommunityVerificationState {
  PERSONAL_MEMORY
  COMMUNITY_SUBMISSION
  SOURCE_ATTACHED
  UNDER_REVIEW
  VERIFIED_CONTRIBUTION
}

enum ModerationStatus {
  VISIBLE
  LIMITED
  UNDER_REVIEW
  REMOVED
  LOCKED
}

enum ReportCategory {
  MISINFORMATION
  HATEFUL_CONTENT
  HARASSMENT
  SPAM
  COPYRIGHT
  PERSONAL_INFORMATION
  GRAPHIC_CONTENT
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ContributionStatus {
  SUBMITTED
  TRIAGE
  PROVENANCE_REVIEW
  HISTORICAL_REVIEW
  ACCEPTED
  CATALOGUED
  REJECTED
}

// Phase 09 (spec section 5) - meaningful submission classes without an
// over-narrow taxonomy. CORRECTION is its own type rather than reusing e.g.
// PERSONAL_MEMORY, since a correction targets an existing canonical record
// (see `correctionTargetType`/`correctionTargetId` on Contribution) rather
// than contributing new material.
enum ContributionType {
  DOCUMENT
  PHOTO
  ARCHIVAL_PHOTO
  MAP
  ORAL_HISTORY
  PERSONAL_MEMORY
  FAMILY_ARCHIVE
  BOOK_REFERENCE
  LOCAL_HISTORY
  CORRECTION
  OTHER
}

// Phase 09 (spec section 9) - the kind of provenance evidence a submitter is
// pointing at, distinct from `SourceType` on the canonical `Source` model.
// A ContributionSource is a claim about where material came from; it never
// becomes a real Source row just by existing (spec section 9/30).
enum ContributionSourceType {
  BOOK
  ARCHIVE
  WEBSITE
  FAMILY_RECORD
  ORIGINAL_DOCUMENT
  ORAL_TESTIMONY
  INSTITUTIONAL
  OTHER
}

// Phase 09 (spec section 11) - a reviewer's internal assessment of how
// well-supported a contribution's claimed provenance is. Never historical
// certainty (that is `FactCertainty`, only reachable via the real
// HistoricalFact workflow) and never shown publicly as a trust label
// without context (spec section 11).
enum ProvenanceConfidence {
  UNASSESSED
  LOW
  MEDIUM
  HIGH
  CONFIRMED
  DISPUTED
}

// Phase 09 (spec section 12) - reviewer-controlled rights assessment for a
// contribution, entirely separate from `submitterDeclaration` below (a
// submitter's own unadjudicated claim). Reuses the Phase 05 rights-review
// philosophy (never self-approved) rather than inventing new semantics.
enum ContributionRightsReviewState {
  UNREVIEWED
  NEEDS_INFORMATION
  APPROVED_FOR_CATALOGUE
  RESTRICTED
  REJECTED
}

// Phase 09 (spec section 13) - the submitter's own claim about their right
// to share the material. A claim, never an adjudicated rights state -
// `ContributionRightsReviewState` above is the only field a reviewer acts on.
enum SubmitterRightsDeclaration {
  OWN_MATERIAL
  HAVE_PERMISSION
  PUBLICLY_AVAILABLE
  UNKNOWN
}

// Phase 09 (spec section 64) - how (or whether) a contributor wants public
// credit if their material is ever catalogued. Never inferred from upload
// alone (spec section 65).
enum ContributionAttribution {
  NAMED
  ANONYMOUS
  INSTITUTIONAL
}

// Phase 09 (spec section 27) - the decision recorded by a single
// ContributionReviewNote row. Distinct from ContributionStatus - a decision
// is what a reviewer concluded at one stage, the status is where the
// contribution currently sits (same distinction as HistoricalFact's
// ReviewDecision vs FactEditorialStatus).
enum ContributionReviewDecision {
  APPROVE
  REJECT
  REQUEST_INFO
  RETURN_TO_PREVIOUS_STAGE
}

// Phase 09 (spec section 29) - what kind of canonical record a
// ContributionCatalogueResult row points at. A single ACCEPTED contribution
// may produce more than one of these (e.g. a Source and its SourceDocument),
// so this is a set of result rows, never a single nullable pointer.
enum ContributionCatalogueResultType {
  SOURCE
  SOURCE_DOCUMENT
  MEDIA_ASSET
  FACT_DRAFT
}

// =========================================================================
// IDENTITY & AUTH  (Phase 02)
// =========================================================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  emailVerifiedAt     DateTime?
  displayName         String
  avatarMediaId       String?
  status              UserStatus @default(ACTIVE)
  roles               Role[]     @default([USER])
  locale              String     @default("vi")
  // Privacy toggle (spec Phase 08 section 27) - visited places are a
  // personal record and stay private on the public profile unless the user
  // explicitly opts in. Saved items (Bookmark) have no public-read path at
  // all, so they need no equivalent toggle - they are structurally private.
  visitedPlacesPublic Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  authIdentities      AuthIdentity[]
  sessions            Session[]
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  comments            Comment[]
  commentVotes        CommentVote[]
  bookmarks           Bookmark[]
  reports             Report[]                 @relation("ReportsFiled")
  resolvedReports     Report[]                 @relation("ReportsResolved")
  placeVisits         PlaceVisit[]
  communityStories    CommunityStory[]
  storyVotes          StoryVote[]
  badges              UserBadge[]
  badgesGranted       UserBadge[]              @relation("BadgesGranted")
  contributions       Contribution[]
  contributionReviews ContributionReviewNote[]
  auditLogs           AuditLog[]
  revisionsAuthored   Revision[]
  factReviews         FactReview[]
  thenNowComparisons  ThenNowComparison[]

  avatarMedia MediaAsset? @relation("UserAvatar", fields: [avatarMediaId], references: [id])

  @@index([email])
}

model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String?
  passwordHash   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String         @id @default(cuid())
  userId           String
  refreshTokenHash String         @unique
  platform         ClientPlatform @default(OTHER)
  userAgent        String?
  ip               String?
  deviceLabel      String?
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime       @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================================================================
// SHARED: MEDIA  (Phase 05)
// =========================================================================

model MediaAsset {
  id                 String            @id @default(cuid())
  type               MediaType
  status             MediaAssetStatus  @default(PENDING_UPLOAD)
  storageKey         String
  mimeType           String
  sizeBytes          Int?
  width              Int?
  height             Int?
  // SHA-256 hex digest, computed server-side on confirm - never trusted from
  // the client (spec section 56). Used for integrity/dedup assistance only,
  // never to infer ownership or licensing.
  checksum           String?
  title              String?
  caption            String?
  altText            String?
  creatorName        String?
  sourceId           String?
  captureYear        Int?
  captureMonth       Int?
  captureDay         Int?
  capturePrecision   DatePrecision     @default(UNKNOWN)
  license            String?
  rightsHolder       String?
  rightsStatus       RightsStatus      @default(UNKNOWN)
  attributionText    String?
  // Set only by an EDITOR/HISTORIAN_REVIEWER/ADMIN action (never by the
  // uploader) - an ordinary contributor cannot self-declare PUBLIC_DOMAIN
  // (spec section 46). Plain audit-style pointer, no relation object, same
  // convention as HistoricalFact.reviewedById.
  rightsReviewedById String?
  rightsReviewedAt   DateTime?
  provenanceNote     String?
  isHistorical       Boolean           @default(false)
  isAiGenerated      Boolean           @default(false)
  aiDisclosure       String?
  parentAssetId      String?
  // Only meaningful when parentAssetId is set - which derived rendition this
  // row is (spec section 17).
  variantType        MediaVariantType?
  accessPolicy       AccessPolicy      @default(PUBLIC)
  uploadedById       String?
  uploadConfirmedAt  DateTime?
  quarantinedAt      DateTime?
  quarantinedById    String?
  quarantineReason   String?
  archivedAt         DateTime?
  archivedById       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  source      Source?      @relation(fields: [sourceId], references: [id])
  parentAsset MediaAsset?  @relation("MediaDerivatives", fields: [parentAssetId], references: [id])
  derivatives MediaAsset[] @relation("MediaDerivatives")

  userAvatars                  User[]                        @relation("UserAvatar")
  placesHero                   Place[]                       @relation("PlaceHeroMedia")
  peopleHero                   Person[]                      @relation("PersonHeroMedia")
  eventsHero                   HistoricalEvent[]             @relation("EventHeroMedia")
  storiesHero                  Story[]                       @relation("StoryHeroMedia")
  journeysHero                 Journey[]                     @relation("JourneyHeroMedia")
  communityStoriesHero         CommunityStory[]              @relation("CommunityStoryHeroMedia")
  sourceDocuments              SourceDocument[]
  entityMedia                  EntityMedia[]
  contributionMedia            ContributionMedia[]
  translations                 MediaAssetTranslation[]
  thenNowBefore                ThenNowComparison[]           @relation("ThenNowBefore")
  thenNowAfter                 ThenNowComparison[]           @relation("ThenNowAfter")
  contributionSourceEvidence   ContributionSource[]
  contributionCatalogueResults ContributionCatalogueResult[]

  // Phase 05.1 (spec section 10) - DB-level idempotency for derivative
  // generation: re-running the processor for the same parent upserts the
  // same (parentAssetId, variantType) row rather than creating a duplicate.
  // Safe for original (non-derivative) rows too - Postgres treats each
  // NULL/NULL pair as distinct, so it never collides them.
  @@unique([parentAssetId, variantType])
  @@index([type])
  @@index([sourceId])
  @@index([status])
}

// Optional locale-specific editorial caption/alt text (spec section 34) -
// most uploads (community photos especially) never get one and fall back to
// the flat `caption`/`altText`/`title` on MediaAsset itself, which is always
// in whatever locale the uploader used ("Community caption should preserve
// original locale separately" - spec section 34). Only curated editorial
// media (hero images, gallery features) is expected to gain rows here.
model MediaAssetTranslation {
  id           String   @id @default(cuid())
  mediaAssetId String
  locale       String
  caption      String?
  altText      String?
  createdAt    DateTime @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, locale])
}

// generic gallery attachment (lower-integrity per spec section 15/41)
model EntityMedia {
  id           String     @id @default(cuid())
  entityType   EntityKind
  entityId     String
  mediaAssetId String
  role         String     @default("gallery")
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([mediaAssetId])
}

// =========================================================================
// SHARED: ALIASES  (cross-language / alternate names search - section 22)
// =========================================================================

model EntityAlias {
  id         String     @id @default(cuid())
  entityType EntityKind
  entityId   String
  // "" (not null) for a locale-agnostic alias, so the unique constraint
  // below actually catches duplicates - Postgres treats NULL as distinct
  // from NULL in unique indexes, which would silently let dupes through.
  locale     String     @default("")
  alias      String
  aliasType  AliasType  @default(ALTERNATE_NAME)
  createdAt  DateTime   @default(now())

  @@unique([entityType, entityId, locale, alias])
  @@index([entityType, entityId])
  @@index([alias])
}

// =========================================================================
// GLOBAL GEOGRAPHY  (G01 - Global Backend V2 Extension, Global Geography
// Foundation)
//
// Design notes (see docs/backend/GLOBAL_GEOGRAPHY.md for full rationale):
// - New, additive domain. Does not rename/replace/repurpose any Phase
//   00-12.1 model. Place/Person/HistoricalEvent/etc. remain the frozen V1
//   historical-knowledge entities; Country/Region/City/Destination below are
//   a separate, global, travel/discovery geography layer per the G00
//   Product Constitution ("Destination != Place").
// - Reuses PublicationStatus/TranslationStatus/TranslationMethod (no new
//   editorial-workflow enums) and the existing EntityAlias/AuditLog
//   architecture (EntityKind gained COUNTRY/REGION/CITY/DESTINATION above,
//   additive-only) rather than inventing parallel mechanisms.
// - Representative point only: plain latitude/longitude Float columns, not
//   PostGIS geometry. No bbox/ST_DWithin query is needed for these entities
//   in G01 (Place already owns that for historical sites) - G11 (Global
//   Search + Map) can add PostGIS geometry additively later if a real
//   proximity/bbox query requirement emerges.
// - Hierarchy is deliberately NOT a rigid Country->Region->City->Destination
//   chain: Region is optional on City and on Destination, City is optional
//   on Destination, so "Country -> City" and "Country -> Destination" and
//   "Region -> Destination" all remain valid shapes (spec section 4) - e.g.
//   an island or heritage area with no containing City.
// - Slug strategy deliberately differs from every other V1 translation
//   table: Country keeps the V1 `@@unique([locale, slug])` global
//   constraint (real-world country-name collisions are not a real risk),
//   but Region/City/Destination translations do NOT get that global
//   constraint - common city/region names legitimately collide worldwide
//   (Springfield, Victoria, San Jose - spec section 14), so it would be
//   unsafe to promise global per-locale slug uniqueness for those. The
//   stable, always-unique lookup key for all four is `canonicalSlug` on the
//   parent model itself (auto-suffixed on collision, same mechanism as
//   `Place.canonicalSlug`); the scoped routes (`/v1/countries/:c/cities`)
//   give callers country/region/city context to disambiguate a common name.
// - No delete endpoint is provided anywhere in this domain (archive via
//   `status` only) - the same convention Place/Person already use (spec
//   section 31).
// =========================================================================

// Broad enough for the known G00 administrative shapes (province, state,
// prefecture, a centrally-governed "direct administration" municipality
// such as Hanoi or Tokyo Metropolis) without assuming every country's
// administrative system resembles Vietnam's (spec section 7). Deliberately
// does not attempt to model administrative-vs-tourism-region distinctions
// in G01 - no concrete requirement for a separate TravelRegion model exists
// yet (spec section 7).
enum RegionType {
  PROVINCE
  STATE
  PREFECTURE
  AUTONOMOUS_REGION
  METROPOLITAN_CITY
  TERRITORY
  OTHER
}

// Broad enough for G00's known use cases (spec section 11) without being
// excessively speculative - audited against PlaceType/existing enums first;
// none of them model this "broader than a historical site" travel-discovery
// concept, so a new enum is genuinely needed here (Destination != Place).
enum DestinationType {
  CITY_AREA
  NEIGHBORHOOD
  HISTORIC_DISTRICT
  HERITAGE_AREA
  ISLAND
  ARCHIPELAGO
  NATURAL_AREA
  NATIONAL_PARK
  COAST
  BAY
  TOURISM_AREA
  OTHER
}

model Country {
  id              String            @id @default(cuid())
  canonicalSlug   String            @unique
  // ISO 3166-1 alpha-2/alpha-3, normalized uppercase and validated in the
  // DTO layer (spec section 5) - never invented/guessed.
  iso2            String            @unique
  iso3            String            @unique
  // Geographical defaults only (spec section 18) - never used to infer a
  // user's own UI language, and not restricted to this platform's currently
  // supported translation locales (vi/en): Japan's defaultLocale is "ja"
  // even though no ja translation exists yet.
  defaultLocale   String
  // ISO 4217, normalized uppercase.
  defaultCurrency String
  latitude        Float?
  longitude       Float?
  status          PublicationStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  translations CountryTranslation[]
  regions      Region[]
  cities       City[]
  destinations Destination[]

  @@index([status])
}

model CountryTranslation {
  id               String            @id @default(cuid())
  countryId        String
  locale           String
  name             String
  slug             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?
  status           TranslationStatus @default(DRAFT)
  method           TranslationMethod @default(ORIGINAL)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, locale])
  @@unique([locale, slug])
}

model Region {
  id             String            @id @default(cuid())
  canonicalSlug  String            @unique
  countryId      String
  parentRegionId String?
  type           RegionType
  code           String?
  latitude       Float?
  longitude      Float?
  status         PublicationStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  country      Country  @relation(fields: [countryId], references: [id])
  parentRegion Region?  @relation("RegionHierarchy", fields: [parentRegionId], references: [id])
  childRegions Region[] @relation("RegionHierarchy")

  translations RegionTranslation[]
  cities       City[]
  destinations Destination[]

  @@index([countryId])
  @@index([parentRegionId])
  @@index([type])
  @@index([status])
}

// No global `@@unique([locale, slug])` - see the domain-level design note
// above. `slug` is still generated and stored for future localized-route
// use, just not promised globally unique.
model RegionTranslation {
  id             String            @id @default(cuid())
  regionId       String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, locale])
}

model City {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  // Optional (spec section 9) - Country is authoritative; not every city
  // needs a Region parent.
  regionId      String?
  // IANA timezone identifier (e.g. "Asia/Tokyo"), validated against
  // Intl.supportedValuesOf('timeZone') in the service layer - never just a
  // fixed UTC offset (spec section 17 - DST exists).
  timezone      String
  latitude      Float?
  longitude     Float?
  importance    Int               @default(0)
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country Country @relation(fields: [countryId], references: [id])
  region  Region? @relation(fields: [regionId], references: [id])

  translations CityTranslation[]
  destinations Destination[]

  @@index([countryId])
  @@index([regionId])
  @@index([status])
}

// No global `@@unique([locale, slug])` - see the domain-level design note
// above (Springfield/Victoria/San Jose collision risk across countries).
model CityTranslation {
  id             String            @id @default(cuid())
  cityId         String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, locale])
}

model Destination {
  id            String            @id @default(cuid())
  canonicalSlug String            @unique
  countryId     String
  // Both optional (spec section 11) - Country is required and authoritative;
  // Region/City are additional, validated-consistent context, not a
  // mandatory chain.
  regionId      String?
  cityId        String?
  type          DestinationType
  latitude      Float?
  longitude     Float?
  importance    Int               @default(0)
  status        PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  country Country @relation(fields: [countryId], references: [id])
  region  Region? @relation(fields: [regionId], references: [id])
  city    City?   @relation(fields: [cityId], references: [id])

  translations DestinationTranslation[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([type])
  @@index([status])
}

// No global `@@unique([locale, slug])` - see the domain-level design note
// above.
model DestinationTranslation {
  id             String            @id @default(cuid())
  destinationId  String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, locale])
}

// =========================================================================
// PROVIDER + LICENSING FOUNDATION  (G02 - Global Backend V2 Extension)
//
// Design notes (see docs/backend/PROVIDER_LICENSING.md for full rationale):
// - "No external dataset can become active unless the platform knows what
//   it is legally and technically allowed to do with that data." This
//   domain is pure infrastructure/governance - it does not integrate any
//   real provider API (that is G05's job) and is entirely geography-
//   independent (no relation to Country/Region/City/Destination - spec
//   section 37) and entirely separate from the V1 historical Source/
//   Citation trust chain (spec section 38/39 - an ExternalProvider record
//   NEVER becomes historical evidence).
// - Named `ExternalProvider`, not `TravelProvider` (spec section 5) -
//   future providers may include maps/currency/weather, not just travel.
// - Rights are tri/four-state (`ProviderRightState`: UNKNOWN/ALLOWED/
//   PROHIBITED/CONDITIONAL), never a plain Boolean (spec section 11) - a
//   `false` must never be allowed to mean both "explicitly forbidden" and
//   "not yet reviewed" at once.
// - `ProviderLicense.status` alone drives the review lifecycle (DRAFT ->
//   TERMS_REVIEW -> LEGAL_REVIEW -> APPROVED -> {EXPIRED, REVOKED,
//   REJECTED}) - no separate, potentially-contradicting `reviewStatus`
//   field was added; `reviewedAt`/`reviewedById` remain as audit pointers,
//   same convention as `HistoricalFact.reviewedById`.
// - History/provenance reuses the EXISTING generic `Revision` model
//   (EntityKind gained PROVIDER/PROVIDER_LICENSE/PROVIDER_INTEGRATION,
//   additive) rather than a parallel `ProviderLicenseRevision` table (spec
//   section 17 explicitly calls for auditing existing mechanisms first).
// - `ProviderDataPolicy` (operational retention/cache numbers) is
//   deliberately kept separate from `ProviderLicense` (the legal rights
//   grant) even though both are scoped per capability: a License's rights
//   review has a different approval cadence/authority (legal review) than
//   tuning an operational cache-TTL number, and every DataPolicy still
//   traces back to the License that authorizes it (`licenseId`, required).
// - `ProviderPolicyEvidence` attaches to a License only (not a separate
//   polymorphic "policy" pointer) - every DataPolicy/AttributionRule
//   already links back to a License, so evidence-for-a-License covers them
//   transitively without a messier polymorphic evidence table.
// - Activation is never a cached decision: `ProviderIntegrationCapability`
//   existence is a write-time admin record, but the real serving gate
//   (`ProviderRegistryService.getExecutionContext`, application code, not
//   schema) re-evaluates provider/integration/capability/license state
//   fresh from the database on every call, so a license revocation or
//   expiry takes effect immediately with nothing to invalidate (spec
//   sections 20/42/43).
// =========================================================================

enum ProviderStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  DISABLED
  EXPIRED
}

enum ProviderEnvironment {
  SANDBOX
  PRODUCTION
}

// How our own integration authenticates with this provider - metadata
// only, never a secret value (spec section 9).
enum ProviderCredentialMode {
  NONE
  API_KEY
  OAUTH2
  PARTNER_CONTRACT
  OTHER
}

// A disciplined initial taxonomy (spec section 7), not an enum entry per
// hypothetical API action. Extend additively as a genuine G05+ need
// arises - do not pre-populate speculative values.
enum ProviderCapabilityType {
  PLACE_SEARCH
  PLACE_DETAIL
  NEARBY_SEARCH
  TEXT_SEARCH
  ACCOMMODATION_SEARCH
  ACCOMMODATION_DETAIL
  LIVE_PRICE
  AVAILABILITY
  RESTAURANT_SEARCH
  RESTAURANT_DETAIL
  ACTIVITY_SEARCH
  ACTIVITY_DETAIL
  FLIGHT_SEARCH
  CAR_RENTAL_SEARCH
  REVIEWS
  PHOTOS
  BOOKING_REDIRECT
  BOOKING_API
  AFFILIATE_LINK
  WEBHOOK
  CONVERSION_REPORTING
}

enum ProviderIntegrationStatus {
  NOT_CONFIGURED
  PENDING_APPROVAL
  CONFIGURED
  ACTIVE
  SUSPENDED
  FAILED
  REVOKED
}

// The tri/four-state rights representation (spec section 11). CONDITIONAL
// carries its constraint in the sibling `*Notes`/`conditionalNotes` field -
// never collapsed into a bare boolean.
enum ProviderRightState {
  UNKNOWN
  ALLOWED
  PROHIBITED
  CONDITIONAL
}

enum ProviderLicenseStatus {
  DRAFT
  TERMS_REVIEW
  LEGAL_REVIEW
  APPROVED
  EXPIRED
  REVOKED
  REJECTED
}

enum ProviderAttributionRequirement {
  UNKNOWN
  REQUIRED
  NOT_REQUIRED
  CONDITIONAL
}

enum ProviderPolicyEvidenceSourceType {
  OFFICIAL_TERMS
  OFFICIAL_DEVELOPER_DOC
  OFFICIAL_PARTNER_DOC
  OFFICIAL_PRICING_DOC
  CONTRACT
  LEGAL_REVIEW
  OTHER
}

model ExternalProvider {
  id                    String                 @id @default(cuid())
  // Stable, machine-readable, unique (spec section 6) - e.g. GOOGLE_PLACES.
  // No provider-specific business logic is ever hardcoded against this
  // string outside of test fixtures; real adapters register by code.
  code                  String                 @unique
  name                  String
  status                ProviderStatus         @default(DRAFT)
  websiteUrl            String?
  developerUrl          String?
  partnerPortalUrl      String?
  credentialMode        ProviderCredentialMode @default(NONE)
  // Which environments this provider generally offers (e.g. some providers
  // have no sandbox) - a plain scalar list, same convention as
  // `User.roles: Role[]`.
  supportedEnvironments ProviderEnvironment[]  @default([])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  capabilities     ProviderCapability[]
  integrations     ProviderIntegration[]
  licenses         ProviderLicense[]
  dataPolicies     ProviderDataPolicy[]
  attributionRules ProviderAttributionRule[]

  @@index([status])
}

// What the provider TECHNICALLY supports (spec section 7) - independent of
// whether OUR account is approved/enabled for it (see
// ProviderIntegrationCapability below).
model ProviderCapability {
  id         String                 @id @default(cuid())
  providerId String
  capability ProviderCapabilityType
  notes      String?
  createdAt  DateTime               @default(now())

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capability])
  @@index([providerId])
}

// Our own account/environment-specific integration state (spec section 8) -
// distinct from the provider's mere existence. `credentialReference` is an
// env-var/secret-manager KEY NAME only, never a secret value (spec
// section 9).
model ProviderIntegration {
  id                  String                    @id @default(cuid())
  providerId          String
  environment         ProviderEnvironment
  status              ProviderIntegrationStatus @default(NOT_CONFIGURED)
  credentialReference String?
  configuredAt        DateTime?
  lastVerifiedAt      DateTime?
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  enabledCapabilities ProviderIntegrationCapability[]

  @@unique([providerId, environment])
  @@index([providerId])
  @@index([status])
}

// Capability ENABLED_FOR_OUR_ACCOUNT (spec section 7's "a provider may
// technically support BOOKING_API, but our account may only be approved
// for BOOKING_REDIRECT"). Existence of this row (written only through the
// gated activation path, never a bare upsert) is the enablement signal;
// the real serving gate still re-checks the underlying license live on
// every use (see design note above) - this row is a write-time record, not
// a cached "safe to serve" flag.
model ProviderIntegrationCapability {
  id            String                 @id @default(cuid())
  integrationId String
  capability    ProviderCapabilityType
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime               @default(now())

  integration ProviderIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, capability])
  @@index([integrationId])
}

// The legal/contractual rights grant (spec sections 10-13). Scoped to a
// specific product/dataset and, where meaningful, a specific capability -
// spec section 13's "do NOT assume one provider = one license" (e.g.
// Google Places data vs Google Places photos can carry different rights).
model ProviderLicense {
  id               String                  @id @default(cuid())
  providerId       String
  // Human label for the licensed product/dataset (e.g. "Places API core
  // data", "Place Photos") - always required, independent of `capability`.
  datasetOrProduct String
  // Optional narrower scope when this license maps cleanly onto one
  // capability; null means it applies at the datasetOrProduct level only.
  capability       ProviderCapabilityType?
  licenseType      String?
  status           ProviderLicenseStatus   @default(DRAFT)

  rightsDisplay       ProviderRightState @default(UNKNOWN)
  rightsCache         ProviderRightState @default(UNKNOWN)
  rightsStore         ProviderRightState @default(UNKNOWN)
  rightsModify        ProviderRightState @default(UNKNOWN)
  rightsRedistribute  ProviderRightState @default(UNKNOWN)
  rightsCommercialUse ProviderRightState @default(UNKNOWN)
  // Required whenever any right above is CONDITIONAL (service-enforced,
  // not a DB constraint - see ProviderLicensesService).
  conditionalNotes    String?

  attributionRequirement ProviderAttributionRequirement @default(UNKNOWN)

  termsUrl          String
  privacyUrl        String?
  developerTermsUrl String?

  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  reviewedAt   DateTime?
  reviewedById String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider         ExternalProvider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dataPolicies     ProviderDataPolicy[]
  attributionRules ProviderAttributionRule[]
  evidence         ProviderPolicyEvidence[]

  @@index([providerId])
  @@index([status])
  @@index([providerId, capability])
}

// Operational retention/cache configuration (spec section 16) - always
// traces back to the License that authorizes it. Deliberately separate
// from ProviderLicense - see the domain design note above.
model ProviderDataPolicy {
  id         String                 @id @default(cuid())
  providerId String
  licenseId  String
  capability ProviderCapabilityType

  cacheAllowed                ProviderRightState @default(UNKNOWN)
  maxCacheSeconds             Int?
  storeIdentityAllowed        ProviderRightState @default(UNKNOWN)
  storeContentAllowed         ProviderRightState @default(UNKNOWN)
  refreshRequiredAfterSeconds Int?
  deleteAfterSeconds          Int?
  persistentIdentifierAllowed ProviderRightState @default(UNKNOWN)

  policySourceUrl String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  license  ProviderLicense  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, capability])
  @@index([providerId])
}

// First-class attribution requirement (spec section 14) - never left to
// frontend conditionals. `licenseId` optional (a provider-wide default
// attribution rule not tied to one license is representable).
model ProviderAttributionRule {
  id             String                         @id @default(cuid())
  providerId     String
  licenseId      String?
  capability     ProviderCapabilityType?
  requirement    ProviderAttributionRequirement @default(UNKNOWN)
  displayText    String?
  logoRequired   Boolean                        @default(false)
  linkUrl        String?
  placementNotes String?
  expiresAt      DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  license  ProviderLicense? @relation(fields: [licenseId], references: [id])

  @@index([providerId])
}

// Provenance for a License's rights determination (spec section 18) - only
// metadata/URL/short internal summary, never full copyrighted terms text.
model ProviderPolicyEvidence {
  id          String                           @id @default(cuid())
  licenseId   String
  title       String
  sourceUrl   String
  accessedAt  DateTime
  sourceType  ProviderPolicyEvidenceSourceType
  notes       String?
  createdById String?
  createdAt   DateTime                         @default(now())

  license ProviderLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
}

// =========================================================================
// HISTORICAL KNOWLEDGE GRAPH  (Phase 03)
// =========================================================================

model Place {
  id                   String                                   @id @default(cuid())
  canonicalSlug        String                                   @unique
  type                 PlaceType
  parentPlaceId        String?
  location             Unsupported("geometry(Point, 4326)")?
  geometry             Unsupported("geometry(Geometry, 4326)")?
  currentAdminRegion   String?
  historicalImportance Int                                      @default(0)
  heroMediaId          String?
  unescoStatus         String?
  unescoInscribedYear  Int?
  publicationStatus    PublicationStatus                        @default(DRAFT)
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt

  parentPlace Place?      @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id])
  childPlaces Place[]     @relation("PlaceHierarchy")
  heroMedia   MediaAsset? @relation("PlaceHeroMedia", fields: [heroMediaId], references: [id])

  translations       PlaceTranslation[]
  visits             PlaceVisit[]
  factLinks          FactPlace[]
  eventLinks         EventPlace[]
  storyLinks         StoryPlace[]
  journeyStops       JourneyStop[]
  communityLinks     CommunityStoryPlace[]
  contributions      Contribution[]
  thenNowComparisons ThenNowComparison[]

  @@index([type])
  @@index([parentPlaceId])
}

model PlaceTranslation {
  id             String            @id @default(cuid())
  placeId        String
  locale         String
  name           String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, locale])
  @@unique([locale, slug])
}

model Person {
  id            String @id @default(cuid())
  canonicalSlug String @unique

  // Historical date model (docs/backend/HISTORICAL_DOMAIN.md) - year/month/day
  // hold only what is actually known; birth*SortStart/End are internal
  // ordering aids only, never returned as "the" date over the API.
  birthYear      Int?
  birthMonth     Int?
  birthDay       Int?
  birthPrecision DatePrecision @default(UNKNOWN)
  birthQualifier DateQualifier @default(UNCERTAIN)
  birthEndYear   Int?
  birthEndMonth  Int?
  birthEndDay    Int?
  birthLabel     String?
  birthSortStart DateTime?
  birthSortEnd   DateTime?

  deathYear      Int?
  deathMonth     Int?
  deathDay       Int?
  deathPrecision DatePrecision @default(UNKNOWN)
  deathQualifier DateQualifier @default(UNCERTAIN)
  deathEndYear   Int?
  deathEndMonth  Int?
  deathEndDay    Int?
  deathLabel     String?
  deathSortStart DateTime?
  deathSortEnd   DateTime?

  heroMediaId          String?
  historicalImportance Int               @default(0)
  publicationStatus    PublicationStatus @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  heroMedia MediaAsset? @relation("PersonHeroMedia", fields: [heroMediaId], references: [id])

  translations   PersonTranslation[]
  dynastyLinks   PersonDynasty[]
  factLinks      FactPerson[]
  eventLinks     EventPerson[]
  storyLinks     StoryPerson[]
  communityLinks CommunityStoryPerson[]
}

model PersonTranslation {
  id             String            @id @default(cuid())
  personId       String
  locale         String
  displayName    String
  slug           String
  alternateNames String?
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, locale])
  @@unique([locale, slug])
}

model HistoricalEvent {
  id                String            @id @default(cuid())
  canonicalSlug     String            @unique
  eraId             String?
  territoryId       String?
  dateYear          Int?
  dateMonth         Int?
  dateDay           Int?
  datePrecision     DatePrecision     @default(UNKNOWN)
  dateQualifier     DateQualifier     @default(UNCERTAIN)
  dateEndYear       Int?
  dateEndMonth      Int?
  dateEndDay        Int?
  dateLabel         String?
  dateSortStart     DateTime?
  dateSortEnd       DateTime?
  importance        Int               @default(0)
  heroMediaId       String?
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  era       HistoricalEra? @relation(fields: [eraId], references: [id])
  territory Territory?     @relation(fields: [territoryId], references: [id])
  heroMedia MediaAsset?    @relation("EventHeroMedia", fields: [heroMediaId], references: [id])

  translations   HistoricalEventTranslation[]
  placeLinks     EventPlace[]
  personLinks    EventPerson[]
  factLinks      FactEvent[]
  storyLinks     StoryEvent[]
  communityLinks CommunityStoryEvent[]
  themeLinks     EventTheme[]
  journeyStops   JourneyStop[]                @relation("JourneyStopEvent")

  @@index([eraId])
  @@index([territoryId])
  @@index([dateSortStart])
}

model HistoricalEventTranslation {
  id             String            @id @default(cuid())
  eventId        String
  locale         String
  title          String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@unique([locale, slug])
}

model HistoricalEra {
  id            String  @id @default(cuid())
  canonicalSlug String  @unique
  parentEraId   String?

  // Period date model: start/end are each independently qualified (an era
  // can start "circa" and end on an exact year). No end recorded (both
  // endYear and endPrecision null) means "still ongoing", distinct from an
  // explicitly UNKNOWN end. sortStart/sortEnd are internal ordering aids.
  startYear      Int?
  startMonth     Int?
  startDay       Int?
  startPrecision DatePrecision  @default(UNKNOWN)
  startQualifier DateQualifier  @default(UNCERTAIN)
  endYear        Int?
  endMonth       Int?
  endDay         Int?
  endPrecision   DatePrecision?
  endQualifier   DateQualifier?
  dateLabel      String?
  sortStart      DateTime?
  sortEnd        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentEra HistoricalEra?  @relation("EraHierarchy", fields: [parentEraId], references: [id])
  childEras HistoricalEra[] @relation("EraHierarchy")

  translations   HistoricalEraTranslation[]
  events         HistoricalEvent[]
  factLinks      FactEra[]
  communityLinks CommunityStoryEra[]

  @@index([sortStart])
}

model HistoricalEraTranslation {
  id          String            @id @default(cuid())
  eraId       String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  era HistoricalEra @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([eraId, locale])
  @@unique([locale, slug])
}

model Dynasty {
  id             String  @id @default(cuid())
  canonicalSlug  String  @unique
  capitalPlaceId String?

  // Period date model - see HistoricalEra for the field-by-field contract.
  startYear      Int?
  startMonth     Int?
  startDay       Int?
  startPrecision DatePrecision  @default(UNKNOWN)
  startQualifier DateQualifier  @default(UNCERTAIN)
  endYear        Int?
  endMonth       Int?
  endDay         Int?
  endPrecision   DatePrecision?
  endQualifier   DateQualifier?
  dateLabel      String?
  sortStart      DateTime?
  sortEnd        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations DynastyTranslation[]
  personLinks  PersonDynasty[]

  @@index([sortStart])
}

model DynastyTranslation {
  id          String            @id @default(cuid())
  dynastyId   String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  dynasty Dynasty @relation(fields: [dynastyId], references: [id], onDelete: Cascade)

  @@unique([dynastyId, locale])
  @@unique([locale, slug])
}

model Territory {
  id            String                                   @id @default(cuid())
  canonicalSlug String                                   @unique
  type          TerritoryType
  geometry      Unsupported("geometry(Geometry, 4326)")?

  // Period date model (historical validity window) - see HistoricalEra for
  // the field-by-field contract. sortStart/sortEnd are what MapService's
  // year-scoped bbox query actually filters on (EPSG:4326, see
  // docs/backend/HISTORICAL_DOMAIN.md).
  startYear      Int?
  startMonth     Int?
  startDay       Int?
  startPrecision DatePrecision  @default(UNKNOWN)
  startQualifier DateQualifier  @default(UNCERTAIN)
  endYear        Int?
  endMonth       Int?
  endDay         Int?
  endPrecision   DatePrecision?
  endQualifier   DateQualifier?
  dateLabel      String?
  sortStart      DateTime?
  sortEnd        DateTime?

  // Geometry provenance (section 17): interpretive historical polygons must
  // never be silently overwritten - provenanceNote + geometryVersion give a
  // minimal audit trail; TerritoryGeometryRevision (below) keeps prior
  // versions instead of discarding them.
  provenanceNote       String?
  geometryVersion      Int               @default(1)
  geometryReviewedById String?
  geometryReviewedAt   DateTime?
  geometryStatus       PublicationStatus @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  translations    TerritoryTranslation[]
  events          HistoricalEvent[]
  factLinks       FactTerritory[]
  geometryHistory TerritoryGeometryRevision[]

  @@index([sortStart])
}

// Historical boundary polygons are interpretive and revisable - a new
// version is appended here (never overwritten in place) before the live
// `geometry` column is updated, so disputed/superseded shapes stay
// reconstructable (spec section 17).
model TerritoryGeometryRevision {
  id          String                                   @id @default(cuid())
  territoryId String
  version     Int
  geometry    Unsupported("geometry(Geometry, 4326)")?
  sourceNote  String?
  createdById String?
  createdAt   DateTime                                 @default(now())

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([territoryId, version])
}

model TerritoryTranslation {
  id          String            @id @default(cuid())
  territoryId String
  locale      String
  name        String
  slug        String
  summary     String?
  description String?
  status      TranslationStatus @default(DRAFT)
  method      TranslationMethod @default(ORIGINAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([territoryId, locale])
  @@unique([locale, slug])
}

// --- high-integrity join tables: knowledge graph ---

model EventPlace {
  id      String  @id @default(cuid())
  eventId String
  placeId String
  role    String?

  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([eventId, placeId])
}

model EventPerson {
  id       String  @id @default(cuid())
  eventId  String
  personId String
  role     String?

  event  HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person          @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
}

model PersonDynasty {
  id        String  @id @default(cuid())
  personId  String
  dynastyId String
  role      String?

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  dynasty Dynasty @relation(fields: [dynastyId], references: [id], onDelete: Cascade)

  @@unique([personId, dynastyId])
}

// Event classification catalog (spec section 11) - see the ThemeCategory
// comment above. `slug` is stable/locale-agnostic (used for filter query
// params); display name is localized via ThemeTranslation.
model Theme {
  id        String        @id @default(cuid())
  slug      String        @unique
  category  ThemeCategory
  createdAt DateTime      @default(now())

  translations ThemeTranslation[]
  eventLinks   EventTheme[]

  @@index([category])
}

model ThemeTranslation {
  id      String @id @default(cuid())
  themeId String
  locale  String
  name    String

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, locale])
}

model EventTheme {
  id      String @id @default(cuid())
  eventId String
  themeId String

  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  theme Theme           @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([eventId, themeId])
}

// =========================================================================
// TRUST LAYER  (Phase 04)
// =========================================================================

model HistoricalFact {
  id              String              @id @default(cuid())
  factType        FactType
  dateYear        Int?
  dateMonth       Int?
  dateDay         Int?
  datePrecision   DatePrecision       @default(UNKNOWN)
  dateQualifier   DateQualifier       @default(UNCERTAIN)
  dateEndYear     Int?
  dateEndMonth    Int?
  dateEndDay      Int?
  dateLabel       String?
  dateSortStart   DateTime?
  dateSortEnd     DateTime?
  certainty       FactCertainty       @default(UNCERTAIN)
  sensitivity     FactSensitivity     @default(NORMAL)
  editorialStatus FactEditorialStatus @default(DRAFT)
  createdById     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  translations   HistoricalFactTranslation[]
  citations      Citation[]
  placeLinks     FactPlace[]
  personLinks    FactPerson[]
  eventLinks     FactEvent[]
  eraLinks       FactEra[]
  territoryLinks FactTerritory[]
  revisions      Revision[]
  reviews        FactReview[]
  storyLinks     StoryFact[]

  @@index([editorialStatus])
  @@index([sensitivity])
}

// Per-stage review history (spec section 21) - deliberately not just a
// `reviewedById`/`reviewedAt` pair on HistoricalFact, which would lose every
// review but the most recent one. One row per review decision, append-only
// from the API's point of view (no update/delete endpoint).
model FactReview {
  id         String              @id @default(cuid())
  factId     String
  reviewerId String
  // The editorial stage this decision applies to (e.g. a FACT_REVIEW row
  // records a historian's fact-check; a PUBLISHED row records the final
  // publish approval; a RETRACTED row records a retraction and its reason).
  stage      FactEditorialStatus
  decision   ReviewDecision
  notes      String?
  createdAt  DateTime            @default(now())

  fact     HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  reviewer User           @relation(fields: [reviewerId], references: [id])

  @@index([factId])
  @@index([reviewerId])
}

model HistoricalFactTranslation {
  id        String            @id @default(cuid())
  factId    String
  locale    String
  statement String
  status    TranslationStatus @default(DRAFT)
  method    TranslationMethod @default(ORIGINAL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  fact HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([factId, locale])
}

model FactPlace {
  id      String @id @default(cuid())
  factId  String
  placeId String

  fact  HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  place Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([factId, placeId])
}

model FactPerson {
  id       String @id @default(cuid())
  factId   String
  personId String

  fact   HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  person Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([factId, personId])
}

model FactEvent {
  id      String @id @default(cuid())
  factId  String
  eventId String

  fact  HistoricalFact  @relation(fields: [factId], references: [id], onDelete: Cascade)
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([factId, eventId])
}

model FactEra {
  id     String @id @default(cuid())
  factId String
  eraId  String

  fact HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  era  HistoricalEra  @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([factId, eraId])
}

model FactTerritory {
  id          String @id @default(cuid())
  factId      String
  territoryId String

  fact      HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  territory Territory      @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([factId, territoryId])
}

model Source {
  id               String            @id @default(cuid())
  sourceType       SourceType
  title            String
  author           String?
  organization     String?
  publisher        String?
  publicationYear  Int?
  isbn             String?
  issn             String?
  edition          String?
  volume           String?
  archiveName      String?
  archiveCode      String?
  originalLanguage String?
  url              String?
  accessedAt       DateTime?
  credibilityLevel SourceCredibility @default(UNKNOWN)
  notes            String?
  createdById      String?
  // Archive/deactivate, never hard-delete a Source once it can be cited
  // (spec section 35). A non-null archivedAt means the source is no longer
  // offered for new citations; existing Citations/history are untouched.
  archivedAt       DateTime?
  archivedById     String?
  archiveReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  translations                 SourceTranslation[]
  citations                    Citation[]
  sourceDocuments              SourceDocument[]
  mediaAssets                  MediaAsset[]
  contributionCatalogueResults ContributionCatalogueResult[]

  @@index([sourceType])
  @@index([archivedAt])
}

// optional localized display title only - original bibliographic identity is
// never overwritten (see spec section 21).
model SourceTranslation {
  id           String   @id @default(cuid())
  sourceId     String
  locale       String
  displayTitle String
  createdAt    DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, locale])
}

model Citation {
  id                String                    @id @default(cuid())
  factId            String
  sourceId          String
  pageFrom          String?
  pageTo            String?
  volume            String?
  chapter           String?
  excerpt           String?
  editorNote        String?
  verificationState CitationVerificationState @default(UNVERIFIED)
  verifiedById      String?
  verifiedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  fact   HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  source Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  storyLinks StoryCitation[]

  @@index([factId])
  @@index([sourceId])
}

model SourceDocument {
  id              String            @id @default(cuid())
  sourceId        String
  mediaAssetId    String
  pageCount       Int?
  // OCR output (spec section 23) - extraction assistance only. Never treated
  // as reviewed historical text; a Citation quoting this document still goes
  // through the normal fact/citation trust path regardless of ocrStatus.
  extractedText   String?
  ocrStatus       DocumentOcrStatus @default(NOT_REQUESTED)
  ocrConfidence   Float?
  ocrReviewedById String?
  ocrReviewedAt   DateTime?
  usageRights     String?
  rightsHolder    String?
  accessPolicy    AccessPolicy      @default(METADATA_ONLY)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  source                       Source                        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mediaAsset                   MediaAsset                    @relation(fields: [mediaAssetId], references: [id])
  contributionCatalogueResults ContributionCatalogueResult[]

  @@index([sourceId])
}

// generic revision snapshot store for high-value editorial entities (section 37)
model Revision {
  id          String     @id @default(cuid())
  entityType  EntityKind
  entityId    String
  snapshot    Json
  changeNote  String?
  changedById String?
  factId      String?
  storyId     String?
  journeyId   String?
  createdAt   DateTime   @default(now())

  changedBy User?           @relation(fields: [changedById], references: [id])
  fact      HistoricalFact? @relation(fields: [factId], references: [id])
  story     Story?          @relation(fields: [storyId], references: [id])
  journey   Journey?        @relation(fields: [journeyId], references: [id])

  @@index([entityType, entityId])
}

// append-only, never editable through normal editorial APIs (section 38)
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     String
  entityType EntityKind?
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([action])
}

// =========================================================================
// EDITORIAL CONTENT  (Phase 06)
// =========================================================================

model Story {
  id               String               @id @default(cuid())
  canonicalSlug    String               @unique
  type             StoryType            @default(EDITORIAL)
  heroMediaId      String?
  authorId         String?
  // Public-facing attribution, distinct from `authorId` (an internal User
  // pointer that is never publicly exposed - spec section 47/48). May be a
  // team byline ("Ban bien tap Dau Viet") rather than a named individual.
  byline           String?
  featured         Boolean              @default(false)
  priority         Int                  @default(0)
  editorialStatus  StoryEditorialStatus @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  lastReviewedById String?
  lastReviewedAt   DateTime?
  // Optimistic concurrency (spec section 60) - every update/transition must
  // supply the version it read; a stale write is rejected rather than
  // silently overwriting a concurrent editor's change.
  version          Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  heroMedia MediaAsset? @relation("StoryHeroMedia", fields: [heroMediaId], references: [id])

  translations  StoryTranslation[]
  placeLinks    StoryPlace[]
  personLinks   StoryPerson[]
  eventLinks    StoryEvent[]
  factLinks     StoryFact[]
  citationLinks StoryCitation[]
  revisions     Revision[]
  journeyStops  JourneyStop[]      @relation("JourneyStopStory")

  @@index([editorialStatus])
  @@index([featured, priority])
}

model StoryTranslation {
  id             String            @id @default(cuid())
  storyId        String
  locale         String
  title          String
  slug           String
  // Optional subtitle/deck line (spec section 4) - distinct from `summary`
  // (a longer plain-text teaser used in list views/SEO fallback).
  subtitle       String?
  summary        String?
  // Structured block-array body (spec section 6/7), stored as Json rather
  // than raw HTML - see StoryBody in story-body.util.ts for the validated
  // block schema. Never rendered as trusted HTML server-side.
  content        Json?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, locale])
  @@unique([locale, slug])
}

model StoryPlace {
  id      String        @id @default(cuid())
  storyId String
  placeId String
  role    StoryLinkRole @default(RELATED)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([storyId, placeId])
}

model StoryPerson {
  id       String        @id @default(cuid())
  storyId  String
  personId String
  role     StoryLinkRole @default(RELATED)

  story  Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([storyId, personId])
}

model StoryEvent {
  id      String        @id @default(cuid())
  storyId String
  eventId String
  role    StoryLinkRole @default(RELATED)

  story Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([storyId, eventId])
}

// Explicit editorial-provenance layer (spec section 10) - which verified
// HistoricalFact rows this Story's narrative is built on. Never duplicates
// the fact's statement text; just the relation. A Story is not required to
// back every sentence with a Fact, but any fact it does cite as support
// must be PUBLISHED to satisfy the publication validator (see
// StoriesService.validateForPublication) - a DRAFT/unverified Fact can
// never be laundered into "supported by verified history" via a Story.
model StoryFact {
  id      String @id @default(cuid())
  storyId String
  factId  String

  story Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fact  HistoricalFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([storyId, factId])
}

model StoryCitation {
  id         String  @id @default(cuid())
  storyId    String
  citationId String
  // Locator/context for this editorial citation (spec section 11/12) -
  // distinct from HistoricalFact<->Citation, which remains the only path
  // for citing factual support. This is for broader interpretation/
  // quotation context a Story adds on top of verified facts.
  locator    String?
  quoteNote  String?

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([storyId, citationId])
}

model Journey {
  id                  String                                     @id @default(cuid())
  canonicalSlug       String                                     @unique
  heroMediaId         String?
  durationMinutes     Int?
  distanceMeters      Int?
  difficulty          String?
  region              String?
  routeGeometry       Unsupported("geometry(LineString, 4326)")?
  // Provenance of routeGeometry when present (spec section 30) - never
  // presented as a real road route unless it actually is one.
  routeGeometrySource String?
  editorialStatus     PublicationStatus                          @default(DRAFT)
  scheduledAt         DateTime?
  publishedAt         DateTime?
  archivedAt          DateTime?
  version             Int                                        @default(0)
  createdAt           DateTime                                   @default(now())
  updatedAt           DateTime                                   @updatedAt

  heroMedia MediaAsset? @relation("JourneyHeroMedia", fields: [heroMediaId], references: [id])

  translations JourneyTranslation[]
  stops        JourneyStop[]
  revisions    Revision[]

  @@index([editorialStatus])
}

model JourneyTranslation {
  id             String            @id @default(cuid())
  journeyId      String
  locale         String
  title          String
  slug           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         TranslationStatus @default(DRAFT)
  method         TranslationMethod @default(ORIGINAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, locale])
  @@unique([locale, slug])
}

model JourneyStop {
  id                         String  @id @default(cuid())
  journeyId                  String
  placeId                    String
  order                      Int
  // Optional override of the Place's own display name for this stop's
  // context (spec section 26) - e.g. referring to one wing/gate of a larger
  // site. Free-text, uploader/editor locale only (spec section 28 - no
  // JourneyStopTranslation was added; see docs/backend/EDITORIAL_CONTENT.md
  // for the reasoning).
  stopTitle                  String?
  recommendedDurationMinutes Int?
  notes                      String?
  // Optional links to why this stop matters historically (spec section 31) -
  // never a place to restate a factual claim; the claim itself still lives
  // on a HistoricalFact/Story, this is just a pointer.
  storyId                    String?
  eventId                    String?

  journey Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  place   Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  story   Story?           @relation("JourneyStopStory", fields: [storyId], references: [id])
  event   HistoricalEvent? @relation("JourneyStopEvent", fields: [eventId], references: [id])

  @@unique([journeyId, placeId])
  @@unique([journeyId, order])
}

// Lightweight home/editorial curation (spec section 35-37) - deliberately
// not a general CMS layout builder. One row = one piece of content in one
// named slot at one position; the public `GET /v1/editorial/home` endpoint
// groups by slotKey and resolves each entity through its own normal
// publication-status filtering, so a stale slot pointing at an since-
// unpublished entity never leaks a draft.
model EditorialSlot {
  id          String     @id @default(cuid())
  slotKey     String
  order       Int        @default(0)
  entityKind  EntityKind
  entityId    String
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([slotKey, order])
  @@index([slotKey])
}

// =========================================================================
// COMMUNITY  (Phase 08)
// =========================================================================

model CommunityStory {
  id                  String                     @id @default(cuid())
  canonicalSlug       String                     @unique
  type                CommunityStoryType
  authorId            String
  heroMediaId         String?
  // The locale the author actually wrote in (spec Phase 08 section 5) - never
  // silently overwritten by a later translation. Defaults to the locale of
  // the first translation supplied at creation.
  originalLocale      String                     @default("vi")
  verificationState   CommunityVerificationState @default(PERSONAL_MEMORY)
  moderationStatus    ModerationStatus           @default(VISIBLE)
  // Simplified point date (no qualifier/BETWEEN-range needed for a personal
  // memory) - still never fabricates a month/day for a year-only memory.
  eventDateYear       Int?
  eventDateMonth      Int?
  eventDateDay        Int?
  eventDatePrecision  DatePrecision              @default(UNKNOWN)
  eventDateLabel      String?
  // Denormalized "helpful" tally (spec section 63/64) - the `StoryVote`
  // unique constraint is the source of truth; this column exists only so the
  // HELPFUL feed sort and profile "helpful received" total don't require a
  // full-table aggregate on every read. Updated transactionally alongside
  // every StoryVote create/delete, never trusted from client input.
  helpfulCount        Int                        @default(0)
  // Set only when type = THEN_AND_NOW (spec section 18) - links to the
  // existing Phase 05 ThenNowComparison rather than duplicating the
  // before/after media model.
  thenNowComparisonId String?                    @unique
  editedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  author            User               @relation(fields: [authorId], references: [id])
  heroMedia         MediaAsset?        @relation("CommunityStoryHeroMedia", fields: [heroMediaId], references: [id])
  thenNowComparison ThenNowComparison? @relation(fields: [thenNowComparisonId], references: [id])

  translations CommunityStoryTranslation[]
  placeLinks   CommunityStoryPlace[]
  personLinks  CommunityStoryPerson[]
  eventLinks   CommunityStoryEvent[]
  eraLinks     CommunityStoryEra[]
  votes        StoryVote[]

  @@index([authorId])
  @@index([moderationStatus])
}

// Single positive "helpful" signal (spec section 22) - deliberately not a
// +1/-1 palette like CommentVote; existence of a row IS the helpful vote, so
// "un-helpful-ing" is a delete, not a value flip.
model StoryVote {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model CommunityStoryTranslation {
  id        String            @id @default(cuid())
  storyId   String
  locale    String
  title     String
  slug      String
  content   String?
  status    TranslationStatus @default(DRAFT)
  method    TranslationMethod @default(ORIGINAL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, locale])
  @@unique([locale, slug])
}

model CommunityStoryPlace {
  id      String @id @default(cuid())
  storyId String
  placeId String

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  place Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([storyId, placeId])
}

model CommunityStoryPerson {
  id       String @id @default(cuid())
  storyId  String
  personId String

  story  CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([storyId, personId])
}

model CommunityStoryEvent {
  id      String @id @default(cuid())
  storyId String
  eventId String

  story CommunityStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  event HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([storyId, eventId])
}

model CommunityStoryEra {
  id      String @id @default(cuid())
  storyId String
  eraId   String

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  era   HistoricalEra  @relation(fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([storyId, eraId])
}

// "Xua & Nay" (Then & Now) - a before/after image pair anchored to a Place
// (spec section 27). Can originate from an editor OR a community member;
// `publicationStatus` is the editorial-promotion gate (same DRAFT/PUBLISHED
// meaning as every other entity - see HISTORICAL_DOMAIN.md section 7) and
// `moderationStatus` is the same community-visibility gate CommunityStory
// uses, so a community-submitted pair can be hidden without deleting it.
// A community pair being VISIBLE/moderated is not the same as it being
// editorially PUBLISHED - identical distinction to CommunityStory vs Story.
model ThenNowComparison {
  id                String            @id @default(cuid())
  placeId           String
  beforeMediaId     String
  afterMediaId      String
  historicalPeriod  String?
  viewpointNote     String?
  publicationStatus PublicationStatus @default(DRAFT)
  moderationStatus  ModerationStatus  @default(VISIBLE)
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  place       Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  beforeMedia MediaAsset @relation("ThenNowBefore", fields: [beforeMediaId], references: [id])
  afterMedia  MediaAsset @relation("ThenNowAfter", fields: [afterMediaId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])

  translations   ThenNowComparisonTranslation[]
  communityStory CommunityStory?

  @@index([placeId])
}

model ThenNowComparisonTranslation {
  id           String            @id @default(cuid())
  comparisonId String
  locale       String
  description  String?
  status       TranslationStatus @default(DRAFT)
  method       TranslationMethod @default(ORIGINAL)
  createdAt    DateTime          @default(now())

  comparison ThenNowComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, locale])
}

model Comment {
  id         String           @id @default(cuid())
  targetType EntityKind
  targetId   String
  authorId   String
  parentId   String?
  body       String
  status     ModerationStatus @default(VISIBLE)
  score      Int              @default(0)
  // 0 for a top-level comment, parent.depth+1 for a reply (spec Phase 08
  // section 31) - a stored counter rather than walking `parentId` ancestry on
  // every write, so `CommentsService.create` can reject a reply past
  // MAX_DEPTH with one read instead of a recursive query.
  depth      Int              @default(0)
  editedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  author  User          @relation(fields: [authorId], references: [id])
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]     @relation("CommentReplies")
  votes   CommentVote[]

  @@index([targetType, targetId])
  @@index([parentId])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Bookmark {
  id         String     @id @default(cuid())
  userId     String
  targetType EntityKind
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

model Report {
  id             String         @id @default(cuid())
  reporterId     String
  targetType     EntityKind
  targetId       String
  category       ReportCategory
  status         ReportStatus   @default(OPEN)
  notes          String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime       @default(now())

  reporter User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  resolver User? @relation("ReportsResolved", fields: [resolvedById], references: [id])

  @@index([targetType, targetId])
  @@index([status])
}

model PlaceVisit {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  visitedAt DateTime @default(now())
  note      String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placeId])
}

// Tasteful, rule/editorial-based recognition (spec Phase 08 section 28) -
// deliberately not an XP/level/streak system. Grantable only via an
// ADMIN-gated endpoint (`UsersService.grantBadge`); no code path lets a user
// award their own badge.
enum BadgeType {
  MEMORY_KEEPER // "Nguoi gin giu ky uc"
  EXPLORER // "Nguoi kham pha"
  ARCHIVIST // "Nguoi luu giu"
  STORYTELLER // "Nguoi ke chuyen"
  RESEARCHER // "Nguoi nghien cuu"
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  type        BadgeType
  grantedById String?
  reason      String?
  createdAt   DateTime  @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("BadgesGranted", fields: [grantedById], references: [id])

  @@unique([userId, type])
}

// =========================================================================
// CONTRIBUTIONS  (Phase 09)
// =========================================================================

model Contribution {
  id                   String                        @id @default(cuid())
  contributorId        String
  type                 ContributionType              @default(OTHER)
  status               ContributionStatus            @default(SUBMITTED)
  title                String
  description          String?
  originSource         String?
  currentOwner         String?
  sharingRights        String?
  approxDateLabel      String?
  approxDateStart      DateTime?
  approxDateEnd        DateTime?
  peopleShown          String[]                      @default([])
  placeId              String?
  contextNote          String?
  // Original submission language, preserved verbatim (spec section 7) - AI-
  // assisted translation is a separate, disclosed concern layered on later,
  // never applied silently here.
  originalLocale       String                        @default("vi")
  // Contextual-only entity tag beyond `placeId` (spec section 8) - e.g. a
  // Person/HistoricalEvent/HistoricalEra/Territory this material relates
  // to. Plain polymorphic scalar pair, same convention as Comment/Bookmark/
  // Report (`targetType`/`targetId`) rather than four separate nullable
  // FKs - linking never implies verification of the material itself.
  linkedEntityType     EntityKind?
  linkedEntityId       String?
  // CORRECTION contributions point at the canonical record they propose to
  // fix (spec section 20) - validated against a closed allow-list and
  // existence-checked in ContributionsService (never a trusted arbitrary
  // targetType/targetId).
  correctionTargetType EntityKind?
  correctionTargetId   String?
  // Submitter's own rights claim (spec section 13) - a claim, never an
  // adjudicated rights state. Kept structurally separate from
  // `rightsReviewState` below, which only a reviewer can set.
  submitterDeclaration SubmitterRightsDeclaration?
  attribution          ContributionAttribution?
  // Reviewer-only assessments (spec sections 11/12) - never derived from,
  // or overwritten by, any submitter-supplied field above.
  provenanceConfidence ProvenanceConfidence          @default(UNASSESSED)
  rightsReviewState    ContributionRightsReviewState @default(UNREVIEWED)
  // Workflow-control sensitivity, the same enum/semantics as
  // HistoricalFact.sensitivity (spec section 40) - never a special-cased
  // place/topic check.
  sensitivity          FactSensitivity               @default(NORMAL)
  // Set true by a REQUEST_INFO review decision, cleared the moment the
  // submitter edits the contribution again (spec sections 23/58) - avoids
  // fragile "check the latest review note" log-diffing to answer "is this
  // waiting on the submitter right now".
  needsInfo            Boolean                       @default(false)
  rejectionReason      String?
  rejectedById         String?
  rejectedAt           DateTime?
  withdrawnAt          DateTime?
  // Denormalized "latest reviewer touched this" pointer (spec section 6) -
  // ContributionReviewNote (below) remains the append-only source of truth
  // for full review history, same convention as HistoricalFact.reviewedById.
  lastReviewedById     String?
  lastReviewedAt       DateTime?
  // Optimistic-concurrency guard (spec section 53/54) - every review/
  // transition/catalogue action must pass the version it last read; the
  // update increments it, so two reviewers finalizing at once cannot both
  // silently win. True concurrent-write races remain UNVERIFIED_LIVE_DB.
  version              Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  contributor User   @relation(fields: [contributorId], references: [id])
  place       Place? @relation(fields: [placeId], references: [id])

  media              ContributionMedia[]
  reviewNotes        ContributionReviewNote[]
  provenanceEvidence ContributionSource[]
  catalogueResults   ContributionCatalogueResult[]

  @@index([status])
  @@index([contributorId])
  @@index([type])
}

model ContributionMedia {
  id             String @id @default(cuid())
  contributionId String
  mediaAssetId   String

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id])

  @@unique([contributionId, mediaAssetId])
}

model ContributionReviewNote {
  id             String                      @id @default(cuid())
  contributionId String
  reviewerId     String
  stage          ContributionStatus
  // Nullable for migration-safety on the pre-existing table (spec section
  // 26/27) - every review action written by the current service always
  // sets it; only historical rows from before this field existed can lack
  // one.
  decision       ContributionReviewDecision?
  note           String
  createdAt      DateTime                    @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id])

  @@index([contributionId])
}

// Structured provenance evidence a submitter points to (spec sections 9/10)
// - a book/archive/family-record/oral-testimony/etc. claim. Never becomes a
// canonical Source automatically (spec section 9/30); it exists purely to
// give a PROVENANCE_REVIEW reviewer something concrete to assess. Unknown
// fields stay null - nothing here is ever fabricated to fill a gap.
model ContributionSource {
  id                   String                 @id @default(cuid())
  contributionId       String
  referenceType        ContributionSourceType
  claimedCreator       String?
  claimedOwner         String?
  acquisitionMethod    String?
  approxDateLabel      String?
  sourceOrganization   String?
  archiveCatalogRef    String?
  publicationInfo      String?
  url                  String?
  notes                String?
  // Optional attached evidence (e.g. a photo of a family record's cover) -
  // still just a plain MediaAsset, still subject to the same ownership
  // rules as every other contribution media reference.
  evidenceMediaAssetId String?
  createdAt            DateTime               @default(now())

  contribution  Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  evidenceMedia MediaAsset?  @relation(fields: [evidenceMediaAssetId], references: [id])

  @@index([contributionId])
}

// What a CATALOGUED contribution actually produced (spec sections 28/29/52)
// - one row per canonical output. Deliberately a set of rows, not a single
// nullable `createdSourceId` column, since one contribution can plausibly
// produce a Source, a SourceDocument, and one or more MediaAsset promotions.
// Also the idempotency anchor (spec section 52): ContributionsService checks
// for an existing row of the relevant resultType before creating a second
// canonical record for the same contribution.
model ContributionCatalogueResult {
  id               String                          @id @default(cuid())
  contributionId   String
  resultType       ContributionCatalogueResultType
  sourceId         String?
  sourceDocumentId String?
  mediaAssetId     String?
  createdById      String
  createdAt        DateTime                        @default(now())

  contribution   Contribution    @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  source         Source?         @relation(fields: [sourceId], references: [id])
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id])

  @@index([contributionId])
  @@index([resultType])
}
