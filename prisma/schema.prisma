  USER
  CONTRIBUTOR
  EDITOR
  HISTORIAN_REVIEWER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum ClientPlatform {
  WEB
  IOS
  ANDROID
  OTHER
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// Phase 06 (spec section 17) - Story needs a richer workflow than the flat
// PublicationStatus every other entity uses: a SOURCE_CHECK stage (does the
// narrative's factual support actually exist and hold up?) and SCHEDULED
// (spec section 23), neither of which PublicationStatus models. Mirrors the
// shape of FactEditorialStatus (same phase/stage vocabulary) rather than
// inventing a third, incompatible workflow vocabulary.
enum StoryEditorialStatus {
  DRAFT
  SOURCE_CHECK
  EDITORIAL_REVIEW
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Phase 06 (spec section 5) - deliberately small and not Vietnam-specific
// (spec section 56 - Hoang Sa/Truong Sa content is just an ordinary Place-
// linked STORY/PLACE_STORY, never a special-cased type or enum value).
enum StoryType {
  FEATURE
  HISTORICAL_EXPLAINER
  PLACE_STORY
  PERSON_STORY
  EVENT_STORY
  ARCHIVE_STORY
  THEN_AND_NOW
  CULTURAL_STORY
  EDITORIAL
  OTHER
}

// Phase 06 (spec section 8/9) - distinguishes a Story's central subject from
// merely-related/mentioned entities, so a client never has to guess primary
// subject from insertion order.
enum StoryLinkRole {
  PRIMARY_SUBJECT
  RELATED
  MENTIONED
  LOCATION
  CONTEXT
}

enum FactEditorialStatus {
  DRAFT
  SOURCE_CHECK
  FACT_REVIEW
  EDITORIAL_REVIEW
  READY
  PUBLISHED
  // A previously PUBLISHED fact that has been pulled from public output
  // without destroying its history (spec section 37). Distinct from DRAFT:
  // a retracted fact was once trusted and now explicitly is not, which is
  // editorially different from "never finished review".
  RETRACTED
}

// Outcome of a single FactReview record (spec section 22). Distinct from
// FactEditorialStatus - a decision is what a reviewer concluded at one
// stage; the editorial status is where the fact currently sits.
enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum PlaceType {
  HISTORICAL_SITE
  ARCHAEOLOGICAL_SITE
  MONUMENT
  TEMPLE
  PAGODA
  PALACE
  CITADEL
  BATTLEFIELD
  MUSEUM
  PRISON
  TOMB
  PORT
  VILLAGE
  ISLAND
  ARCHIPELAGO
  RIVER
  MOUNTAIN
  URBAN_AREA
  OTHER
}

// Historical date model (docs/backend/HISTORICAL_DOMAIN.md). `precision`
// says how granular the known value is; `DateQualifier` (below) says how
// certain/bounded it is. The two are independent: a YEAR-precision date can
// be EXACT, CIRCA, BEFORE, AFTER, part of a BETWEEN range, UNCERTAIN, or a
// TRADITIONAL/legendary account. Never conflate "coarse" with "uncertain".
enum DatePrecision {
  DAY
  MONTH
  YEAR
  DECADE
  CENTURY
  UNKNOWN
}

enum DateQualifier {
  EXACT
  CIRCA
  BEFORE
  AFTER
  BETWEEN
  UNCERTAIN
  TRADITIONAL
}

// G03 (Global Backend V2 Extension, Global Historical Knowledge Extension).
// Additive companion to DatePrecision/DateQualifier - see
// docs/backend/HISTORICAL_DATE_V2.md for the full model. `year` on every
// date-bearing column remains a POSITIVE, 1-based, in-era display number
// (1 BCE and 1 CE are adjacent - there is no historical year zero); `era`
// says which side of the epoch it falls on. Defaults to CE everywhere so
// every existing Phase 00-12.1 date column keeps its exact prior meaning
// with zero reinterpretation (a plain additive column with a DEFAULT).
enum DateEra {
  BCE
  CE
}

// G03 - explicit occurrence-vs-scope semantics for EventCountry.role (a
// generic optional string here was ambiguous - a reviewer could not tell
// whether a linked country meant "this happened here" or "this is merely
// related"). RELATED is the conservative default so an existing/unspecified
// link never silently implies a stronger claim ("occurred in") than an
// editor actually asserted.
enum EventCountryRole {
  OCCURRED_IN
  AFFECTED
  ORIGIN
  DESTINATION
  RELATED
}

// G03 - minimal Person<->Place association (spec's "people associated with
// multiple geographic contexts" requirement). Deliberately NOT a
// nationality/citizenship field and does not feed any nationality
// inference - each row is one explicit, editor-asserted association in one
// role. A person can have several rows against several places (e.g. BIRTH
// in one place, RULE in another), and in principle more than one row for
// the same role (e.g. RESIDENCE in two different places over a lifetime).
enum PersonPlaceRole {
  BIRTH
  DEATH
  RESIDENCE
  ACTIVITY
  RULE
  EXILE
  OTHER
}

