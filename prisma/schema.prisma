enum FactSensitivity {
  NORMAL
  HIGH
  TERRITORIAL
  LEGAL
  CONTESTED
}

enum SourceType {
  BOOK
  PRIMARY_DOCUMENT
  ARCHIVAL_DOCUMENT
  MAP
  MANUSCRIPT
  ACADEMIC_PAPER
  MUSEUM_RECORD
  GOVERNMENT_DOCUMENT
  UNESCO_RECORD
  NEWSPAPER
  PHOTO_ARCHIVE
  ORAL_HISTORY
  WEBSITE
  OTHER
}

enum SourceCredibility {
  PRIMARY
