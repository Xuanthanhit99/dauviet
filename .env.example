# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=v1
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Database ---
DATABASE_URL="postgresql://dauviet:dauviet@localhost:5432/dauviet?schema=public"

# --- Redis / Queues ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_TTL="30d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"

# --- Object storage (S3-compatible, MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="dauviet"
S3_SECRET_ACCESS_KEY="dauviet123"
S3_BUCKET="dauviet-media"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL="http://localhost:9000/dauviet-media"

# --- Email (dev: Mailhog) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Dau Viet <no-reply@dauviet.vn>"

# --- Rate limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
