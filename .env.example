# Dau Viet API - environment variable template (Phase 11 spec section 71-73).
# Copy to `.env` and fill in real values for your environment. No real
# secrets belong in this file - every value below is a safe placeholder or a
# non-secret default. Full classification table (REQUIRED/OPTIONAL/SECRET/
# DEVELOPMENT_ONLY/PRODUCTION_ONLY): docs/backend/BACKEND_HANDOFF.md
# "Environment variables".

# --- App --- (all OPTIONAL, safe non-secret defaults if omitted)
NODE_ENV=development
PORT=3000
API_PREFIX=v1
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
# PUBLIC/NON-SECRET - comma-separated list of allowed browser origins for CORS.
# Empty reflects the request Origin (dev convenience) - MUST be set explicitly
# in production (docs/backend/BACKEND_HANDOFF.md "Known limitations").
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Database --- REQUIRED, SECRET (contains a password)
DATABASE_URL="postgresql://dauviet:dauviet@localhost:5432/dauviet?schema=public"

# --- Redis / Queues --- REQUIRED, SECRET-if-auth-enabled
REDIS_URL="redis://localhost:6379"

# --- Auth --- REQUIRED, SECRET (min 32 chars, validated at boot - see
# apps/api/src/config/env.validation.ts; the app refuses to start otherwise)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_TTL="30d"
# OPTIONAL - Google OAuth degrades gracefully (feature disabled) if unset.
# SECRET (client secret). UNVERIFIED_NATIVE_FLOW - see docs/backend/AUTH.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"

# --- Object storage (S3-compatible, MinIO locally) --- REQUIRED for media upload, SECRET (access keys)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="dauviet"
S3_SECRET_ACCESS_KEY="dauviet123"
S3_BUCKET="dauviet-media"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL="http://localhost:9000/dauviet-media"
# Signed URL TTLs in seconds (Phase 05, spec section 37) - keep short, never a hardcoded long-lived link. OPTIONAL, safe defaults shown.
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=3600
S3_RESTRICTED_DOWNLOAD_URL_TTL_SECONDS=300
# Minutes a PENDING_UPLOAD MediaAsset may sit unconfirmed before orphan cleanup may fail it (spec section 40). OPTIONAL.
MEDIA_PENDING_UPLOAD_EXPIRY_MINUTES=60

# --- Email (dev: Mailhog) --- OPTIONAL, safe dev defaults shown. Real SMTP credentials in production are SECRET.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Dau Viet <no-reply@dauviet.vn>"

# --- Rate limiting --- OPTIONAL, safe defaults shown.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# --- Knowledge & Place Data Ingestion (G06.5) --- OPTIONAL. Missing credentials
# below produce a cleanly-DISABLED adapter, never a startup failure - see
# docs/backend/G06_5_SOURCE_POLICY_RESEARCH.md for why each source needs what.
# Master switch - ingestion module no-ops entirely when false (the default).
KNOWLEDGE_INGESTION_ENABLED=false
# Required by the Wikimedia Foundation User-Agent policy whenever Wikidata or
# Wikimedia Commons is enabled - see https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy
WIKIMEDIA_USER_AGENT="DauVietKnowledgeIngestion/1.0"
WIKIMEDIA_CONTACT="engineering@dauviet.example"
# Free registered GeoNames account username (not a secret API key, but still
# never logged/committed). Adapter stays disabled if unset.
GEONAMES_USERNAME=
# Google Cloud Places API key. Adapter stays disabled if unset - never a fake
# credential in live QA (spec section 51).
GOOGLE_PLACES_API_KEY=
INGESTION_WORKER_CONCURRENCY=1
INGESTION_MAX_RETRIES=3
INGESTION_RAW_RETENTION_DAYS=90

# --- Tooling only (Phase 11 spec section 77/78) ---
# DEVELOPMENT_ONLY / NEVER set for a real server boot. Read only by
# PrismaService.onModuleInit; `main.ts` never sets it and no real deployment
# should either. Only used by `pnpm --filter @dauviet/api openapi:generate`
# and by the Jest contract-test suite (via test-env-setup.ts) so the OpenAPI
# document can be generated/verified without a reachable Postgres. Leave
# unset (or "false") for every normal run, including `pnpm api:dev`.
# SKIP_DB_CONNECT=true
