{
  "name": "dau-viet",
  "version": "0.1.0",
  "private": true,
  "description": "Dau Viet - Living Digital Atlas of Vietnam (backend monorepo)",
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "db:migrate:diff:safe": "tsx scripts/db/safe-migrate-diff.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "test:db-guard": "tsx --test scripts/db/shadow-database-guard.spec.ts",
    "api:dev": "pnpm --filter @dauviet/api start:dev",
    "api:build": "pnpm --filter @dauviet/api build",
    "api:test": "pnpm --filter @dauviet/api test",
    "api:test:e2e": "pnpm --filter @dauviet/api test:e2e",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "web:dev": "pnpm --filter @dauviet/web dev",
    "web:build": "pnpm --filter @dauviet/web build",
    "web:typecheck": "pnpm --filter @dauviet/web typecheck",
    "admin:dev": "pnpm --filter @dauviet/admin dev",
    "admin:build": "pnpm --filter @dauviet/admin build",
    "mobile:start": "pnpm --filter @dauviet/mobile start",
    "consumer:typecheck": "pnpm --filter @dauviet/web typecheck && pnpm --filter @dauviet/admin typecheck && pnpm --filter @dauviet/mobile typecheck"
  },
  "devDependencies": {
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "@types/node": "20.16.11"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "argon2": "0.41.1",
    "slugify": "1.6.6"
  },
  "engines": {
    "node": ">=20"
  }
}
