  "domain_rules": {
    "map": {
      "default_marker": "shape + entity icon + semantic color; never color alone",
      "selected_marker": "increase outline/scale + selected surface/border; not color-only",
      "visited_marker": "visited glyph/check + label/state metadata; gold/brown may supplement",
      "cluster": "numeric count required",
      "historical_time_filter": "active tab/label + shape/border, not hue alone"
    },
    "story_explorer": {
      "current_scene": "progress position + active indicator + text label",
      "completed_scene": "completion glyph plus subdued treatment",
      "evidence_available": "evidence/source icon plus label where space permits",
      "citation_warning": "warning icon + text; not amber alone"
    },
    "journey": {
      "planned": "calendar/plan cue + label",
      "visited": "check/stamp cue + text state",
      "saved": "bookmark cue + accessible name",
      "unavailable": "disabled styling + text/icon explanation"
    }
  },
  "accessibility": {
    "normal_text_min_contrast": "4.5:1",
    "large_text_and_ui_graphics_min": "3:1",
    "focus_indicator_rule": "visible non-color-independent outline/ring with >=3:1 adjacent contrast where applicable",
    "color_only_states": "prohibited",
    "reduced_transparency": "state must remain legible without transparency/blur"
  },
